#############################################
####  NEMS Run-Time Configuration File  #####
#############################################
# STOFS-3D-AK + WW3. 4-component adaptation of
# fix/stofs_3d_ak_ufs/ufs.configure (ATM OCN MED), using the working Alaska
# DATM+SCHISM+WW3 reference configuration as the source for the added WAV
# component. Diffed line-by-line against the base file: only ADDs are the
# WAV block, WAV in EARTH_component_list/MED_attributes, the WAV/MED/OCN
# petlist_bounds values below, and a commented-out
# write_restart_at_endofrun line in ALLCOMP_attributes (see the note next
# to it) -- restart_n/restart_option/orb_iyear/stop_n/start_type
# themselves are byte-identical to the base (see the note at the bottom).
#
# PET bounds: nos-utils' ufs_config.py._patch_pet_bounds is 4-component-aware
# (wav_tasks > 0 selects the DATM+SCHISM+WW3 layout: MED spans all
# total_tasks PETs, OCN and WAV each get their own range, matching the
# layout-A numbers seeded below) -- see the yaml's ufs_coastal block.

# ESMF #
logKindFlag:            ESMF_LOGKIND_MULTI
globalResourceControl:  true

# EARTH #
EARTH_component_list: ATM OCN WAV MED
EARTH_attributes::
  Verbosity = 0
::

# MED #
# Only ADD vs the base: WAV_model = ww3. MED_petlist_bounds below spans every
# rank (reference-run convention -- MED must talk to ATM, OCN, and WAV), NOT
# datm_tasks-1 the way a 3-component file's MED does.
MED_model:                      cmeps
MED_petlist_bounds:             0 3599
MED_omp_num_threads:            1
MED_attributes::
  ATM_model = datm
  OCN_model = schism
  WAV_model = ww3
  history_n = 9999
  history_option = nhours
  history_ymd = -999
  coupling_mode = coastal
::

# ATM #
ATM_model:                      datm
ATM_petlist_bounds:             0 119
ATM_omp_num_threads:            1
ATM_attributes::
  Verbosity = 0
  DumpFields = false
  ProfileMemory = false
  OverwriteSlice = true
::

# OCN #
OCN_model:                      schism
OCN_petlist_bounds:             120 2512
OCN_omp_num_threads:            1
OCN_attributes::
  Verbosity = 0
  DumpFields = false
  ProfileMemory = false
  OverwriteSlice = true
  meshloc = element
  CouplingConfig = none
::

# WAV #
# Layout A: PETs 2513-3599 = 1087 wav_tasks, right after OCN's 120-2512.
# PROFILE-FIRST, NOT FINAL -- see the yaml.
WAV_model:                      ww3
WAV_petlist_bounds:             2513 3599
WAV_omp_num_threads:            1
WAV_attributes::
  Verbosity = 0
  DumpFields = false
  ProfileMemory = false
  # Bare name from stage_files.py's _WW3_FIX_FILES ("wav_esmf_mesh.nc"), NOT
  # the reference run's literal "alaska_ESMFmesh.nc" -- stage_ww3_fix_files
  # copies $FIXofs/stofs_3d_ak_ufs.wav_esmf_mesh.nc (the hand-staged, renamed
  # alaska_ESMFmesh.nc) to this bare name in $DATA before launch.
  mesh_wav = wav_esmf_mesh.nc
  multigrid = false
  user_histname = 'false'
  use_historync = 'true'
  use_restartnc = 'true'
  restart_from_binary = 'false'
  pio_typename = 'pnetcdf'
  pio_numiotasks = 4
  pio_stride = -99
  pio_rearranger = 'box'
  pio_root = -99
::

# Run Sequence #
# Structure adapted from the reference configuration (prep -> send to
# components -> step -> collect -> post -> restart_write), NOT the base
# 3-component file's simpler ATM->MED-first ordering -- the base file has no
# "MED med_phases_restart_write" call at all, so even a finite restart_n
# there would never actually write a CMEPS restart. That call is REQUIRED
# here: WAV/MED warm-start cycling depends on it.
#
# Interval: patched at prep from ufs_coastal.coupling_interval; seeded to
# match it. @3600 = 80x SCHISM's 45 s dt and 4x dt_atmos, the value the
# tested AK reference ran. WW3 substeps internally between exchanges.
runSeq::
@3600
  MED med_phases_prep_atm
  MED med_phases_prep_ocn_accum
  MED med_phases_prep_ocn_avg
  MED med_phases_prep_wav_accum
  MED med_phases_prep_wav_avg
  MED -> ATM :remapMethod=redist
  MED -> OCN :remapMethod=redist
  MED -> WAV :remapMethod=redist
  ATM
  OCN
  WAV
  ATM -> MED :remapMethod=redist
  OCN -> MED :remapMethod=redist
  WAV -> MED :remapMethod=redist
  MED med_phases_post_atm
  MED med_phases_post_ocn
  MED med_phases_post_wav
  MED med_phases_restart_write
@
::

# ALLCOMP_attributes -- byte-identical to the base file, aside from the
# commented-out write_restart_at_endofrun line below. restart_n=9999 /
# restart_option=nhours are the base's own inert seed (CMEPS never actually
# writes a restart at 9999 nhours): nos_workflow's configure.py
# (patch_ufs_configure) patches both, phase-aware, whenever
# WAV_RESTART_ENABLED is set (this system's yaml sets it). Leaving the seed
# at 9999/nhours/startup means a waves-off reuse of this file degrades
# harmlessly to the base file's behavior; orb_iyear/stop_n are likewise
# overwritten every run by the same patcher.
ALLCOMP_attributes::
  ScalarFieldCount = 3
  ScalarFieldIdxGridNX = 1
  ScalarFieldIdxGridNY = 2
  ScalarFieldIdxNextSwCday = 3
  ScalarFieldName = cpl_scalars
  start_type = startup
  restart_dir = RESTART/
  case_name = ufs.cpld
  restart_n = 9999
  restart_option = nhours
  # write_restart_at_endofrun = .true.
  # UNVERIFIED key name/placement -- would force a restart write at leg-end
  # regardless of the restart_n/restart_option alarm timing. No precedent in
  # this repo sets it; the reference configuration's mediator.log confirms
  # CMEPS reads a key by this exact name ("write_restart_at_endofrun : F",
  # the CMEPS default). Confirm against the CMEPS coastal fork build during
  # bring-up before uncommenting.
  restart_ymd = -999
  orb_eccen = 1.e36
  orb_iyear = 2026
  orb_iyear_align = 2026
  orb_mode = fixed_year
  orb_mvelp = 1.e36
  orb_obliq = 1.e36
  stop_n = 48
  stop_option = nhours
  stop_ymd = -999
::
