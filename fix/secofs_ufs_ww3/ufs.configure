#############################################
####  NEMS Run-Time Configuration File  #####
####  DATM + SCHISM + WW3 (4-component)  #####
#############################################

# ESMF #
logKindFlag:            ESMF_LOGKIND_MULTI
globalResourceControl:  true

# EARTH #
EARTH_component_list: ATM OCN WAV MED
EARTH_attributes::
  Verbosity = 0
::

# MED #
# PET span = 0 5519, the FULL union of ATM+OCN+WAV -- deliberately wider
# than the 3-component secofs_ufs file (MED there is co-located with ATM
# only, 0 119). Matches the validated Alaska DATM+SCHISM+WW3 reference.
MED_model:                      cmeps
MED_petlist_bounds:             0 5519
MED_omp_num_threads:            1
MED_attributes::
  ATM_model = datm
  OCN_model = schism
  WAV_model = ww3
  history_n = 9999
  history_option = nhours
  history_ymd = -999
  coupling_mode = coastal
  pio_typename = PNETCDF
  pio_stride = 8
  # Precomputed ocn->wav regrid weights. Without this, ESMF builds the
  # bilinear map at runtime by constructing an internal dual of SCHISM's
  # mesh (source side), which aborts in ESMCI_MeshDual.C at this PET
  # count/mesh size. Supplying the weight file skips that construction
  # entirely.
  ocn2wav_smapname = secofs_ufs.ocn2wav_weights.nc
  # Precomputed wav->ocn regrid weights (CMEPS-interface patch
  # cmeps_patch/wav2ocn_smapname.patch required -- see the repo runbook,
  # "V16 -- wav2ocn weights + CMEPS patch"). Same ESMF_FieldSMMStore
  # mechanism as ocn2wav_smapname above, applied to the reverse map, so
  # ESMF never takes the online regrid-store path for either wav<->ocn
  # direction at this PET count/mesh size.
  wav2ocn_smapname = secofs_ufs.wav2ocn_weights.nc
::

# ATM #
ATM_model:                      datm
ATM_petlist_bounds:             0 119
ATM_omp_num_threads:            1
ATM_attributes::
  Verbosity = 0
  DumpFields = false
  ProfileMemory = false
  OverwriteSlice = true
::

# OCN #
OCN_model:                      schism
OCN_petlist_bounds:             120 2913
OCN_omp_num_threads:            1
OCN_attributes::
  Verbosity = 0
  DumpFields = false
  ProfileMemory = false
  OverwriteSlice = true
  # element, NOT node. The node path in SCHISM's cap publishes the AUGMENTED
  # element set (nea, allocate elementids(nea)/nv(sum(i34(1:nea)))), so ghost
  # elements are duplicated across PETs with no owners -- the transferred
  # element distgrid grows past ne_global and the OCN-MED connector's
  # RedistStore fails with truncated messages. The element path publishes
  # resident-only elements (ne) and is the exercised one.
  # Consequence: ESMF would build an internal dual of SCHISM's mesh for the
  # ocn-to-wav bilinear map (source side only), which aborts at this scale.
  # That is avoided by supplying precomputed regrid weights instead, not by
  # switching meshloc.
  meshloc = element
  CouplingConfig = none
::

# WAV #
# PETs 2914-5519 (2606 PETs, sized for the shipped e0m water-only wave
# mesh) -- see nos-utils UFSConfigProcessor._patch_pet_bounds for the
# datm+schism+wav==total cross-check applied at prep time. mesh_wav must
# match ufs_coastal.wav_mesh in parm/systems/secofs_ufs_ww3.yaml.
WAV_model:                      ww3
WAV_petlist_bounds:             2914 5519
WAV_omp_num_threads:            1
WAV_attributes::
  # dbug_flag = 0: promoted to routine daily 12z ops cycling, so the
  # per-coupling-window imported-field min/max diagnostics (So_h, So_u,
  # So_v) that dbug_flag=6 prints to the WAV PET logs are switched off.
  # That level was kept through the first e0m fully-coupled validation
  # run -- it provided the field-extrema evidence that pinned the current
  # ranges in V12, and would have given the same evidence again had e0m
  # crashed; log volume was acceptable at 4766 WAV PETs (2606 is less).
  # Re-enable dbug_flag=6 only for a targeted diagnostic rerun, not for
  # normal cycling.
  dbug_flag = 0
  Verbosity = 0
  DumpFields = false
  ProfileMemory = false
  mesh_wav = secofs_ufs.mesh_wav.nc
  multigrid = false
  user_histname = 'false'
  use_historync = 'true'
  use_restartnc = 'true'
  restart_from_binary = 'false'
  pio_typename = 'pnetcdf'
  pio_numiotasks = 4
  pio_stride = -99
  pio_rearranger = 'box'
  pio_root = -99
::

# Run Sequence #
# @360 = 3x SCHISM's 120s dt (nos_utils enforces the coupling interval is
# an integer multiple of model.physics.dt). WW3's own UNST_NML
# TIMESTEPS%DTXY has been 120s since commit 715e9f8 (halved from 360s to
# restore diagonal dominance for the currents-coupled implicit solve), so
# WW3 now substeps 3x internally per 360s coupling window, not 1:1 -- the
# NUOPC exchange frequency and the SCHISM dt multiple rule are unaffected
# either way, since WW3 substeps on its own between exchanges.
runSeq::
@360
  MED med_phases_prep_atm
  MED med_phases_prep_ocn_accum
  MED med_phases_prep_ocn_avg
  MED med_phases_prep_wav_accum
  MED med_phases_prep_wav_avg
  MED -> ATM :remapMethod=redist
  MED -> OCN :remapMethod=redist
  MED -> WAV :remapMethod=redist
  ATM
  OCN
  WAV
  ATM -> MED :remapMethod=redist
  OCN -> MED :remapMethod=redist
  WAV -> MED :remapMethod=redist
  MED med_phases_post_atm
  MED med_phases_post_ocn
  MED med_phases_post_wav
  MED med_phases_restart_write
@
::

# start_type AND restart_n are both patched per-phase at run time (see
# runners/schism_ufs/configure.py:patch_ufs_configure): start_type is
# nowcast=startup, forecast=continue; restart_n is set to that leg's own
# length in hours (24 for nowcast, 48 for forecast) so restart_option=nhours
# writes exactly one mediator/WW3 restart, at the end of the leg -- landing
# on the nowcast/forecast handoff every cycle instead of (with a fixed 24h
# stride) writing 2 multi-GB restarts across a 48h forecast. The values
# below are the as-checked-in template defaults, overwritten every run.
ALLCOMP_attributes::
  ScalarFieldCount = 3
  ScalarFieldIdxGridNX = 1
  ScalarFieldIdxGridNY = 2
  ScalarFieldIdxNextSwCday = 3
  ScalarFieldName = cpl_scalars
  start_type = startup
  restart_dir = RESTART/
  case_name = ufs.cpld
  restart_n = 24
  restart_option = nhours
  restart_ymd = -999
  orb_eccen = 1.e36
  orb_iyear = 2026
  orb_iyear_align = 2026
  orb_mode = fixed_year
  orb_mvelp = 1.e36
  orb_obliq = 1.e36
  stop_n = 48
  stop_option = nhours
  stop_ymd = -999
::
