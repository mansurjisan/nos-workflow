! ---------------------------------------------------------------------- !
! WAVEWATCH III - ww3_shel.nml (WW3 shell / coupled-run control namelist)
!
! Placeholders (@[VAR]) are patched per-cycle by
! runners/schism_ufs/configure.py:patch_ww3_shel, mirroring the @[VAR]
! convention already used by model_configure.template / datm_in.template.
! ---------------------------------------------------------------------- !

&domain_nml
  domain%start = '@[WW3_CYCLE_START]'
  domain%stop  = '@[WW3_CYCLE_STOP]'
/

! Coupled mode: winds, currents, and water levels all come from the MED
! mediator, not external WW3 input files. No ice in the SECOFS domain.
&input_nml
  input%forcing%winds        = 'C'
  ! BISECT STEP 2 of 3 -- currents off, water levels back ON.
  !
  ! Step 1 (both off) ran a full nowcast and 48 h forecast cleanly, proving one
  ! of these two coupled ocean inputs causes the SIGSEGV seen when both were on:
  ! WW3's ST4 tail-stress table indexed out of bounds (w3src4md.F90:948, where
  ! the TAUHFT2 third index is the only one without a MAX clamp), on the step
  ! immediately after the first SCHISM water-level update.
  !
  ! Water levels are the prime suspect: 41.7% of this wave mesh is dry at datum,
  ! so a level update flips wet/dry and refreshes the PDLIB solver mask, after
  ! which the implicit solve degraded from 10 to 170 iterations and exited on
  ! the JGS_PMIN escape with roughly 35k nodes unconverged. Currents do not
  ! touch that mask. Turning water levels on alone tests exactly that.
  !
  ! If this run SEGFAULTS: water levels are confirmed; keep them off and move to
  ! currents='C'/water_levels='F', which retains wave-current interaction and the
  ! wave-to-ocean feedback. Mitigations to try after that: DTMAX 360->120 in
  ! ww3_grid TIMESTEPS_NML with runSeq @120, or the upstream one-line clamp.
  ! If this run SURVIVES: water levels are fine and currents are the culprit;
  ! step 3 is currents='C' for full two-way coupling.
  input%forcing%currents     = 'F'
  input%forcing%water_levels = 'C'
  input%forcing%ice_conc     = 'F'
  input%forcing%ice_param1   = 'F'
  input%forcing%ice_param5   = 'F'
/

&output_type_nml
  type%field%list  = 'WND WLV CUR HS FP DP PHS PTP PDIR DIR T01'
  type%point%file  = 'ww3_points.list'
/

! date%restart%stride: nowcast writes exactly one restart at leg end
! (matches SCHISM's own hotstart handoff); forecast has no further
! hot-start consumer inside the cycle, so its stride is set far beyond
! FHMAX to suppress extra restart writes. Both values are patched per
! phase by patch_ww3_shel -- see that function's docstring.
!
! date%point%stride is deliberately 0 (point output OFF): ww3_points.list
! does not exist and is not staged -- we have no SECOFS wave-station list
! yet and no WW3 point post-processing defined. A non-zero stride makes
! wav_shel_inp.F90 open type%point%file unconditionally and hard-abort
! (EXTCDE 1104) when it's missing. Revisit once a station list exists.
&output_date_nml
  date%field%start    = '@[WW3_CYCLE_START]'
  date%field%stride   = '3600'
  date%field%stop     = '@[WW3_CYCLE_STOP]'
  date%point%start    = '@[WW3_CYCLE_START]'
  date%point%stride   = '0'
  date%point%stop     = '@[WW3_CYCLE_STOP]'
  date%restart%start  = '@[WW3_CYCLE_START]'
  date%restart%stride = '@[WW3_RESTART_STRIDE_SEC]'
  date%restart%stop   = '@[WW3_CYCLE_STOP]'
/

&homog_count_nml
/

&homog_input_nml
/

! ---------------------------------------------------------------------- !
! WAVEWATCH III - end of namelist                                        !
! ---------------------------------------------------------------------- !
