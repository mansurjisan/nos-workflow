&datm_nml
  datamode = "ATMMESH"
  factorfn_data = "null"
  factorfn_mesh = "null"
  flds_co2 = .false.
  flds_presaero = .false.
  flds_wiso = .false.
  iradsw = 1
  model_maskfile = "@[DATM_INPUT_DIR]/@[DATM_MESH_FILE]"
  model_meshfile = "@[DATM_INPUT_DIR]/@[DATM_MESH_FILE]"
  nx_global = @[NX_GLOBAL]
  ny_global = @[NY_GLOBAL]
  restfilm = "null"
  export_all = .true.
  ! start_type is a DRIVER attribute (UFSDriver.F90 AddAttributes) that
  ! propagates read_restart=.true. to every component once a wave-coupled
  ! forecast leg continues from the mediator/WW3 restart handoff -- DATM
  ! has no restart of its own here (datamode=ATMMESH, no rpointer.atm
  ! ever written/staged) and would otherwise abort on the missing
  ! rpointer or, failing that, on ATMMESH not being in CDEPS's restart-
  ! read select (atm_comp_nuopc.F90). skip_restart_read bypasses both.
  skip_restart_read = .true.
/
