#!/bin/bash
#PBS  -N secofs_2d_ufs_gefs_prep
#PBS  -A ESTOFS-DEV
#PBS  -q dev
#PBS  -o /lfs/h1/nos/ptmp/$LOGNAME/rpt/secofs_2d_ufs/secofs_2d_ufs_gefs_prep.out
#PBS  -e /lfs/h1/nos/ptmp/$LOGNAME/rpt/secofs_2d_ufs/secofs_2d_ufs_gefs_prep.err
#PBS  -l select=1:ncpus=128:mpiprocs=8
#PBS  -l place=vscatter
#PBS  -l walltime=03:00:00

# ------------------------------------------------------------------
# SECOFS 2D Barotropic UFS-Coastal GEFS Atmospheric Prep PBS Job
#
# Creates GEFS atmospheric forcing (DATM input files) for 14 GEFS
# members (gep01-gep14). Each member requires ~10 min of wgrib2/NCO
# processing, so walltime is set to 3 hours for safety.
#
# This job runs between the regular prep and ensemble member jobs:
#   prep --> gefs_atmos_prep --> member_000, member_001, ...
#
# Submit via launch_secofs_2d_ufs_ensemble.sh or manually:
#   qsub -v CYC=00,PDY=20260313,OFS=secofs_2d_ufs,N_GEFS_MEMBERS=14 \
#        jnos_secofs_2d_ufs_gefs_prep.pbs
# ------------------------------------------------------------------

CYC=${CYC:-00}

# PDY: accept from qsub -v, fall back to today
export PDY=${PDY:-$(date +%Y%m%d)}

PACKAGEROOT=/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages
. ${PACKAGEROOT}/nosofs.v3.7.0/versions/run.ver

# OFS: accept from launcher (default: secofs_2d_ufs)
export OFS=${OFS:-secofs_2d_ufs}

# Number of GEFS members to process (default: 14 for gep01-gep14)
export N_GEFS_MEMBERS=${N_GEFS_MEMBERS:-14}

# Working directory
RPTDIR=/lfs/h1/nos/ptmp/$LOGNAME/rpt/${OFS}
WORKDIR=/lfs/h1/nos/ptmp/$LOGNAME/work/${nosofs_ver}/${OFS}
if [ ! -r $WORKDIR ]; then
  mkdir -p -m 755 $WORKDIR
fi
cd ${WORKDIR}

# Save PACKAGEROOT before module loads (prod_envir overrides it)
_SAVED_PACKAGEROOT=${PACKAGEROOT}

module purge
module load envvar/${envvar_ver:-1.0}
module load intel/${intel_ver:-19.1.3.304}
module load PrgEnv-intel/${PrgEnv_intel_ver:-8.1.0}
module load craype/${craype_ver:-2.7.8}
module load cray-mpich/${cray_mpich_ver:-8.1.7}
module load cray-pals/${cray_pals_ver:-1.0.12}
module load hdf5/${hdf5_ver:-1.10.6}
module load netcdf/${netcdf_ver:-4.7.4}
module load jasper/${jasper_ver:-2.0.25}
module load udunits/${udunits_ver:-2.2.28}
module load zlib/${zlib_ver:-1.2.11}
module load bufr/${bufr_ver:-11.5.0}
module load g2/${g2_ver:-3.4.5}
module load w3nco/${w3nco_ver:-2.4.1}
module load w3emc/${w3emc_ver:-2.9.2}
module load subversion/${subversion_ver:-1.14.0}
module load python/${python_ver:-3.8.6}
module load prod_envir/${prod_envir_ver:-2.0.6}
module load prod_util/${prod_util_ver:-2.0.17}
module load cfp/${cfp_ver:-2.0.4}
module load libjpeg/${libjpeg_ver:-9c}
module load grib_util/${grib_util_ver:-1.2.4}
module load gsl/${gsl_ver:-2.7}
module load wgrib2/${wgrib2_ver:-2.0.8}
module load nco/${nco_ver:-5.0.6}
# ESMF module for ESMF_Scrip2Unstruct (mesh generation)
module load esmf/${esmf_ver:-8.4.2} 2>/dev/null || echo "WARNING: esmf module not available"

module list

# Restore PACKAGEROOT (prod_envir sets it to /lfs/h1/ops/prod/packages)
PACKAGEROOT=${_SAVED_PACKAGEROOT}
unset _SAVED_PACKAGEROOT

# EXPORT list
set +x
export envir=dev
export cyc=${CYC}
export NET=nosofs
export model=nosofs
export job=${OFS}_gefs_prep_${CYC}_$envir
export platform=ptmp

# Barotropic mode
export BAROTROPIC=true

# UFS-Coastal DATM coupling (auto-detect from OFS name)
export USE_DATM=${USE_DATM:-true}

export KEEPDATA=YES
export SENDCOM=NO
export SENDDBN=NO
export SENDSMS=NO

export nosofs_ver=v3.7.0
export PACKAGEROOT

# Data and COM paths
export COMPATH=/lfs/h1/ops/prod/com/nos
export com_ver=v3.7
export COMROOT=/lfs/h1/nos/ptmp/$LOGNAME/com
export DCOMROOT=/lfs/h1/ops/prod/dcom
export DATAROOT=/lfs/h1/nos/ptmp/$LOGNAME/work/${nosofs_ver}/${OFS}

# Input data paths (production WCOSS2)
export COMINnam=/lfs/h1/ops/prod/com/nam/${nam_ver}
export COMINhrrr=/lfs/h1/ops/prod/com/hrrr/${hrrr_ver}
export COMINrap=/lfs/h1/ops/prod/com/rap/${rap_ver}
export COMINgfs=/lfs/h1/ops/prod/com/gfs/${gfs_ver}
export COMINrtma=/lfs/h1/ops/prod/com/rtma/${rtma_ver}
export COMINetss=/lfs/h1/ops/prod/com/petss/${petss_ver}
export COMINrtofs_2d=/lfs/h1/ops/prod/com/rtofs/${rtofs_ver}
export COMINrtofs_3d=/lfs/h1/ops/prod/com/rtofs/${rtofs_ver}
export COMINnwm=/lfs/h1/ops/prod/com/nwm/${nwm_ver}
export COMINgefs=/lfs/h1/ops/prod/com/gefs/${gefs_ver:-v12.3}
export COMIN=/lfs/h1/ops/prod/com

################################################
# CALL executable job script here
export pbsid=${PBS_JOBID%%.*}
export job=${job:-$PBS_JOBNAME}
export jobid=${jobid:-$job.$PBS_JOBID}

export HOMEnos=${PACKAGEROOT}/nosofs.${nosofs_ver}
export OFS_CONFIG=${HOMEnos}/parm/systems/${OFS}.yaml
export PYTHONPATH=${HOMEnos}/ush/python:${PYTHONPATH:-}

${HOMEnos}/jobs/JNOS_OFS_ENSEMBLE_ATMOS_PREP
