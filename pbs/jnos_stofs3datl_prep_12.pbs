#!/bin/bash
#PBS  -N s3d_prep_12
#PBS  -A ESTOFS-DEV
#PBS  -q dev
#PBS  -o /lfs/h1/nos/ptmp/mansur.jisan/rpt/stofs_3d_atl/stofs3datl_prep_12.out
#PBS  -e /lfs/h1/nos/ptmp/mansur.jisan/rpt/stofs_3d_atl/stofs3datl_prep_12.err
#PBS  -l select=1:ncpus=8:mpiprocs=8
#PBS  -l place=vscatter
#PBS  -l walltime=01:30:00

# Source STOFS version file
. /lfs/h1/nos/estofs/noscrub/$LOGNAME/packages/IT-stofs.v2.1.0/versions/stofs_3d_atl/run.ver

# Working directory
RPTDIR=/lfs/h1/nos/ptmp/$LOGNAME/rpt/stofs_3d_atl
WORKDIR=/lfs/h1/nos/ptmp/$LOGNAME/work/stofs_3d_atl
if [ ! -r $WORKDIR ]; then
  mkdir -p -m 755 $WORKDIR
fi
cd ${WORKDIR}

# Module setup (matching STOFS ECF)
module purge
module load envvar/${envvar_ver}
module load intel/${intel_ver}
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load hdf5/${hdf5_ver}
module load netcdf/${netcdf_ver}
module load jasper/${jasper_ver}
module load udunits/${udunits_ver}
module load zlib/${zlib_ver}
module load bufr/${bufr_ver}
module load g2/${g2_ver}
module load w3nco/${w3nco_ver}
module load w3emc/${w3emc_ver}
module load subversion/${subversion_ver}
module load python/${python_ver}
module load prod_envir/${prod_envir_ver}
module load prod_util/${prod_util_ver}
module load ve/stofs/${ve_stofs}
module load cfp/${cfp_ver}
module load libjpeg/${libjpeg_ver}
module load grib_util/${grib_util_ver}
module load gsl/${gsl_ver}
module load wgrib2/${wgrib2_ver}
module load nco/${nco_ver}

module list

# EXPORT list
set +x
export envir=dev
export OFS=stofs_3d_atl
export cyc=12
export NET=stofs
export model=stofs
export job=stofs3datl_prep_12_$envir
export platform=ptmp

export KEEPDATA=YES
export SENDCOM=NO
export SENDDBN=NO
export SENDSMS=NO

# STOFS home directory (IT-stofs package)
export HOMEstofs=/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages/IT-stofs.v2.1.0
export stofs_ver=v2.1.0

# nosofs home (for unified J-job and YAML config)
export nosofs_ver=v3.7.0
export PACKAGEROOT=/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages

# Data and COM paths
export COMROOT=/lfs/h1/nos/ptmp/$LOGNAME/com
export DCOMROOT=/lfs/h1/ops/prod/dcom
export DATAROOT=/lfs/h1/nos/ptmp/$LOGNAME/work/${OFS}

# Input data paths
export COMINgfs=/lfs/h1/ops/prod/com/gfs/${gfs_ver}
export COMINhrrr=/lfs/h1/ops/prod/com/hrrr/${hrrr_ver}
export COMINrtofs=/lfs/h1/ops/prod/com/rtofs/v2.4
export COMINrtofs_2d=/lfs/h1/ops/prod/com/rtofs/v2.4
export COMINrtofs_3d=/lfs/h1/ops/prod/com/rtofs/v2.4
export COMINnwm=/lfs/h1/ops/prod/com/nwm/${nwm_ver}
export COMIN=/lfs/h1/ops/prod/com

################################################
# CALL executable job script here
export pbsid=${PBS_JOBID%%.*}
export job=${job:-$PBS_JOBNAME}
export jobid=${jobid:-$job.$PBS_JOBID}

# YAML configuration (from unified package)
export OFS_CONFIG=/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages/nosofs.v3.7.0/parm/systems/stofs_3d_atl.yaml
export PYTHONPATH=/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages/nosofs.v3.7.0/ush/python:$PYTHONPATH

/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages/nosofs.${nosofs_ver}/jobs/JNOS_OFS_PREP
