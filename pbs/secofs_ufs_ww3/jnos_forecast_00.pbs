#!/bin/bash
#PBS  -N secofs_ufs_ww3_fc_00
#PBS  -A ESTOFS-DEV
#PBS  -q dev
#PBS  -o /dev/null
#PBS  -e /dev/null
#PBS  -l place=vscatter:excl,select=46:ncpus=128:mpiprocs=120:ompthreads=1
#PBS  -l walltime=06:30:00

PACKAGEROOT=/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages
. ${PACKAGEROOT}/nos-workflow/versions/run.ver

# Working directory
export OFS=${OFS:-secofs_ufs_ww3}
RPTDIR=/lfs/h1/nos/ptmp/$LOGNAME/rpt/${OFS}
WORKDIR=/lfs/h1/nos/ptmp/$LOGNAME/work/${OFS}
mkdir -p -m 755 $RPTDIR $WORKDIR

# Per-job log files (PBS jobid as suffix). PBS -o/-e are pointed at
# /dev/null above; this redirect is what populates forecast logs.
_JOBID=${PBS_JOBID%%.*}
_LOG_PREFIX="$RPTDIR/secofs_ufs_ww3_forecast_00.${_JOBID}"
exec > "${_LOG_PREFIX}.out" 2> "${_LOG_PREFIX}.err"
echo "=== secofs_ufs_ww3_forecast_00 — PBS jobid ${PBS_JOBID} on $(hostname) at $(date) ==="
cd ${WORKDIR}

# ----------------------------------------------------------------
# Module setup: UFS-Coastal hpc-stack libraries
# ----------------------------------------------------------------
# The UFS executable (fv3_coastalSW.exe, wave-enabled build) requires
# hpc-stack libraries (hdf5-D/1.14.0, netcdf-D/4.9.2, esmf-D/8.8.0) that
# differ from standard WCOSS2 system modules (hdf5/1.10.6, netcdf/4.7.4).
module purge
module reset

# Clear version env vars that would override modules.fv3.lua defaults
# (run.ver sets e.g. PrgEnv_intel_ver=8.3.3 but UFS was compiled with 8.1.0)
unset PrgEnv_intel_ver craype_ver cmake_ver g2_ver w3emc_ver 2>/dev/null || true

# Load UFS-Coastal hpc-stack modules
module use ${PACKAGEROOT}/nos-workflow/modulefiles
module load modules.fv3
module load cray-pals

# MPI fabric settings. Operational IT-STOFS parity (also used by
# stofs_3d_atl_ufs), plus enlarged OFI receive queues: at high WAV rank
# counts (first seen at 7680 total ranks) the WW3/PDLIB neighbour exchange
# exhausted the default RXM queue and MPICH reported "OFI is failing to
# make progress on posting a receive" from the WAV rank range.
export MPICH_OFI_STARTUP_CONNECT=1
export MPICH_COLL_SYNC=MPI_Bcast
export MPICH_REDUCE_NO_SMP=1
export FI_OFI_RXM_RX_SIZE=${FI_OFI_RXM_RX_SIZE:-32768}
export FI_OFI_RXM_TX_SIZE=${FI_OFI_RXM_TX_SIZE:-32768}

# Infrastructure modules for J-job scripting
module load python/${python_ver:-3.8.6}
module load prod_envir/${prod_envir_ver:-2.0.6}
module load prod_util/${prod_util_ver:-2.0.17}

module list

# EXPORT list
set +x
export envir=dev
export OFS=${OFS:-secofs_ufs_ww3}
export cyc=${CYC:-00}
export PDY=${PDY:-$(date +%Y%m%d)}
export job=secofs_ufs_ww3_fc_00_$envir
export platform=ptmp

export KEEPDATA=YES
export SENDCOM=NO
export SENDDBN=NO
export SENDSMS=NO

# nosofs_ver removed: tree is unversioned (was v3.7.0)
export PACKAGEROOT=/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages

# Data and COM paths
export COMPATH=/lfs/h1/ops/prod/com/nos
export COMROOT=/lfs/h1/nos/ptmp/$LOGNAME/com
export DCOMROOT=/lfs/h1/ops/prod/dcom
export DATAROOT=/lfs/h1/nos/ptmp/$LOGNAME/work/${OFS}
export COMIN=/lfs/h1/ops/prod/com

# Input data paths (production WCOSS2)
export COMINnam=/lfs/h1/ops/prod/com/nam/${nam_ver}
export COMINhrrr=/lfs/h1/ops/prod/com/hrrr/${hrrr_ver}
export COMINrap=/lfs/h1/ops/prod/com/rap/${rap_ver}
export COMINgfs=/lfs/h1/ops/prod/com/gfs/${gfs_ver}
export COMINrtma=/lfs/h1/ops/prod/com/rtma/${rtma_ver}
export COMINetss=/lfs/h1/ops/prod/com/petss/${petss_ver}
export COMINrtofs_2d=/lfs/h1/ops/prod/com/rtofs/${rtofs_ver}
export COMINrtofs_3d=/lfs/h1/ops/prod/com/rtofs/${rtofs_ver}
export COMINnwm=/lfs/h1/ops/prod/com/nwm/${nwm_ver}

# UFS-Coastal 4-component: MED spans PETs 0-5519 (full ATM+OCN+WAV union),
# ATM 0-119, OCN 120-2913, WAV 2914-5519 (e0m water-only wave mesh).
# 46 nodes x 120 mpiprocs = 5520 tasks exactly, 0 idle slots.
export TOTAL_TASKS=${TOTAL_TASKS:-5520}

# Wave-enabled build. parm/systems/secofs_ufs_ww3.yaml's model.executable
# is NOT auto-propagated to the runner for the UFS (non-standalone) path
# (only the standalone overlay does that -- see yaml_to_env.py
# get_standard_exports), so this must be exported explicitly or the
# runner silently falls back to the non-wave fv3_coastalS.exe default.
export UFS_EXEC_NAME=${UFS_EXEC_NAME:-fv3_coastalSW.exe}

################################################
# CALL executable job script here
export pbsid=${PBS_JOBID%%.*}
export job=${job:-$PBS_JOBNAME}
export jobid=${jobid:-$job.$PBS_JOBID}

# YAML configuration for secofs_ufs_ww3
export HOMEnos=${PACKAGEROOT}/nos-workflow
export OFS_CONFIG=${HOMEnos}/parm/systems/${OFS}.yaml
export PYTHONPATH=${HOMEnos}/ush/python:${PYTHONPATH:-}

# Submission: do NOT use `-W depend=afterok:` across these jobs. With the
# ParMETIS blind-retry below, a crashed job exits non-zero and resubmits
# itself as a NEW jobid; an afterok dependent would be cancelled and would
# never see the retry. Submit sequentially after each leg succeeds:
#   qsub jnos_nowcast_00.pbs    # self-retries until rst.nowcast.nc archived
#   qsub jnos_forecast_00.pbs   # after nowcast PASS; self-retries
#   qsub jnos_post_00.pbs       # after forecast PASS

${HOMEnos}/jobs/JNOS_FORECAST
_rc=$?

# --- ParMETIS blind-retry ---------------------------------------------------
# partition_hgrid:534 is a nondeterministic ParMETIS heap corruption seen at
# ~2914-rank SCHISM allocations (nos-workflow #98), independent of node
# placement; a resubmit re-rolls the rank/heap layout and usually clears it.
# Same guard as secofs_ufs's own forecast card, unchanged for the larger
# 5520-rank allocation. NOTE: JNOS_* does not reliably propagate the stage
# exit code (it ends on postmsg/date), so ${_rc} can be 0 even on a crash —
# decide from the log, not rc: retry iff the signature appears in .err OR
# .out AND the stage did not log status=PASS.
if grep -qE 'partition_hgrid|double free or corruption|Failed during initial partitioning' "${_LOG_PREFIX}.err" "${_LOG_PREFIX}.out" 2>/dev/null \
   && ! grep -qE 'STAGE_SUMMARY .*status=PASS' "${_LOG_PREFIX}.out" 2>/dev/null; then
  RETRY=${PARMETIS_RETRY:-0}; MAXRETRY=8
  if [ "${RETRY}" -lt "${MAXRETRY}" ]; then
    echo "PARMETIS_RETRY: partition_hgrid crash (rc=${_rc}); resubmitting attempt $((RETRY+1))/${MAXRETRY}"
    qsub -v "PDY=${PDY:-},CYC=${CYC:-${cyc:-00}},COMOUT=${COMOUT:-},COMIN=${COMIN:-},PARMETIS_RETRY=$((RETRY+1))" "$0"
  else
    echo "PARMETIS_RETRY: max retries (${MAXRETRY}) exhausted — giving up"
  fi
fi
exit "${_rc}"
# --- end ParMETIS blind-retry -----------------------------------------------
