#!/bin/bash
#PBS  -N secofs_ufs_atmos_prep
#PBS  -A ESTOFS-DEV
#PBS  -q dev
#PBS  -o /lfs/h1/nos/ptmp/mansur.jisan/rpt/secofs_ufs/secofs_ufs_atmos_prep.out
#PBS  -e /lfs/h1/nos/ptmp/mansur.jisan/rpt/secofs_ufs/secofs_ufs_atmos_prep.err
#PBS  -l select=1:ncpus=8:mpiprocs=8
#PBS  -l place=vscatter
#PBS  -l walltime=02:00:00

# ------------------------------------------------------------------
# SECOFS UFS-Coastal Ensemble Atmospheric Prep PBS Job
#
# Creates DATM-format forcing files for GEFS/RRFS ensemble members.
# Runs between the regular prep job and ensemble member jobs.
# Each member gets its own datm_input directory in COMOUT.
#
# Submit via launch_secofs_ufs_ensemble.sh --gefs or manually:
#   qsub -v CYC=00,PDY=20260213 jnos_secofs_ufs_ensemble_atmos_prep.pbs
# ------------------------------------------------------------------

CYC=${CYC:-00}

# PDY: accept from qsub -v, fall back to today
export PDY=${PDY:-$(date +%Y%m%d)}

PACKAGEROOT=/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages
. ${PACKAGEROOT}/nosofs.v3.7.0/versions/run.ver

# Working directory
RPTDIR=/lfs/h1/nos/ptmp/$LOGNAME/rpt/secofs_ufs
WORKDIR=/lfs/h1/nos/ptmp/$LOGNAME/work/${nosofs_ver}/secofs_ufs
mkdir -p -m 755 $RPTDIR $WORKDIR
cd ${WORKDIR}

# Standard modules (NOT hpc-stack — this job runs Python/wgrib2, not UFS)
module purge
module load envvar/${envvars_ver}

module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load netcdf/${netcdf_ver}
module load hdf5/${hdf5_ver}
module load python/${python_ver}
module load prod_envir/${prod_envir_ver}
module load prod_util/${prod_util_ver}
module load grib_util/${grib_util_ver}
module load cfp/${cfp_ver}
module load nco/${nco_ver}
module load wgrib2/${wgrib2_ver}

module list

# EXPORT list
set +x
export envir=dev
export OFS=secofs_ufs
export cyc=${CYC}
export NET=nosofs
export model=nosofs
export job=secofs_ufs_atmos_prep_${CYC}_$envir
export platform=ptmp

# UFS-Coastal DATM coupling
export USE_DATM=true

export KEEPDATA=YES
export SENDCOM=NO
export SENDDBN=NO
export SENDSMS=NO

export nosofs_ver=v3.7.0
export PACKAGEROOT=/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages

# Data and COM paths
export COMPATH=/lfs/h1/ops/prod/com/nos
export com_ver=v3.7
export COMROOT=/lfs/h1/nos/ptmp/$LOGNAME/com
export DCOMROOT=/lfs/h1/ops/prod/dcom
export DATAROOT=/lfs/h1/nos/ptmp/$LOGNAME/work/${nosofs_ver}/${OFS}
export COMIN=/lfs/h1/ops/prod/com

# Input data paths
export COMINnam=/lfs/h1/ops/prod/com/nam/${nam_ver}
export COMINhrrr=/lfs/h1/ops/prod/com/hrrr/${hrrr_ver}
export COMINrap=/lfs/h1/ops/prod/com/rap/${rap_ver}
export COMINgfs=/lfs/h1/ops/prod/com/gfs/${gfs_ver}
export COMINrtma=/lfs/h1/ops/prod/com/rtma/${rtma_ver}
export COMINetss=/lfs/h1/ops/prod/com/petss/${petss_ver}
export COMINrtofs_2d=/lfs/h1/ops/prod/com/rtofs/${rtofs_ver}
export COMINrtofs_3d=/lfs/h1/ops/prod/com/rtofs/${rtofs_ver}
export COMINnwm=/lfs/h1/ops/prod/com/nwm/${nwm_ver}
export COMINgefs=/lfs/h1/ops/prod/com/gefs/${gefs_ver:-v12.3}
export COMINrrfs=/lfs/h1/ops/para/com/rrfs/${rrfs_ver:-v1.0}

################################################
# CALL executable job script here
export pbsid=${PBS_JOBID%%.*}
export job=${job:-$PBS_JOBNAME}
export jobid=${jobid:-$job.$PBS_JOBID}

export HOMEnos=${PACKAGEROOT}/nosofs.${nosofs_ver}
export OFS_CONFIG=${HOMEnos}/parm/systems/${OFS}.yaml
export PYTHONPATH=${HOMEnos}/ush/python:${PYTHONPATH:-}

${HOMEnos}/jobs/JNOS_OFS_ENSEMBLE_ATMOS_PREP
