#!/bin/bash
#PBS  -N stofs3datl_ens${MEMBER_ID}_${CYC}
#PBS  -A ESTOFS-DEV
#PBS  -q dev
#PBS  -o /lfs/h1/nos/ptmp/mansur.jisan/rpt/stofs_3d_atl/stofs3datl_ens${MEMBER_ID}_${CYC}.out
#PBS  -e /lfs/h1/nos/ptmp/mansur.jisan/rpt/stofs_3d_atl/stofs3datl_ens${MEMBER_ID}_${CYC}.err
#PBS  -l select=39:ncpus=128:mpiprocs=128
#PBS  -l place=vscatter:exclhost
#PBS  -l walltime=06:00:00

# ------------------------------------------------------------------
# STOFS-3D-ATL Ensemble Member PBS Job
#
# Runs a single ensemble member. Submit via launch_stofs3datl_ensemble.sh
# or manually with:
#   qsub -v MEMBER_ID=001,CYC=12 jnos_stofs3datl_ensemble_member.pbs
#
# Requires MEMBER_ID and CYC to be passed via qsub -v.
# ------------------------------------------------------------------

# Validate required variables
if [ -z "${MEMBER_ID:-}" ]; then
    echo "ERROR: MEMBER_ID not set. Use: qsub -v MEMBER_ID=001,CYC=12 $0" >&2
    exit 1
fi
CYC=${CYC:-12}

# Source STOFS version file
PACKAGEROOT=/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages
. ${PACKAGEROOT}/nosofs.v3.7.0/versions/stofs_3d_atl/run.ver

# Working directory
RPTDIR=/lfs/h1/nos/ptmp/$LOGNAME/rpt/stofs_3d_atl
WORKDIR=/lfs/h1/nos/ptmp/$LOGNAME/work/stofs_3d_atl/ensemble
mkdir -p -m 755 $RPTDIR $WORKDIR
cd ${WORKDIR}

# Module setup (matching STOFS ECF)
module purge
module load envvar/${envvar_ver}
module load intel/${intel_ver}
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load hdf5/${hdf5_ver}
module load netcdf/${netcdf_ver}
module load jasper/${jasper_ver}
module load udunits/${udunits_ver}
module load zlib/${zlib_ver}
module load bufr/${bufr_ver}
module load g2/${g2_ver}
module load w3nco/${w3nco_ver}
module load w3emc/${w3emc_ver}
module load subversion/${subversion_ver}
module load python/${python_ver}
module load prod_envir/${prod_envir_ver}
module load prod_util/${prod_util_ver}
module load ve/stofs/${ve_stofs}
module load cfp/${cfp_ver}
module load libjpeg/${libjpeg_ver}
module load grib_util/${grib_util_ver}
module load gsl/${gsl_ver}
module load wgrib2/${wgrib2_ver}
module load nco/${nco_ver}
module load cdo/${cdo_ver:-2.0.5} 2>/dev/null || true
module load metis/${metis_ver:-5.1.0} 2>/dev/null || true

module list

# MPI tuning for large-core SCHISM runs on Cray (from IT-STOFS production)
export MPICH_OFI_STARTUP_CONNECT=1      # Pre-establish MPI connections at startup
export MPICH_COLL_SYNC=MPI_Bcast        # Pace Bcast messaging to prevent hangs
export MPICH_REDUCE_NO_SMP=1            # Prevent MPI_Reduce hangs during timestepping
export FI_OFI_RXM_SAR_LIMIT=1572864    # Increase rendezvous message buffer (from WCOFS)

# EXPORT list
set +x
export envir=dev
export OFS=stofs_3d_atl
export cyc=${CYC}
export NET=stofs
export model=stofs
export MEMBER_ID=${MEMBER_ID}
export job=stofs3datl_ens${MEMBER_ID}_${CYC}_$envir
export platform=ptmp

export KEEPDATA=YES
export SENDCOM=NO
export SENDDBN=NO
export SENDSMS=NO

# Unified package root (STOFS + COMF scripts, J-jobs, YAML config)
export nosofs_ver=v3.7.0
export com_ver=v2.1.0
export PACKAGEROOT=/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages

# Data and COM paths
export COMROOT=/lfs/h1/nos/ptmp/$LOGNAME/com
export DCOMROOT=/lfs/h1/ops/prod/dcom
export DATAROOT=/lfs/h1/nos/ptmp/$LOGNAME/work/${OFS}/ensemble

# Input data paths (production WCOSS2)
export COMINnam=/lfs/h1/ops/prod/com/nam/${nam_ver}
export COMINhrrr=/lfs/h1/ops/prod/com/hrrr/${hrrr_ver}
export COMINrap=/lfs/h1/ops/prod/com/rap/${rap_ver}
export COMINgfs=/lfs/h1/ops/prod/com/gfs/${gfs_ver}
export COMINrtma=/lfs/h1/ops/prod/com/rtma/${rtma_ver}
export COMINetss=/lfs/h1/ops/prod/com/petss/${petss_ver}
export COMINrtofs_2d=/lfs/h1/ops/prod/com/rtofs/${rtofs_ver}
export COMINrtofs_3d=/lfs/h1/ops/prod/com/rtofs/${rtofs_ver}
export COMINnwm=/lfs/h1/ops/prod/com/nwm/${nwm_ver}

################################################
# CALL executable job script here
export pbsid=${PBS_JOBID%%.*}
export job=${job:-$PBS_JOBNAME}
export jobid=${jobid:-$job.$PBS_JOBID}

# YAML configuration
export HOMEnos=${PACKAGEROOT}/nosofs.${nosofs_ver}
export OFS_CONFIG=${HOMEnos}/parm/systems/${OFS}.yaml
export PYTHONPATH=${HOMEnos}/ush/python:${PYTHONPATH:-}

# MPI configuration for SCHISM — must match partition.prop
# Total cores allocated: 39 nodes x 128 = 4992
# MPI ranks used (set by YAML via yaml_to_env.py in the J-job):
#   nprocs (total mpiexec -n) = partition.prop compute (4912) + NSCRIBES (8) = 4920
# Do NOT hardcode TOTAL_TASKS / NSCRIBES here — driven by parm/systems/${OFS}.yaml
# (section: resources). If YAML load fails, mpiexec falls back to its default
# and SCHISM will loudly refuse to start via a partition-mismatch abort.

${HOMEnos}/jobs/JNOS_OFS_ENSEMBLE_MEMBER
