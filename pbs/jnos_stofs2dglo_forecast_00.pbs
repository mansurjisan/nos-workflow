#!/bin/bash
#PBS  -N stofs2d_fc_00
#PBS  -A ESTOFS-DEV
#PBS  -q dev
#PBS  -o /lfs/h1/nos/ptmp/mansur.jisan/rpt/stofs_2d_glo/stofs2d_fc_00.out
#PBS  -e /lfs/h1/nos/ptmp/mansur.jisan/rpt/stofs_2d_glo/stofs2d_fc_00.err
#PBS  -l place=vscatter:excl,select=9:ncpus=128:mpiprocs=120
#PBS  -l walltime=06:00:00

# Source version file
PACKAGEROOT=/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages
. ${PACKAGEROOT}/nosofs.v3.7.0/versions/run.ver

# Working directory
RPTDIR=/lfs/h1/nos/ptmp/$LOGNAME/rpt/stofs_2d_glo
WORKDIR=/lfs/h1/nos/ptmp/$LOGNAME/work/stofs_2d_glo
mkdir -p -m 755 $RPTDIR $WORKDIR
cd ${WORKDIR}

# Module setup (ADCIRC needs MPI + NetCDF)
module purge
module load envvar/${envvar_ver:-1.0}
module load intel/${intel_ver:-19.1.3.304}
module load PrgEnv-intel/${PrgEnv_intel_ver:-8.1.0}
module load craype/${craype_ver:-2.7.8}
module load cray-mpich/${cray_mpich_ver:-8.1.7}
module load cray-pals/${cray_pals_ver:-1.0.12}
module load hdf5/${hdf5_ver:-1.10.6}
module load netcdf/${netcdf_ver:-4.7.4}
module load subversion/${subversion_ver:-1.14.0}
module load python/${python_ver:-3.8.6}
module load prod_envir/${prod_envir_ver:-2.0.6}
module load prod_util/${prod_util_ver:-2.0.17}
module load cfp/${cfp_ver:-2.0.4}
module load libjpeg/${libjpeg_ver:-9c}
module load grib_util/${grib_util_ver:-1.2.4}
module load wgrib2/${wgrib2_ver:-2.0.8}
module load nco/${nco_ver:-5.0.6}

module list

# EXPORT list
set +x
export envir=dev
export OFS=stofs_2d_glo
export cyc=00
export NET=stofs
export job=stofs2d_fc_00_$envir
export platform=ptmp

export KEEPDATA=YES
export SENDCOM=NO
export SENDDBN=NO
export SENDSMS=NO

# Unified package root
export nosofs_ver=v3.7.0
export stofs_ver=v2.1.0
export PACKAGEROOT=/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages

# Data and COM paths
export COMROOT=/lfs/h1/nos/ptmp/$LOGNAME/com
export DCOMROOT=/lfs/h1/ops/prod/dcom
export DATAROOT=/lfs/h1/nos/ptmp/$LOGNAME/work/${OFS}

# Input data paths (production WCOSS2)
export COMINgfs=/lfs/h1/ops/prod/com/gfs/${gfs_ver}
export COMINges=${COMINgfs}

# ADCIRC-specific: persistent GES directory
export COMGES=/lfs/h1/nos/estofs/noscrub/$LOGNAME/com/stofs/${stofs_ver}/${OFS}

# ADCIRC execution resources
export NCPU=960
export TOT_NCPU=966
export PPN=120
export NUM_WRITERS=6
export COLDSTART=${COLDSTART:-NO}

################################################
# CALL executable job script here
export pbsid=${PBS_JOBID%%.*}
export job=${job:-$PBS_JOBNAME}
export jobid=${jobid:-$job.$PBS_JOBID}

# YAML configuration
export HOMEnos=${PACKAGEROOT}/nosofs.${nosofs_ver}
export OFS_CONFIG=${HOMEnos}/parm/systems/${OFS}.yaml
export PYTHONPATH=${HOMEnos}/ush/python:${PYTHONPATH:-}

# Submit with dependency on nowcast:
#   NCST_JOB=$(qsub jnos_stofs2dglo_nowcast_00.pbs)
#   qsub -W depend=afterok:${NCST_JOB} jnos_stofs2dglo_forecast_00.pbs

${HOMEnos}/jobs/JNOS_OFS_FORECAST
