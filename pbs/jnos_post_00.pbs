#!/bin/bash
#PBS  -N secofs_ufs_post_00
#PBS  -A ESTOFS-DEV
#PBS  -q dev
#PBS  -o /dev/null
#PBS  -e /dev/null
#PBS  -l select=1:ncpus=8:mpiprocs=8
#PBS  -l place=vscatter
#PBS  -l walltime=01:00:00

# ------------------------------------------------------------------
# SECOFS UFS Post-Processing PBS Job
#
# Generates station NetCDF and field products from SCHISM raw outputs.
# Runs after both nowcast and forecast complete.
#
# Submit via launcher or manually:
#   qsub -v "PDY=20260322,CYC=18,OFS=secofs_ufs" jnos_post_00.pbs
# ------------------------------------------------------------------

PACKAGEROOT=/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages
. ${PACKAGEROOT}/nos-workflow/versions/run.ver

# Working directory
export OFS=${OFS:-secofs_ufs}
RPTDIR=/lfs/h1/nos/ptmp/$LOGNAME/rpt/${OFS}
WORKDIR=/lfs/h1/nos/ptmp/$LOGNAME/work/${OFS}
mkdir -p -m 755 $RPTDIR $WORKDIR

# Per-job log files (PBS jobid as suffix). PBS -o/-e are pointed at
# /dev/null above; this redirect is what populates post logs.
_JOBID=${PBS_JOBID%%.*}
_LOG_PREFIX="$RPTDIR/secofs_ufs_post_00.${_JOBID}"
exec > "${_LOG_PREFIX}.out" 2> "${_LOG_PREFIX}.err"
echo "=== secofs_ufs_post_00 — PBS jobid ${PBS_JOBID} on $(hostname) at $(date) ==="
cd ${WORKDIR}

# Module setup — post-processing only needs Python + NCO, not UFS hpc-stack
module purge
module load envvar/${envvar_ver:-1.0}
module load intel/${intel_ver:-19.1.3.304}
module load PrgEnv-intel/${PrgEnv_intel_ver:-8.1.0}
module load craype/${craype_ver:-2.7.8}
module load cray-mpich/${cray_mpich_ver:-8.1.7}
module load cray-pals/${cray_pals_ver:-1.0.12}
module load hdf5/${hdf5_ver:-1.10.6}
module load netcdf/${netcdf_ver:-4.7.4}
# Python for post comes from the STOFS virtualenv, not the stock module.
# Ops does exactly this in jstofs_3d_atl_post{1,2}_t12z.ecf:
#     #module load python/${python_ver}
#     module unload python
#     module load ve/stofs/${ve_stofs}
# The stock module ships a shapely predating make_valid (1.8), which the
# geopackage product needs and which ops' own gen_geojson.py imports --
# so on the module set, geopkg reports its geometry stack unavailable and
# writes nothing. Pinned when ${ve_stofs} is set, default version otherwise.
module unload python 2>/dev/null || true
module load ve/stofs${ve_stofs:+/${ve_stofs}}
module load prod_envir/${prod_envir_ver:-2.0.6}
module load prod_util/${prod_util_ver:-2.0.17}
module load udunits/${udunits_ver:-2.2.28}
module load gsl/${gsl_ver:-2.7}
module load nco/${nco_ver:-5.0.6}

module list

# Say which interpreter and which optional deps this job actually has.
# Everything downstream shells out to `python3`, so if the virtualenv
# exposed only `python` we would silently fall back to a system python3
# without geopandas/shapely and lose the geometry products with a
# confusing error. Non-fatal: this reports, it does not gate.
echo "post: python3 -> $(command -v python3 || echo NOT FOUND)"
python3 - <<'PYPROBE' || true
import sys
print(f"post: python  {sys.version.split()[0]}  ({sys.executable})")
for m in ("netCDF4", "numpy", "scipy", "geopandas", "shapely"):
    try:
        mod = __import__(m)
        print(f"post:   OK      {m} {getattr(mod, '__version__', '')}")
    except Exception as exc:
        print(f"post:   MISSING {m} ({type(exc).__name__})")
try:
    from shapely.validation import make_valid  # noqa: F401
    print("post:   OK      shapely.validation.make_valid (geopkg usable)")
except Exception as exc:
    print(f"post:   MISSING shapely.validation.make_valid -- geopkg will skip ({exc})")
PYPROBE

# EXPORT list
set +x
export envir=dev
export OFS=${OFS:-secofs_ufs}
export cyc=${CYC:-00}
export PDY=${PDY:-$(date +%Y%m%d)}
export job=secofs_ufs_post_${cyc}_$envir
export platform=ptmp

export KEEPDATA=YES
export SENDCOM=NO
export SENDDBN=NO
export SENDSMS=NO

# nosofs_ver removed: tree is unversioned (was v3.7.0)
# nos_ofs_ver removed (tree unversioned)
export PACKAGEROOT=/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages

# Data and COM paths
export COMPATH=/lfs/h1/ops/prod/com/nos
export COMROOT=/lfs/h1/nos/ptmp/$LOGNAME/com
export DCOMROOT=/lfs/h1/ops/prod/dcom
export DATAROOT=/lfs/h1/nos/ptmp/$LOGNAME/work/${OFS}

################################################
# CALL executable job script here
export pbsid=${PBS_JOBID%%.*}
export job=${job:-$PBS_JOBNAME}
export jobid=${jobid:-$job.$PBS_JOBID}

# YAML configuration for secofs_ufs
export HOMEnos=${PACKAGEROOT}/nos-workflow
export OFS_CONFIG=${HOMEnos}/parm/systems/${OFS}.yaml
export PYTHONPATH=${HOMEnos}/ush/python:${PYTHONPATH:-}

${HOMEnos}/jobs/JNOS_POST
