#!/bin/bash
#PBS  -N stofs_2d_glo_nc_00
#PBS  -A ESTOFS-DEV
#PBS  -q dev
#PBS  -o /dev/null
#PBS  -e /dev/null
#PBS  -l place=vscatter:excl,select=32:ncpus=128:mpiprocs=128:ompthreads=1
#PBS  -l walltime=06:00:00

# STOFS-2D-Global (ADCIRC padcirc v56.1.0) nowcast: 4064 compute ranks on 32 x 128 (ops layout, ecf
# jstofs_2d_glo_tide_ncst). The ops 6 h nowcast takes 15 min; the 6 h walltime covers a COLD first
# cycle (18 d spin-up inside the nowcast). Writer ranks (padcirc -W) come from adcirc.ncpu_writer in
# stofs_2d_glo.yaml; 4064 + writers must stay <= 4096 (32 x 128), checked at launch. Cycles: 00/06/12/18
# (ops runs four a day); the default is 12 like the ATL cards. MJ (10/05/26)

# Ops jobs (stofs.v3.1.5 structure) are these same cards with the mode chosen at submit time. A cycle is four jobs, prep -> nowcast ->
# forecast -> post, which launch_stofs_2d_glo.sh submits with afterok dependencies and the walltimes below (the sums of the former per-job
# walltimes: the ecf values except ncst 0:25, adcprep 3:00 and ncrcat 0:25). Each job runs the steps of its ADCIRC_SEGMENT / ADCIRC_STREAM
# list one after the other (tide, then surf) on its own allocation, here the 32 nodes. qsub -v splits at commas, so the lists are space
# separated and a hand-typed -v value goes in one pair of quotes (without them qsub refuses the stray words). A cold start (adcprep,
# then the spin-up) adds the adcprep step to the prep job and the spinup step to this one; the forecast is one 180 h run (ops fcst1 +
# fcst2 merged). The single-job forms:
#   qsub -l walltime=0:50:00 -l select=1:ncpus=1:prepost=true:mem=400gb -v "PDY=<yyyymmdd>,CYC=<hh>,KEEPDATA=NO,ADCIRC_MODE=ops,ADCIRC_SEGMENT=ncst fcst" jnos_prep_00.pbs
#   qsub -l walltime=0:50:00 -v "PDY=<yyyymmdd>,CYC=<hh>,KEEPDATA=NO,ADCIRC_MODE=ops,ADCIRC_SEGMENT=ncst,ADCIRC_STREAM=tide surf" jnos_nowcast_00.pbs
#   qsub -l walltime=2:00:00 -v "PDY=<yyyymmdd>,CYC=<hh>,KEEPDATA=NO,ADCIRC_MODE=ops,ADCIRC_SEGMENT=fcst,ADCIRC_STREAM=tide surf" jnos_forecast_00.pbs
#   qsub -l walltime=3:10:00 -l select=8:ncpus=32:prepost=true:mem=800gb -l place=vscatter:exclhost -v "PDY=<yyyymmdd>,CYC=<hh>,KEEPDATA=NO,ADCIRC_MODE=ops,ADCIRC_SEGMENT=anomaly bias ncdiff grib2 ncrcat" jnos_prep_00.pbs
# A list is in the order of the examples (spinup ncst; tide surf; anomaly bias ncdiff grib2 ncrcat) and has no repeats, or the job stops
# before its first step. Cold start: prep ADCIRC_SEGMENT=adcprep ncst fcst with -l walltime=3:50:00, nowcast ADCIRC_SEGMENT=spinup ncst with
# 1:50:00 (values go inside the -v "..." quotes like the examples above). The ops run.ver exports COLDSTART=YES into every job, so a cold start is only ever the segment names, never that
# variable. There are no done-markers: redo a failed step by resubmitting its job with a narrower list (ADCIRC_STREAM=surf). MJ (10/14/26)

PACKAGEROOT=${PACKAGEROOT:-/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages}
HOMEnos=${HOMEnos:-${PACKAGEROOT}/nos-workflow}
. ${HOMEnos}/versions/run.ver

# ADCIRC module stack from the ops v3.1.5 version file (adcirc/v56.1.0 etc.); override STOFS_RUNVER
# if your padcirc was built against another stack. MJ (10/05/26)
STOFS_RUNVER=${STOFS_RUNVER:-/lfs/h1/ops/prod/packages/stofs.v3.1.5/versions/run.ver}
# The ops run.ver also sets python_ver=3.12.0, which has no yaml/netCDF4; keep the nos-workflow python. MJ (10/11/26)
_py_ver=${python_ver:-}
[ -r "${STOFS_RUNVER}" ] && . "${STOFS_RUNVER}"
python_ver=${_py_ver}

# Pinned: leaked OFS/RUN values would move the COMOUT layout. MJ (10/05/26)
export OFS=stofs_2d_glo
export NET=nos RUN=stofs_2d_glo PREFIXNOS=stofs_2d_glo
RPTDIR=/lfs/h1/nos/ptmp/$LOGNAME/rpt/${OFS}
WORKDIR=/lfs/h1/nos/ptmp/$LOGNAME/work/${OFS}
mkdir -p -m 755 $RPTDIR $WORKDIR

_JOBID=${PBS_JOBID%%.*}
_LOG_PREFIX="$RPTDIR/stofs_2d_glo_nowcast_00.${_JOBID}"
exec > "${_LOG_PREFIX}.out" 2> "${_LOG_PREFIX}.err"
echo "=== stofs_2d_glo_nowcast_00 -- PBS jobid ${PBS_JOBID} on $(hostname) at $(date) ==="
cd ${WORKDIR}

# MPI efficiency settings (operational parity with the other STOFS cards). MJ (10/05/26)
export MPICH_OFI_STARTUP_CONNECT=1
export MPICH_COLL_SYNC=MPI_Bcast
export MPICH_REDUCE_NO_SMP=1

module purge
module reset
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load hdf5/${hdf5_ver}
module load netcdf/${netcdf_ver}
module load udunits/${udunits_ver}
module load gsl/${gsl_ver}
module load libjpeg/${libjpeg_ver}
# adcirc is not in the default module path on every login; ADCIRC_MODULE_PATH points at its modulefiles. MJ (10/05/26)
[ -z "${ADCIRC_MODULE_PATH:-}" ] || module use ${ADCIRC_MODULE_PATH}
module load adcirc/${adcirc_ver}
module load python/${python_ver:-3.8.6}
module load prod_envir/${prod_envir_ver:-2.0.6}
module load prod_util/${prod_util_ver:-2.0.17}
module list

# EXPORT list MJ (10/05/26)
set +x
export envir=dev
export cyc=${CYC:-12}
export CYC=${cyc}
export PDY=${PDY:?set PDY (YYYYMMDD)}
export job=stofs_2d_glo_nc_00_$envir
export platform=ptmp
export framework=adcirc
export ADCIRC_MODE=${ADCIRC_MODE:-ops}
[ "${ADCIRC_MODE}" = ops ] || { echo "ERROR: ADCIRC_MODE=${ADCIRC_MODE} was removed: STOFS-2D-Global runs ops mode only (unset ADCIRC_MODE or set ADCIRC_MODE=ops)" >&2; exit 2; }  # MJ (10/19/26)

export KEEPDATA=${KEEPDATA:-YES}
export SENDCOM=NO
export SENDDBN=NO
export SENDSMS=NO

export PACKAGEROOT

# Data and COM paths; the shared com is safe, every directory is RUN-prefixed. COMROOT_2DGLO overrides for experiments. MJ (10/13/26)
export COMROOT=${COMROOT_2DGLO:-/lfs/h1/nos/ptmp/$LOGNAME/com}
export DATAROOT=/lfs/h1/nos/ptmp/$LOGNAME/work/${OFS}
export COMINgfs=${COMINgfs:-/lfs/h1/ops/prod/com/gfs/${gfs_ver:-v16.3}}
export EXECnos=${EXECnos:-${HOMEnos}/exec}
# padcirc/adcprep come from the adcirc module on PATH unless ADCIRC_EXEC_DIR points at a private build. MJ (10/05/26)
[ -z "${ADCIRC_EXEC_DIR:-}" ] || export ADCIRC_EXEC_DIR

export pbsid=${PBS_JOBID%%.*}
export job=${job:-$PBS_JOBNAME}
export jobid=${jobid:-$job.$PBS_JOBID}

export HOMEnos
export OFS_CONFIG=${HOMEnos}/parm/systems/stofs_2d_glo.yaml
export PYTHONPATH=${HOMEnos}/ush/python:${PYTHONPATH:-}

# Preflight: fix files and executables, so a missing 1.7 GB mesh fails here and not after the queue wait. MJ (10/05/26)
FIXDIR=${FIXofs:-${HOMEnos}/fix/${OFS}}
for _f in stofs_2d_glo_grid stofs_2d_glo_attr; do
    [ -s "${FIXDIR}/${_f}" ] || { echo "FATAL: ${FIXDIR}/${_f} missing (tools/fetch_stofs_2d_glo_fix.sh)"; exit 1; }
done
if [ -n "${ADCIRC_EXEC_DIR:-}" ]; then _px=${ADCIRC_EXEC_DIR}/padcirc; else _px=$(command -v padcirc || true); fi
[ -n "${_px}" ] && [ -x "${_px}" ] || { echo "FATAL: padcirc not found (module adcirc or ADCIRC_EXEC_DIR)"; exit 1; }
# Allocation size for the launch-time rank check (compute + writers must fit). MJ (10/05/26)
export ADCIRC_ALLOC_RANKS=$(( $(sort -u "${PBS_NODEFILE}" | wc -l) * 128 ))

${HOMEnos}/jobs/JNOS_NOWCAST
# JNOS_* exits 0 even when the stage fails; stop the afterok chain unless the stage logged PASS, as ops does. MJ (10/06/26)
grep -q 'STAGE_SUMMARY .*status=PASS' "${_LOG_PREFIX}.out" || exit 1
