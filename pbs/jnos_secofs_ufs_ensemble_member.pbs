#!/bin/bash
#PBS  -N secofs_ufs_ens_00
#PBS  -A ESTOFS-DEV
#PBS  -q dev
#PBS  -o /lfs/h1/nos/ptmp/mansur.jisan/rpt/secofs_ufs/secofs_ufs_ens_00.out
#PBS  -e /lfs/h1/nos/ptmp/mansur.jisan/rpt/secofs_ufs/secofs_ufs_ens_00.err
#PBS  -l place=vscatter:excl,select=10:ncpus=128:mpiprocs=120
#PBS  -l walltime=05:30:00

# ------------------------------------------------------------------
# SECOFS UFS-Coastal Ensemble Member PBS Job
#
# Runs a single UFS-Coastal ensemble member (DATM+SCHISM coupled).
# Submit via launch_secofs_ufs_ensemble.sh or manually with:
#   qsub -v MEMBER_ID=000,CYC=00,PDY=20260213 \
#        -N secofs_ufs_ens000_00 \
#        -o /lfs/h1/nos/ptmp/$LOGNAME/rpt/secofs_ufs/secofs_ufs_ens000_00.out \
#        -e /lfs/h1/nos/ptmp/$LOGNAME/rpt/secofs_ufs/secofs_ufs_ens000_00.err \
#        jnos_secofs_ufs_ensemble_member.pbs
#
# The launcher script overrides -N, -o, -e per member via qsub flags.
# The #PBS defaults above are fallbacks for direct submission.
# ------------------------------------------------------------------

# Validate required variables
if [ -z "${MEMBER_ID:-}" ]; then
    echo "ERROR: MEMBER_ID not set. Use: qsub -v MEMBER_ID=001,CYC=00,PDY=20260213 $0" >&2
    exit 1
fi
CYC=${CYC:-00}

# PDY: accept from qsub -v, fall back to today
export PDY=${PDY:-$(date +%Y%m%d)}

PACKAGEROOT=/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages
. ${PACKAGEROOT}/nosofs.v3.7.0/versions/run.ver

# Working directory
RPTDIR=/lfs/h1/nos/ptmp/$LOGNAME/rpt/secofs_ufs
WORKDIR=/lfs/h1/nos/ptmp/$LOGNAME/work/${nosofs_ver}/secofs_ufs
mkdir -p -m 755 $RPTDIR $WORKDIR
cd ${WORKDIR}

# ----------------------------------------------------------------
# Module setup: UFS-Coastal hpc-stack libraries
# ----------------------------------------------------------------
# The UFS executable (fv3_coastalS.exe) requires hpc-stack libraries
# (hdf5-D/1.14.0, netcdf-D/4.9.2, esmf-D/8.8.0) that differ from
# standard WCOSS2 system modules (hdf5/1.10.6, netcdf/4.7.4).
module purge
module reset

# Clear version env vars that would override modules.fv3.lua defaults
unset PrgEnv_intel_ver craype_ver cmake_ver g2_ver w3emc_ver 2>/dev/null || true

# Load UFS-Coastal hpc-stack modules
module use ${PACKAGEROOT}/nosofs.${nosofs_ver}/modulefiles
module load modules.fv3
module load cray-pals

# Infrastructure modules for J-job scripting
module load python/${python_ver:-3.8.6}
module load prod_envir/${prod_envir_ver:-2.0.6}
module load prod_util/${prod_util_ver:-2.0.17}

module list

# MPI tuning for large-core SCHISM runs on Cray
export MPICH_OFI_STARTUP_CONNECT=1
export MPICH_COLL_SYNC=MPI_Bcast
export MPICH_REDUCE_NO_SMP=1
export FI_OFI_RXM_SAR_LIMIT=1572864

# EXPORT list
set +x
export envir=dev
export OFS=secofs_ufs
export cyc=${CYC}
export NET=nosofs
export model=nosofs
export MEMBER_ID=${MEMBER_ID}
export job=secofs_ufs_ens${MEMBER_ID}_${CYC}_$envir
export platform=ptmp

# UFS-Coastal DATM coupling
export USE_DATM=true

export KEEPDATA=YES
export SENDCOM=NO
export SENDDBN=NO
export SENDSMS=NO

export nosofs_ver=v3.7.0
export PACKAGEROOT=/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages

# Data and COM paths
export COMPATH=/lfs/h1/ops/prod/com/nos
export COMROOT=/lfs/h1/nos/ptmp/$LOGNAME/com
export DCOMROOT=/lfs/h1/ops/prod/dcom
export DATAROOT=/lfs/h1/nos/ptmp/$LOGNAME/work/${nosofs_ver}/${OFS}
export COMIN=/lfs/h1/ops/prod/com

# Input data paths (production WCOSS2)
export COMINnam=/lfs/h1/ops/prod/com/nam/${nam_ver}
export COMINhrrr=/lfs/h1/ops/prod/com/hrrr/${hrrr_ver}
export COMINrap=/lfs/h1/ops/prod/com/rap/${rap_ver}
export COMINgfs=/lfs/h1/ops/prod/com/gfs/${gfs_ver}
export COMINrtma=/lfs/h1/ops/prod/com/rtma/${rtma_ver}
export COMINetss=/lfs/h1/ops/prod/com/petss/${petss_ver}
export COMINrtofs_2d=/lfs/h1/ops/prod/com/rtofs/${rtofs_ver}
export COMINrtofs_3d=/lfs/h1/ops/prod/com/rtofs/${rtofs_ver}
export COMINnwm=/lfs/h1/ops/prod/com/nwm/${nwm_ver}

# UFS-Coastal: MED+ATM share PETs 0-119, OCN PETs 120-1199
# 10 nodes x 120 mpiprocs = 1200 tasks
export TOTAL_TASKS=1200

################################################
# CALL executable job script here
export pbsid=${PBS_JOBID%%.*}
export job=${job:-$PBS_JOBNAME}
export jobid=${jobid:-$job.$PBS_JOBID}

# YAML configuration for secofs_ufs
export HOMEnos=${PACKAGEROOT}/nosofs.${nosofs_ver}
export OFS_CONFIG=${HOMEnos}/parm/systems/${OFS}.yaml
export PYTHONPATH=${HOMEnos}/ush/python:${PYTHONPATH:-}

# Pass GEFS ensemble flag if set by launcher
export GEFS_ENSEMBLE=${GEFS_ENSEMBLE:-false}
export GEFS_MEMBER_ID=${GEFS_MEMBER_ID:-}

${HOMEnos}/jobs/JNOS_OFS_ENSEMBLE_MEMBER
