#!/bin/bash
#PBS  -N secofs_2d_ufs_ens_MID
#PBS  -A ESTOFS-DEV
#PBS  -q dev
#PBS  -o /lfs/h1/nos/ptmp/mansur.jisan/rpt/secofs_2d_ufs/secofs_2d_ufs_ens_MID.out
#PBS  -e /lfs/h1/nos/ptmp/mansur.jisan/rpt/secofs_2d_ufs/secofs_2d_ufs_ens_MID.err
#PBS  -l place=vscatter:excl,select=5:ncpus=128:mpiprocs=112
#PBS  -l walltime=01:00:00

# ------------------------------------------------------------------
# SECOFS 2D Barotropic UFS-Coastal Ensemble Member PBS Job
#
# Runs a single 2D barotropic ensemble member using DATM+SCHISM
# coupling. 560 total MPI tasks (60 DATM + 500 SCHISM).
# Much faster than 3D (no tracer transport, 2 vertical levels).
#
# Submit via launch_secofs_2d_ufs_ensemble.sh or manually:
#   qsub -v MEMBER_ID=001,CYC=00,PDY=20260313,OFS=secofs_2d_ufs,BAROTROPIC=true,ATMOS_ENSEMBLE=true,GEFS_ENSEMBLE=true,GEFS_MEMBER_ID=01 \
#        -N secofs_2d_ufs_ens001_00 \
#        jnos_secofs_2d_ufs_ensemble_member.pbs
#
# The launcher script overrides -N, -o, -e per member via qsub flags.
# The #PBS defaults above are fallbacks for direct submission.
# ------------------------------------------------------------------

# Validate required variables
if [ -z "${MEMBER_ID:-}" ]; then
    echo "ERROR: MEMBER_ID not set. Use: qsub -v MEMBER_ID=001,CYC=00,PDY=20260313,OFS=secofs_2d_ufs $0" >&2
    exit 1
fi
CYC=${CYC:-00}

# PDY: accept from qsub -v, fall back to today
export PDY=${PDY:-$(date +%Y%m%d)}

PACKAGEROOT=/lfs/h1/nos/estofs/noscrub/$LOGNAME/packages
. ${PACKAGEROOT}/nosofs.v3.7.0/versions/run.ver

# OFS: accept from launcher (default: secofs_2d_ufs)
export OFS=${OFS:-secofs_2d_ufs}

# Working directory
RPTDIR=/lfs/h1/nos/ptmp/$LOGNAME/rpt/${OFS}
WORKDIR=/lfs/h1/nos/ptmp/$LOGNAME/work/${nosofs_ver}/${OFS}
if [ ! -r $WORKDIR ]; then
  mkdir -p -m 755 $WORKDIR
fi
cd ${WORKDIR}

# ----------------------------------------------------------------
# Module setup: UFS-Coastal hpc-stack libraries
# (hdf5-D/1.14.0, netcdf-D/4.9.2, esmf-D/8.8.0)
# Save PACKAGEROOT before module loads (prod_envir overrides it)
# ----------------------------------------------------------------
_SAVED_PACKAGEROOT=${PACKAGEROOT}

module purge
module reset
unset PrgEnv_intel_ver craype_ver cmake_ver g2_ver w3emc_ver 2>/dev/null || true
module use ${PACKAGEROOT}/nosofs.${nosofs_ver}/modulefiles
module load modules.fv3
module load cray-pals
module load python/${python_ver:-3.8.6}
module load prod_envir/${prod_envir_ver:-2.0.6}
module load prod_util/${prod_util_ver:-2.0.17}

module list

# Restore PACKAGEROOT (prod_envir sets it to /lfs/h1/ops/prod/packages)
PACKAGEROOT=${_SAVED_PACKAGEROOT}
unset _SAVED_PACKAGEROOT

# MPI tuning for SCHISM runs on Cray
export MPICH_OFI_STARTUP_CONNECT=1
export MPICH_COLL_SYNC=MPI_Bcast
export MPICH_REDUCE_NO_SMP=1
export FI_OFI_RXM_SAR_LIMIT=1572864

# EXPORT list
set +x
export envir=dev
export cyc=${CYC}
export NET=nosofs
export model=nosofs
export MEMBER_ID=${MEMBER_ID}
export job=${OFS}_ens${MEMBER_ID}_${CYC}_$envir
export platform=ptmp

# Barotropic mode (2 vertical levels, no tracer transport)
export BAROTROPIC=true

# UFS-Coastal DATM coupling
export USE_DATM=${USE_DATM:-true}
# 5 nodes x 112 mpiprocs = 560 tasks (60 DATM + 500 SCHISM)
export TOTAL_TASKS=${TOTAL_TASKS:-560}

# Atmospheric ensemble flags
export ATMOS_ENSEMBLE=${ATMOS_ENSEMBLE:-true}

export KEEPDATA=YES
export SENDCOM=NO
export SENDDBN=NO
export SENDSMS=NO

export PACKAGEROOT
export COMPATH=/lfs/h1/ops/prod/com/nos
export com_ver=v3.7
export COMROOT=/lfs/h1/nos/ptmp/$LOGNAME/com
export DCOMROOT=/lfs/h1/ops/prod/dcom
export DATAROOT=/lfs/h1/nos/ptmp/$LOGNAME/work/${nosofs_ver}/${OFS}
export COMINnam=/lfs/h1/ops/prod/com/nam/${nam_ver}
export COMINhrrr=/lfs/h1/ops/prod/com/hrrr/${hrrr_ver}
export COMINrap=/lfs/h1/ops/prod/com/rap/${rap_ver}
export COMINgfs=/lfs/h1/ops/prod/com/gfs/${gfs_ver}
export COMINrtma=/lfs/h1/ops/prod/com/rtma/${rtma_ver}
export COMINetss=/lfs/h1/ops/prod/com/petss/${petss_ver}
export COMINrtofs_2d=/lfs/h1/ops/prod/com/rtofs/${rtofs_ver}
export COMINrtofs_3d=/lfs/h1/ops/prod/com/rtofs/${rtofs_ver}
export COMINnwm=/lfs/h1/ops/prod/com/nwm/${nwm_ver}
export COMIN=/lfs/h1/ops/prod/com

# Pass GEFS ensemble flags from launcher
export GEFS_ENSEMBLE=${GEFS_ENSEMBLE:-true}
export GEFS_MEMBER_ID=${GEFS_MEMBER_ID:-}

################################################
# CALL executable job script here
export pbsid=${PBS_JOBID%%.*}
export job=${job:-$PBS_JOBNAME}
export jobid=${jobid:-$job.$PBS_JOBID}

export HOMEnos=${PACKAGEROOT}/nosofs.${nosofs_ver}
export OFS_CONFIG=${HOMEnos}/parm/systems/${OFS}.yaml
export PYTHONPATH=${HOMEnos}/ush/python:${PYTHONPATH:-}

${HOMEnos}/jobs/JNOS_OFS_ENSEMBLE_MEMBER
