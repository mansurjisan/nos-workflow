# NOS-OFS Container with Intel Compilers
# NOAA Operational Ocean Forecast Systems - Fortran Executables
# Uses Intel oneAPI HPC Toolkit for Fortran compilation
#
# Build from repository root:
#   docker build -f containers/Dockerfile.nos-ofs-intel -t nos-ofs-intel .

FROM rockylinux/rockylinux:9

LABEL maintainer="Mansur Ali Jisan <mansur.jisan@noaa.gov>"
LABEL description="NOS-OFS Fortran executables built with Intel compilers"
LABEL version="1.0.0"

# Environment variables
ENV PROJ_VERSION=9.3.1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# ============================================================
# SYSTEM PACKAGES
# ============================================================
RUN dnf update -y && \
    dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm && \
    /usr/bin/crb enable && \
    dnf install -y --nobest \
        which gcc gcc-c++ gcc-gfortran make cmake git \
        openmpi openmpi-devel \
        netcdf netcdf-fortran netcdf-devel netcdf-fortran-devel \
        hdf5 hdf5-devel \
        python3 python3-pip python3-devel \
        wget hostname zlib-devel diffutils \
        jasper jasper-devel udunits2 nco \
        libjpeg-turbo libjpeg-turbo-devel \
        libpng libpng-devel blas-devel lapack-devel openblas-devel bzip2-devel \
        sqlite-devel libtiff-devel libcurl-devel \
        libwebp-devel libzstd-devel jbigkit-devel && \
    dnf clean all

# ============================================================
# INSTALL INTEL oneAPI COMPILERS
# ============================================================
RUN cat > /etc/yum.repos.d/oneAPI.repo << 'EOF'
[oneAPI]
name=Intel oneAPI repository
baseurl=https://yum.repos.intel.com/oneapi
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://yum.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB
EOF

# Install Intel Fortran and C compilers
RUN dnf install -y intel-oneapi-compiler-fortran intel-oneapi-compiler-dpcpp-cpp && \
    dnf clean all

# Create library symlinks
RUN ln -sf /usr/lib64/libjasper.so.4 /usr/lib64/libjasper.so || true && \
    ln -sf /usr/lib64/libpng16.so.16 /usr/lib64/libpng.so || true

# ============================================================
# SETUP INTEL COMPILER ENVIRONMENT
# ============================================================
SHELL ["/bin/bash", "-c"]

# ============================================================
# BUILD PROJ FROM SOURCE
# ============================================================
RUN cd /tmp && \
    wget https://download.osgeo.org/proj/proj-${PROJ_VERSION}.tar.gz && \
    tar -xzf proj-${PROJ_VERSION}.tar.gz && \
    cd proj-${PROJ_VERSION} && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && \
    make install && \
    cd /tmp && rm -rf proj-${PROJ_VERSION}*

# ============================================================
# BUILD NCEP LIBRARIES WITH INTEL COMPILERS
# ============================================================
WORKDIR /tmp

# Set Intel compiler environment for NCEP builds
ENV ONEAPI_ROOT=/opt/intel/oneapi
ENV NCEP_PREFIX=/opt/ncep

# BACIO - with Intel compilers
RUN source ${ONEAPI_ROOT}/setvars.sh && \
    git clone --depth 1 https://github.com/NOAA-EMC/NCEPLIBS-bacio.git && \
    cd NCEPLIBS-bacio && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=${NCEP_PREFIX} \
        -DCMAKE_Fortran_COMPILER=ifx -DBUILD_TESTING=OFF && \
    make -j$(nproc) && make install && \
    cd /tmp && rm -rf NCEPLIBS-bacio

# W3EMC - with Intel compilers
RUN source ${ONEAPI_ROOT}/setvars.sh && \
    git clone --depth 1 https://github.com/NOAA-EMC/NCEPLIBS-w3emc.git && \
    cd NCEPLIBS-w3emc && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=${NCEP_PREFIX} \
        -DCMAKE_Fortran_COMPILER=ifx -DBUILD_TESTING=OFF -DCMAKE_PREFIX_PATH=${NCEP_PREFIX} && \
    make -j$(nproc) && make install && \
    cd /tmp && rm -rf NCEPLIBS-w3emc

# W3NCO - with Intel compilers
RUN source ${ONEAPI_ROOT}/setvars.sh && \
    git clone --depth 1 https://github.com/NOAA-EMC/NCEPLIBS-w3nco.git && \
    cd NCEPLIBS-w3nco && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=${NCEP_PREFIX} \
        -DCMAKE_Fortran_COMPILER=ifx -DBUILD_TESTING=OFF -DCMAKE_PREFIX_PATH=${NCEP_PREFIX} && \
    make -j$(nproc) && make install && \
    cd /tmp && rm -rf NCEPLIBS-w3nco

# G2C - with Intel compilers (C library, use icx)
RUN source ${ONEAPI_ROOT}/setvars.sh && \
    git clone --depth 1 https://github.com/NOAA-EMC/NCEPLIBS-g2c.git && \
    cd NCEPLIBS-g2c && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=${NCEP_PREFIX} \
        -DCMAKE_C_COMPILER=icx -DBUILD_TESTING=OFF -DCMAKE_PREFIX_PATH=${NCEP_PREFIX} && \
    make -j$(nproc) && make install && \
    cd /tmp && rm -rf NCEPLIBS-g2c

# SP - with Intel compilers
RUN source ${ONEAPI_ROOT}/setvars.sh && \
    git clone --depth 1 https://github.com/NOAA-EMC/NCEPLIBS-sp.git && \
    cd NCEPLIBS-sp && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=${NCEP_PREFIX} \
        -DCMAKE_Fortran_COMPILER=ifx -DBUILD_TESTING=OFF -DCMAKE_PREFIX_PATH=${NCEP_PREFIX} && \
    make -j$(nproc) && make install && \
    cd /tmp && rm -rf NCEPLIBS-sp

# IP - with Intel compilers
RUN source ${ONEAPI_ROOT}/setvars.sh && \
    git clone --depth 1 https://github.com/NOAA-EMC/NCEPLIBS-ip.git && \
    cd NCEPLIBS-ip && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=${NCEP_PREFIX} \
        -DCMAKE_Fortran_COMPILER=ifx -DBUILD_TESTING=OFF -DCMAKE_PREFIX_PATH=${NCEP_PREFIX} && \
    make -j$(nproc) && make install && \
    cd /tmp && rm -rf NCEPLIBS-ip

# G2 - with Intel compilers
RUN source ${ONEAPI_ROOT}/setvars.sh && \
    git clone --depth 1 https://github.com/NOAA-EMC/NCEPLIBS-g2.git && \
    cd NCEPLIBS-g2 && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=${NCEP_PREFIX} \
        -DCMAKE_Fortran_COMPILER=ifx -DCMAKE_C_COMPILER=icx \
        -DBUILD_TESTING=OFF -DCMAKE_PREFIX_PATH=${NCEP_PREFIX} && \
    make -j$(nproc) && make install && \
    cd /tmp && rm -rf NCEPLIBS-g2

# BUFR - with Intel compilers
RUN source ${ONEAPI_ROOT}/setvars.sh && \
    git clone --depth 1 https://github.com/NOAA-EMC/NCEPLIBS-bufr.git && \
    cd NCEPLIBS-bufr && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=${NCEP_PREFIX} \
        -DCMAKE_Fortran_COMPILER=ifx -DCMAKE_C_COMPILER=icx \
        -DBUILD_TESTING=OFF -DCMAKE_PREFIX_PATH=${NCEP_PREFIX} && \
    make -j$(nproc) && make install && \
    cd /tmp && rm -rf NCEPLIBS-bufr

RUN chmod -R a+rx /opt/ncep/bin

# ============================================================
# BUILD WGRIB2 (uses GNU compilers - compatible with Intel runtime)
# ============================================================
RUN cd /tmp && \
    wget https://www.ftp.cpc.ncep.noaa.gov/wd51we/wgrib2/wgrib2.tgz && \
    tar -xzf wgrib2.tgz && \
    cd grib2 && \
    export CC=gcc && \
    export FC=gfortran && \
    export TAR_OPTIONS="--no-same-owner" && \
    make && \
    mkdir -p /opt/wgrib2/bin && \
    cp wgrib2/wgrib2 /opt/wgrib2/bin/ && \
    cd /tmp && rm -rf wgrib2.tgz grib2 && \
    ln -s /opt/wgrib2/bin/wgrib2 /usr/local/bin/wgrib2

# ============================================================
# COPY AND BUILD NOS-OFS FORTRAN EXECUTABLES
# ============================================================
COPY sorc/nos_ofs/ /opt/nosofs/sorc/

# Set environment for NOS-OFS builds
ENV LIBnos=/opt/nosofs/lib
ENV EXECnos=/opt/nosofs/exec
ENV NETCDF=/usr
ENV COMP_F=ifx
ENV COMP_CC=icx
ENV G2_INC4=/opt/ncep/include_4
ENV G2_LIB4="/opt/ncep/lib64/libg2_4.a /opt/ncep/lib64/libg2c.a"
ENV W3NCO_LIB4=/opt/ncep/lib/libw3nco_4.a
ENV W3EMC_LIB4=/opt/ncep/lib64/libw3emc_4.a
ENV BACIO_LIB4=/opt/ncep/lib64/libbacio.a
ENV BUFR_LIB4=/opt/ncep/lib64/libbufr_4.a
ENV JASPER_LIB="-L/usr/lib64 -ljasper"
ENV PNG_LIB="-L/usr/lib64 -lpng"
ENV Z_LIB="-L/usr/lib64 -lz"
ENV Z_LIB4="-L/usr/lib64 -lz"

# Create directories
RUN mkdir -p ${LIBnos} ${EXECnos}

# Build NOS utility library first (other executables depend on it)
RUN source ${ONEAPI_ROOT}/setvars.sh && \
    cd /opt/nosofs/sorc/nos_ofs_utility.fd && \
    make clean || true && \
    make && \
    make install

# Build all NOS-OFS Fortran executables
RUN source ${ONEAPI_ROOT}/setvars.sh && \
    for dir in /opt/nosofs/sorc/*.fd; do \
        if [ -d "$dir" ] && [ "$dir" != "/opt/nosofs/sorc/nos_ofs_utility.fd" ]; then \
            echo "Building $(basename $dir)..." && \
            cd "$dir" && \
            make clean || true && \
            make && \
            make install || echo "Warning: install failed for $(basename $dir)"; \
        fi \
    done

# ============================================================
# PYTHON PACKAGES
# ============================================================
RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir \
        numpy xarray pyyaml matplotlib cartopy netCDF4 \
        scipy pandas pyproj shapely cftime \
        pytest pytz more-itertools termcolor \
        geopy attrs schema

# ============================================================
# ENVIRONMENT SETUP
# ============================================================
ENV PATH="${EXECnos}:/opt/ncep/bin:/opt/wgrib2/bin:/usr/lib64/openmpi/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/ncep/lib:/opt/ncep/lib64:/usr/lib64/openmpi/lib"

# Script to source Intel environment on container start
RUN echo 'source /opt/intel/oneapi/setvars.sh --force 2>/dev/null' >> /etc/profile.d/intel.sh

# Create non-root user
RUN useradd --create-home --shell /bin/bash nosuser
USER nosuser
WORKDIR /home/nosuser

CMD ["/bin/bash"]
