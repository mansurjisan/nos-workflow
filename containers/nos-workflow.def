Bootstrap: docker
From: rockylinux/rockylinux:9

%labels
    Author mansurjisan
    Description NOS Workflow Container (STOFS 3D Atlantic) - Singularity conversion
    Version 1.0
    Source https://github.com/mansurjisan/nos-workflow

%post
    # ============================================================
    # ENVIRONMENT VARIABLES FOR BUILD
    # ============================================================
    export SLURM_VERSION=slurm-24-11-1-1
    export ECFLOW_VERSION=5.6.0
    export ADCIRC_VERSION=56.0.3
    export SCHISM_VERSION=5.11.0
    export PROJ_VERSION=9.3.1
    export WGRIB2_VERSION=2.0.8
    export GOSU_VERSION=1.17

    # ============================================================
    # SYSTEM PACKAGES
    # ============================================================
    dnf update -y
    dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm
    /usr/bin/crb enable

    dnf install -y --nobest \
        which gcc gcc-c++ gcc-gfortran make cmake git \
        openmpi openmpi-devel \
        boost-devel boost-system boost-filesystem boost-timer boost-date-time boost-program-options boost-chrono boost-python3 \
        netcdf netcdf-fortran netcdf-devel netcdf-fortran-devel \
        libtool ncurses-devel expat-devel openssl-devel python3-devel \
        automake wget hostname zlib-devel \
        jasper jasper-devel udunits2 nco ImageMagick \
        bzip2 gnupg munge munge-devel psmisc bash-completion json-c http-parser \
        mysql mysql-server mysql-devel libjpeg-turbo libjpeg-turbo-devel \
        sqlite-devel libtiff-devel libcurl-devel libwebp-devel jbigkit-devel \
        libpng libpng-devel blas-devel lapack-devel openblas-devel bzip2-devel \
        environment-modules emacs sudo perl

    # ============================================================
    # CLONE NOS-WORKFLOW REPOSITORY
    # ============================================================
    cd /tmp
    rm -rf nos-workflow-repo
    git clone --depth 1 https://github.com/mansurjisan/nos-workflow.git nos-workflow-repo

    # ============================================================
    # BUILD PROJ FROM SOURCE
    # ============================================================
    cd /tmp
    wget https://download.osgeo.org/proj/proj-${PROJ_VERSION}.tar.gz
    tar -xzf proj-${PROJ_VERSION}.tar.gz
    cd proj-${PROJ_VERSION}
    rm -rf build && mkdir build && cd build
    cmake .. -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release
    make -j2
    make install
    cd /tmp && rm -rf proj-${PROJ_VERSION}*

    # Create library symlinks
    ln -sf /usr/lib64/libjasper.so.4 /usr/lib64/libjasper.so || true
    ln -sf /usr/lib64/libpng16.so.16 /usr/lib64/libpng.so || true

    # ============================================================
    # PYTHON PACKAGES
    # ============================================================
    # Upgrade numpy first to avoid version conflicts with system numpy
    pip install --upgrade --ignore-installed numpy
    pip install xarray pyyaml matplotlib cartopy netCDF4 pyshp more-itertools \
                pytest pytz scikit-learn dateutils pyparsing cftime termcolor \
                shapely pandas pluggy geopy attrs pyproj cython schema

    # ============================================================
    # BUILD SLURM
    # ============================================================
    cd /tmp
    git clone -b ${SLURM_VERSION} --single-branch --depth=1 https://github.com/SchedMD/slurm.git
    cd slurm
    ./configure --prefix=/opt/slurm --sysconfdir=/opt/slurm/etc \
        --with-mysql_config=/usr/bin --libdir=/opt/slurm/lib64 \
        --enable-cgroupv2=no
    make -j2
    make install
    install -D -m644 etc/cgroup.conf.example /opt/slurm/etc/cgroup.conf.example
    install -D -m644 etc/slurm.conf.example /opt/slurm/etc/slurm.conf.example
    install -D -m644 etc/slurmdbd.conf.example /opt/slurm/etc/slurmdbd.conf.example
    install -D -m644 contribs/slurm_completion_help/slurm_completion.sh /etc/profile.d/slurm_completion.sh
    cd /tmp && rm -rf slurm

    # Create slurm user and directories
    groupadd -r --gid=990 slurm || true
    useradd -r -g slurm --uid=990 slurm || true
    mkdir -p /etc/sysconfig/slurm /var/spool/slurmd /var/run/slurmd \
             /var/run/slurmdbd /var/lib/slurmd /var/log/slurm /data
    touch /var/lib/slurmd/node_state /var/lib/slurmd/front_end_state \
          /var/lib/slurmd/job_state /var/lib/slurmd/resv_state \
          /var/lib/slurmd/trigger_state /var/lib/slurmd/assoc_mgr_state \
          /var/lib/slurmd/assoc_usage /var/lib/slurmd/qos_usage \
          /var/lib/slurmd/fed_mgr_state
    chown -R slurm:slurm /var/*/slurm* || true
    chown -R munge:munge /run/munge || true
    chmod go-rw /run/munge || true

    # Copy SLURM config files from cloned repo
    cp /tmp/nos-workflow-repo/containers/slurm.conf /opt/slurm/etc/slurm.conf
    cp /tmp/nos-workflow-repo/containers/cgroup.conf /opt/slurm/etc/cgroup.conf
    cp /tmp/nos-workflow-repo/containers/slurmdbd.conf /opt/slurm/etc/slurmdbd.conf
    cp /tmp/nos-workflow-repo/containers/get_slurm_node.py /opt/slurm/etc/get_slurm_node.py

    # ============================================================
    # BUILD ECFLOW
    # ============================================================
    rm -rf /tmp/ecflow_build
    mkdir -p /tmp/ecflow_build
    cd /tmp/ecflow_build
    wget -O ecflow.tar.gz "https://confluence.ecmwf.int/download/attachments/8650755/ecFlow-${ECFLOW_VERSION}-Source.tar.gz?api=v2"
    tar -xvf ecflow.tar.gz
    rm ecflow.tar.gz
    mv ecFlow* ecflow
    rm -rf /tmp/ecflow_build/ecflow/build
    mkdir -p /tmp/ecflow_build/ecflow/build
    cd /tmp/ecflow_build/ecflow/build
    cmake .. -DENABLE_UI=OFF \
        -DBoost_ROOT=/usr \
        -DENABLE_TESTS=OFF \
        -DENABLE_STATIC_BOOST_LIBS=OFF \
        -DCMAKE_INSTALL_PREFIX=/opt/ecflow
    make -j1
    make install
    cd /tmp && rm -rf ecflow_build

    # Copy netcdf module for cmake
    cp /usr/lib64/gfortran/modules/netcdf.mod /usr/include/netcdf.mod || true

    # ============================================================
    # BUILD ADCIRC
    # ============================================================
    cd /tmp
    rm -rf /tmp/adcirc /tmp/adcirc_build
    git clone --depth 1 --branch v${ADCIRC_VERSION} https://github.com/adcirc/adcirc
    mkdir -p /tmp/adcirc_build
    cd /tmp/adcirc_build
    export PATH=$PATH:/usr/lib64/openmpi/bin
    export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/lib64
    cmake ../adcirc -DCMAKE_INSTALL_PREFIX=/opt/models/adcirc \
        -DENABLE_OUTPUT_NETCDF=ON \
        -DBUILD_ADCIRC=ON \
        -DBUILD_ADCPREP=ON \
        -DBUILD_PADCIRC=ON \
        -DNETCDFHOME=/usr \
        -DENABLE_GRIB2=ON \
        -DENABLE_DATETIME=ON
    make -j2 && make install
    cd /tmp && rm -rf adcirc adcirc_build

    # ============================================================
    # BUILD SCHISM
    # ============================================================
    [ -e /usr/bin/python ] || ln -s /usr/bin/python3 /usr/bin/python
    cd /tmp
    rm -rf /tmp/schism /tmp/schism_build
    git clone --depth 1 --branch v${SCHISM_VERSION} https://github.com/schism-dev/schism
    mkdir -p /tmp/schism_build
    cd /tmp/schism_build
    export PATH=$PATH:/usr/lib64/openmpi/bin
    export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/lib64
    cmake ../schism/src -DCMAKE_INSTALL_PREFIX=/opt/models/schism -DBLD_STANDALONE=ON
    make -j2
    mkdir -p /opt/models/schism && mv bin /opt/models/schism/bin
    cd /tmp && rm -rf schism schism_build

    # ============================================================
    # BUILD NCEP LIBRARIES
    # ============================================================
    cd /tmp

    # BACIO
    rm -rf NCEPLIBS-bacio
    git clone --depth 1 https://github.com/NOAA-EMC/NCEPLIBS-bacio.git
    cd NCEPLIBS-bacio && rm -rf build && mkdir build && cd build
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/ncep -DBUILD_TESTING=OFF
    make -j2 && make install
    cd /tmp && rm -rf NCEPLIBS-bacio

    # W3EMC
    rm -rf NCEPLIBS-w3emc
    git clone --depth 1 https://github.com/NOAA-EMC/NCEPLIBS-w3emc.git
    cd NCEPLIBS-w3emc && rm -rf build && mkdir build && cd build
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/ncep -DBUILD_TESTING=OFF -DCMAKE_PREFIX_PATH=/opt/ncep
    make -j2 && make install
    cd /tmp && rm -rf NCEPLIBS-w3emc

    # W3NCO
    rm -rf NCEPLIBS-w3nco
    git clone --depth 1 https://github.com/NOAA-EMC/NCEPLIBS-w3nco.git
    cd NCEPLIBS-w3nco && rm -rf build && mkdir build && cd build
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/ncep -DBUILD_TESTING=OFF -DCMAKE_PREFIX_PATH=/opt/ncep
    make -j2 && make install
    cd /tmp && rm -rf NCEPLIBS-w3nco

    # PROD_UTIL
    rm -rf NCEPLIBS-prod_util
    git clone --depth 1 https://github.com/NOAA-EMC/NCEPLIBS-prod_util.git
    cd NCEPLIBS-prod_util && rm -rf build && mkdir build && cd build
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/ncep -DBUILD_TESTING=OFF -DCMAKE_PREFIX_PATH=/opt/ncep
    make -j2 && make install
    cd /tmp && rm -rf NCEPLIBS-prod_util

    # IP
    rm -rf NCEPLIBS-ip
    git clone --depth 1 https://github.com/NOAA-EMC/NCEPLIBS-ip.git
    cd NCEPLIBS-ip && rm -rf build && mkdir build && cd build
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/ncep -DBUILD_TESTING=OFF -DCMAKE_PREFIX_PATH=/opt/ncep
    make -j2 && make install
    cd /tmp && rm -rf NCEPLIBS-ip

    # G2C
    rm -rf NCEPLIBS-g2c
    git clone --depth 1 https://github.com/NOAA-EMC/NCEPLIBS-g2c.git
    cd NCEPLIBS-g2c && rm -rf build && mkdir build && cd build
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/ncep -DBUILD_TESTING=OFF -DCMAKE_PREFIX_PATH=/opt/ncep
    make -j2 && make install
    cd /tmp && rm -rf NCEPLIBS-g2c

    # G2
    rm -rf NCEPLIBS-g2
    git clone --depth 1 https://github.com/NOAA-EMC/NCEPLIBS-g2.git
    cd NCEPLIBS-g2 && rm -rf build && mkdir build && cd build
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/ncep -DBUILD_TESTING=OFF -DCMAKE_PREFIX_PATH=/opt/ncep
    make -j2 && make install
    cd /tmp && rm -rf NCEPLIBS-g2

    # BUFR
    rm -rf NCEPLIBS-bufr
    git clone --depth 1 https://github.com/NOAA-EMC/NCEPLIBS-bufr.git
    cd NCEPLIBS-bufr && rm -rf build && mkdir build && cd build
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/ncep -DBUILD_TESTING=OFF -DCMAKE_PREFIX_PATH=/opt/ncep
    make -j2 && make install
    cd /tmp && rm -rf NCEPLIBS-bufr

    chmod -R a+rx /opt/ncep/bin

    # ============================================================
    # BUILD WGRIB2
    # ============================================================
    cd /tmp
    wget https://www.ftp.cpc.ncep.noaa.gov/wd51we/wgrib2/wgrib2.tgz
    tar -xzf wgrib2.tgz
    cd grib2
    export CC=gcc
    export FC=gfortran
    export TAR_OPTIONS="--no-same-owner"
    make -j2
    mkdir -p /opt/wgrib2/bin
    cp wgrib2/wgrib2 /opt/wgrib2/bin/
    cd /tmp && rm -rf wgrib2.tgz grib2
    ln -s /opt/wgrib2/bin/wgrib2 /usr/local/bin/wgrib2

    # ============================================================
    # BUILD STOFS UTILITIES
    # ============================================================
    mkdir -p /opt/stofs/exec
    export PATH=$PATH:/usr/lib64/openmpi/bin
    export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/lib64

    # stofs_3d_atl_tide_fac
    cd /tmp/nos-workflow-repo/sorc/stofs_3d_atl_tide_fac.fd
    make clean || true
    make
    cp -p stofs_3d_atl_tide_fac /opt/stofs/exec/
    make clean || true

    # stofs_3d_atl_netcdf2shef
    cd /tmp/nos-workflow-repo/sorc/stofs_3d_atl_netcdf2shef.fd
    make clean || true
    make
    cp -p stofs_3d_atl_netcdf2shef /opt/stofs/exec/
    make clean || true

    # stofs_3d_atl_gen_3Dth_from_hycom
    cd /tmp/nos-workflow-repo/sorc/stofs_3d_atl_gen_3Dth_from_hycom.fd
    make clean || true
    make
    cp -p stofs_3d_atl_gen_3Dth_from_hycom /opt/stofs/exec/
    make clean || true

    # stofs_3d_atl_gen_nudge_from_hycom
    cd /tmp/nos-workflow-repo/sorc/stofs_3d_atl_gen_nudge_from_hycom.fd
    make clean || true
    make
    cp -p stofs_3d_atl_gen_nudge_from_hycom /opt/stofs/exec/
    make clean || true

    # ============================================================
    # INSTALL CFP AND MPI WRAPPER
    # ============================================================
    bash /tmp/nos-workflow-repo/containers/install-cfp.sh
    bash /tmp/nos-workflow-repo/containers/install-mpi-wrapper.sh

    # ============================================================
    # CREATE WCOSS2 USER AND DIRECTORIES
    # ============================================================
    useradd -m wcoss2 || true
    chown wcoss2:wcoss2 /home/wcoss2 || true
    echo "wcoss2 ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/wcoss2
    chmod 0440 /etc/sudoers.d/wcoss2

    # Create directory structure
    mkdir -p /home/wcoss2/stofs_workflow
    mkdir -p /home/wcoss2/data
    mkdir -p /home/wcoss2/sandbox/stofs3d/scripts/stofs_3d_atl
    mkdir -p /home/wcoss2/sandbox/stofs3d/ush/stofs_3d_atl/pysh
    mkdir -p /home/wcoss2/sandbox/stofs3d/fix/stofs_3d_atl
    mkdir -p /home/wcoss2/sandbox/stofs3d/exec/stofs_3d_atl
    mkdir -p /home/wcoss2/sandbox/stofs3d/dataroot/stofs_3d_atl_run_12_prod_v2.1/outputs
    mkdir -p /home/wcoss2/sandbox/stofs3d/versions
    mkdir -p /home/wcoss2/sandbox/stofs3d/prev
    mkdir -p /home/wcoss2/sandbox/stofs3d/rerun
    mkdir -p /home/wcoss2/sandbox/date
    mkdir -p /home/wcoss2/dcom_root
    mkdir -p /lfs/h1/ops/prod/com/nwm/v3.0
    mkdir -p /lfs/h1/ops/prod/com
    mkdir -p /lfs/h1/ops/prod/dcom
    mkdir -p /lfs/h1/ops/prod/config
    mkdir -p /lfs/h1/gfs/v16.3
    mkdir -p /lfs/h1/hrrr/v4.1
    mkdir -p /lfs/h1/nwm/v3.0
    mkdir -p /lfs/h1/rtofs/v2.4

    # ============================================================
    # INSTALL STOFS WORKFLOW
    # ============================================================
    cp -r /tmp/nos-workflow-repo/src /home/wcoss2/stofs_workflow/src
    cp /tmp/nos-workflow-repo/pyproject.toml /home/wcoss2/stofs_workflow/pyproject.toml
    cp -r /tmp/nos-workflow-repo/examples/stofs_scripts /home/wcoss2/data/stofs_scripts
    cp /tmp/nos-workflow-repo/examples/config_adcirc.yaml /home/wcoss2/config_adcirc.yaml
    cp /tmp/nos-workflow-repo/examples/config_schism.yaml /home/wcoss2/config_schism.yaml
    pip install /home/wcoss2/stofs_workflow
    rm -rf /home/wcoss2/stofs_workflow
    chmod -R ugo+x /home/wcoss2/data/stofs_scripts/stofs_3d_atl || true

    # Copy ush files
    cp -r /tmp/nos-workflow-repo/ush/stofs_3d_atl/* /home/wcoss2/sandbox/stofs3d/ush/stofs_3d_atl/ || true
    chmod -R +x /home/wcoss2/sandbox/stofs3d/ush/stofs_3d_atl/ || true

    # Copy scripts
    cp -p /home/wcoss2/data/stofs_scripts/stofs_3d_atl/* /home/wcoss2/sandbox/stofs3d/scripts/stofs_3d_atl/ || true
    chmod -R +x /home/wcoss2/sandbox/stofs3d/scripts/stofs_3d_atl || true

    # Copy exec files
    cp /opt/stofs/exec/* /home/wcoss2/sandbox/stofs3d/exec/stofs_3d_atl/ || true
    chmod -R +x /home/wcoss2/sandbox/stofs3d/exec/stofs_3d_atl/ || true

    # Copy environment and version files
    cp /tmp/nos-workflow-repo/containers/environment.sh /home/wcoss2/environment.sh
    cp /tmp/nos-workflow-repo/containers/run.ver /home/wcoss2/sandbox/stofs3d/versions/run.ver
    cp /tmp/nos-workflow-repo/containers/sample_compaths.list /lfs/h1/ops/prod/config/compaths.list

    # Fix permissions
    chmod -R +x /lfs/h1/ops/prod/com/nwm/v3.0/ || true
    chmod -R +x /lfs/h1/ops/prod/com/ || true
    chmod -R +x /lfs/h1/ops/prod/dcom/ || true
    chmod -R +x /home/wcoss2/sandbox/dcom_root/ || true
    chmod -R +x /home/wcoss2/sandbox/stofs3d/dataroot/stofs_3d_atl_run_12_prod_v2.1 || true
    chown -R wcoss2:wcoss2 /home/wcoss2 || true

    # ============================================================
    # SETUP MODULEFILES
    # ============================================================
    mkdir -p /usr/share/modulefiles/models/adcirc
    mkdir -p /usr/share/modulefiles/models/schism
    mkdir -p /usr/share/modulefiles/ecflow
    mkdir -p /usr/share/modulefiles/slurm
    mkdir -p /usr/share/modulefiles/ncep

    # ADCIRC module
    cat > /usr/share/modulefiles/models/adcirc/${ADCIRC_VERSION} << 'ADCIRC_EOF'
#%Module 1.0
#
#  ADCIRC module for use with environment-modules package:
#
conflict		adcirc
module load mpi
prepend-path 		PATH 		/opt/models/adcirc/bin
ADCIRC_EOF

    # SCHISM module
    cat > /usr/share/modulefiles/models/schism/${SCHISM_VERSION} << 'SCHISM_EOF'
#%Module 1.0
#
#  SCHISM module for use with environment-modules package:
#
conflict		schism
module load mpi
prepend-path 		PATH 		/opt/models/schism/bin
SCHISM_EOF

    # ecFlow module
    cat > /usr/share/modulefiles/ecflow/${ECFLOW_VERSION} << 'ECFLOW_EOF'
#%Module 1.0
#
#  ecFlow module for use with environment-modules package:
#
conflict		ecflow
prepend-path 		PATH 		/opt/ecflow/bin
prepend-path 		LD_LIBRARY_PATH 		/opt/ecflow/lib
prepend-path     PYTHONPATH    /opt/ecflow/lib/python3.9/site-packages
setenv ECF_HOST localhost
setenv ECF_PORT 3121
ECFLOW_EOF

    # SLURM module
    cat > /usr/share/modulefiles/slurm/24.11.1.1 << 'SLURM_EOF'
#%Module 1.0
#
#  slurm module for use with environment-modules package:
#
conflict		slurm
prepend-path 		PATH 		/opt/slurm/bin
SLURM_EOF

    # NCEP module
    cat > /usr/share/modulefiles/ncep/develop << 'NCEP_EOF'
#%Module 1.0
#
#  Modulefile for NCEP libs
#
conflict ncep
prepend-path PATH /opt/ncep/bin
NCEP_EOF

    # Add modules to initrc
    echo "module load slurm" >> /etc/environment-modules/initrc
    echo "module load ecflow" >> /etc/environment-modules/initrc
    echo "module load ncep" >> /etc/environment-modules/initrc

    # ============================================================
    # SETUP OPENMPI
    # ============================================================
    echo 'export PATH=$PATH:/usr/lib64/openmpi/bin' >> /etc/bashrc
    echo 'export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/lib64/openmpi/lib' >> /etc/bashrc
    ln -sf /usr/lib64/openmpi/bin/mpiexec /usr/bin/mpiexec || true
    ln -sf /usr/lib64/openmpi/bin/mpirun /usr/bin/mpirun || true

    # ============================================================
    # CLEANUP
    # ============================================================
    dnf clean all
    rm -rf /tmp/nos-workflow-repo
    rm -rf /var/cache/dnf

%environment
    export PATH=/opt/slurm/bin:/opt/ecflow/bin:/opt/ncep/bin:/opt/wgrib2/bin:/opt/models/adcirc/bin:/opt/models/schism/bin:/usr/lib64/openmpi/bin:$PATH
    export LD_LIBRARY_PATH=/opt/ecflow/lib:/usr/lib64/openmpi/lib:$LD_LIBRARY_PATH
    export PYTHONPATH=/opt/ecflow/lib/python3.9/site-packages:$PYTHONPATH
    export ECF_HOST=localhost
    export ECF_PORT=3121
    export MODULEPATH=/usr/share/modulefiles:$MODULEPATH

%runscript
    echo "NOS Workflow Container (STOFS 3D Atlantic)"
    echo "==========================================="
    echo ""
    echo "Available models:"
    echo "  - ADCIRC v56.0.3"
    echo "  - SCHISM v5.11.0"
    echo ""
    echo "Available tools:"
    echo "  - ecFlow v5.6.0"
    echo "  - SLURM v24.11.1.1"
    echo "  - wgrib2"
    echo "  - NCEP libraries"
    echo ""
    exec /bin/bash "$@"

%test
    echo "Testing container build..."
    echo "Checking ADCIRC..."
    test -x /opt/models/adcirc/bin/adcirc || exit 1
    echo "Checking ecFlow..."
    test -x /opt/ecflow/bin/ecflow_client || exit 1
    echo "Checking SLURM..."
    test -x /opt/slurm/bin/sinfo || exit 1
    echo "Checking wgrib2..."
    test -x /opt/wgrib2/bin/wgrib2 || exit 1
    echo "Checking Python packages..."
    python3 -c "import netCDF4; print('netCDF4 OK')" || exit 1
    python3 -c "import numpy; print(f'numpy {numpy.__version__} OK')" || exit 1
    # xarray test - warn but don't fail
    python3 -c "import xarray; print('xarray OK')" || echo "WARNING: xarray import issue (non-fatal)"
    echo "All critical tests passed!"

%help
    NOS Workflow Container (STOFS 3D Atlantic)
    ==========================================

    This container provides a complete environment for running the
    NOAA NOS STOFS (Surge and Tide Operational Forecast System) workflow.

    INCLUDED SOFTWARE:
    ------------------
    Models:
      - ADCIRC v56.0.3 (coastal circulation model)
      - SCHISM v5.11.0 (unstructured grid ocean model)

    Tools:
      - ecFlow v5.6.0 (workflow manager)
      - SLURM v24.11.1.1 (job scheduler)
      - wgrib2 (GRIB2 utility)
      - NCEP libraries

    USAGE:
    ------
    Interactive shell:
      apptainer shell nos-workflow.sif

    Run a command:
      apptainer exec nos-workflow.sif <command>

    SOURCE:
    -------
    https://github.com/mansurjisan/nos-workflow
