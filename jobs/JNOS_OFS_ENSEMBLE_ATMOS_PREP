fi
exit \$rc
WRAPEOF
        chmod 755 ${WRAPPER}
        echo "${WRAPPER}" >> ${DATM_CMDFILE}
        (( DATM_COUNT = DATM_COUNT + 1 ))
    done

    # RRFS member: generate DATM forcing with RRFS as primary (no HRRR blend)
    if [ "${RRFS_ENABLED}" = "true" ]; then
        RRFS_WORKDIR=${DATA}/datm_ensemble/rrfs
        RRFS_OUTDIR=${COMOUT}/${RUN}.${cycle}.datm_input_rrfs
        mkdir -p ${RRFS_WORKDIR} ${RRFS_OUTDIR}

        # RRFS needs special handling: regrid from Lambert to lat/lon first.
        # The existing nos_ofs_create_datm_forcing.sh does not support RRFS
        # directly (it's a 3km Lambert Conformal grid, not regular lat/lon).
        # For now, use the RRFS sflux pipeline to generate sflux files, then
        # convert. If RRFS DATM support is needed, add RRFS case to the
        # DATM forcing script. For MVP, fall back to GFS for RRFS member.
        WRAPPER=${DATA}/datm_rrfs_wrapper.sh
        cat > ${WRAPPER} << WRAPEOF
#!/bin/bash
set -x
echo "WARNING: RRFS DATM forcing not yet implemented — using GFS as fallback"
export DATA=${RRFS_WORKDIR}
export DATM_PRIMARY_SOURCE=GFS25
export DATM_BLEND_HRRR_GFS=false
export DATM_OUTPUT_SUFFIX=rrfs
export DATM_SKIP_UFS_CONFIG=true
mkdir -p \${DATA}/INPUT
${USHnos}/nosofs/nos_ofs_create_datm_forcing_blended.sh ${DATM_DOMAIN:-SECOFS}
rc=\$?
if [ \$rc -eq 0 ] && [ -d \${DATA}/INPUT ]; then
    cp -p \${DATA}/INPUT/*.nc ${RRFS_OUTDIR}/ 2>/dev/null
    echo "Archived DATM input to ${RRFS_OUTDIR}"
fi
exit \$rc
WRAPEOF
        chmod 755 ${WRAPPER}
        echo "${WRAPPER}" >> ${DATM_CMDFILE}
        (( DATM_COUNT = DATM_COUNT + 1 ))
    fi

    if [ ${DATM_COUNT} -gt 0 ]; then
        echo ""
        echo "DATM ensemble command file (${DATM_COUNT} members):"
        cat ${DATM_CMDFILE}

        chmod 755 ${DATM_CMDFILE}
        DATM_NP=${DATM_COUNT}
        DATM_PPN=${GEFS_PPN:-8}
        if [ ${DATM_NP} -gt ${DATM_PPN} ]; then
            DATM_NP=${DATM_PPN}
        fi
        echo "Launching cfp with ${DATM_NP} parallel tasks for ${DATM_COUNT} DATM members"
        mpiexec -n ${DATM_NP} -ppn ${DATM_NP} cfp ${DATM_CMDFILE}
        rc=$?
        if [ $rc -ne 0 ]; then
            echo "WARNING: cfp DATM ensemble processing returned exit code $rc" >&2
            echo "Some members may have failed. Continuing..."
        fi

        # Verify DATM output directories
        echo ""
        echo "DATM ensemble member outputs:"
        for GEFS_MEM in ${GEFS_MEMBERS}; do
            MEM_OUTDIR=${COMOUT}/${RUN}.${cycle}.datm_input_gefs_${GEFS_MEM}
            if [ -s "${MEM_OUTDIR}/datm_forcing.nc" ]; then
                echo "  OK: datm_input_gefs_${GEFS_MEM} ($(ls -lh ${MEM_OUTDIR}/datm_forcing.nc | awk '{print $5}'))"
            else
                echo "  MISSING: datm_input_gefs_${GEFS_MEM}"
            fi
        done
        if [ "${RRFS_ENABLED}" = "true" ]; then
            RRFS_OUTDIR=${COMOUT}/${RUN}.${cycle}.datm_input_rrfs
            if [ -s "${RRFS_OUTDIR}/datm_forcing.nc" ]; then
                echo "  OK: datm_input_rrfs ($(ls -lh ${RRFS_OUTDIR}/datm_forcing.nc | awk '{print $5}'))"
            else
                echo "  MISSING: datm_input_rrfs"
            fi
        fi
    else
        echo "No DATM ensemble members to process."
    fi

    else
    ########################################################
    # COMF (non-DATM): Use nos_ofs_launch.sh + nos_ofs_create_forcing_met.sh
    # (existing behavior for standalone SECOFS and other COMF OFS)
    ########################################################
    echo "=== Sourcing nos_ofs_launch.sh to set up environment ==="

    # COMF Fortran executables need NetCDF Fortran library preloaded
    if [ -n "${netcdf_ver:-}" ] && [ -n "${intel_ver:-}" ]; then
        export LD_PRELOAD=/apps/prod/netcdf/${netcdf_ver}/intel/${intel_ver}/lib/libnetcdff.so:${LD_PRELOAD}
    fi

    export pgm="$USHnos/nos_ofs_launch.sh $OFS prep"
    . $USHnos/nos_ofs_launch.sh $OFS prep
    rc=$?
    if [ $rc -ne 0 ]; then
        echo "ERROR: nos_ofs_launch.sh failed (exit code $rc)" >&2
        exit $rc
    fi

    echo "time_nowcastend=${time_nowcastend}"
    echo "time_forecastend=${time_forecastend}"

    ########################################################
    # Process each extra source (COMF pipeline)
    ########################################################
    # Stay in $DATA where nos_ofs_launch.sh already set up grid files,
    # control files, and other inputs the met script expects in CWD.
    # Do NOT cd to a subdirectory — the met script writes cmdfile to CWD
    # but references $DATA/cmdfile for chmod/mpiexec, so CWD must equal $DATA.

    # Save the original forecast tar name (set by nos_ofs_launch.sh)
    ORIG_MET_TAR="${MET_NETCDF_1_FORECAST}"

    for SOURCE in ${EXTRA_SOURCES}; do
        echo ""
        echo "=============================================="
        echo "Processing extra atmospheric source: ${SOURCE}"
        echo "=============================================="

        cd ${DATA}

        # Set met forcing parameters for this source
        export metnum=1
        export DBASE=${SOURCE}
        export MET_NUM=1
        export nfore=1

        # Override the output tar name (bare filename — the met script prepends
        # $DATA/ for creation and $COMOUT/ for archival internally)
        export MET_NETCDF_1_FORECAST="${PREFIXNOS}.${cycle}.${PDY}.met.forecast.${SOURCE}.nc.tar"

        TIME_START_TMP=${time_nowcastend}
        TIME_END_TMP=${time_forecastend}

        echo "DBASE=${DBASE}, metnum=${metnum}, nfore=${nfore}"
        echo "TIME_START=${TIME_START_TMP}, TIME_END=${TIME_END_TMP}"
        echo "Output tar: ${MET_NETCDF_1_FORECAST}"

        # Call the same met forcing script used by normal prep
        export pgm=nos_ofs_create_forcing_met.sh
        $USHnos/nos_ofs_create_forcing_met.sh forecast ${DBASE} ${TIME_START_TMP} ${TIME_END_TMP}
        rc=$?
        if [ $rc -ne 0 ]; then
            echo "ERROR: nos_ofs_create_forcing_met.sh failed for ${SOURCE} (exit code $rc)" >&2
            echo "WARNING: Skipping ${SOURCE}, ensemble members needing it will use fallback"
            continue
        fi

        echo "Met forcing generation completed for ${SOURCE}"

        # The met script already copies the tar to $COMOUT/$MET_NETCDF_1_FORECAST.
        # Verify it arrived. Also copy to $DATA for the J-job's own reference.
        COMOUT_TAR="${COMOUT}/${MET_NETCDF_1_FORECAST}"
        DEST_TAR="${COMOUT}/${PREFIXNOS}.${cycle}.${PDY}.met.forecast.${SOURCE}.tar"

        if [ -f "${COMOUT_TAR}" ]; then
            # Rename from .nc.tar to final name if they differ
            if [ "${COMOUT_TAR}" != "${DEST_TAR}" ]; then
                mv "${COMOUT_TAR}" "${DEST_TAR}"
            fi
            echo "Archived: ${DEST_TAR}"
            ls -la "${DEST_TAR}"
        elif [ -f "${DATA}/${MET_NETCDF_1_FORECAST}" ]; then
            # Fallback: met script left it in $DATA instead of copying
            cp "${DATA}/${MET_NETCDF_1_FORECAST}" "${DEST_TAR}"
            echo "Archived (from DATA): ${DEST_TAR}"
            ls -la "${DEST_TAR}"
        else
            echo "ERROR: No met forecast tar found for ${SOURCE}" >&2
            ls -la ${COMOUT}/*.tar ${DATA}/*.tar 2>/dev/null || true
        fi
    done

    # Restore original tar name
    export MET_NETCDF_1_FORECAST="${ORIG_MET_TAR}"

    ########################################################
    # Process GEFS ensemble members (COMF pipeline)
    # Uses stofs_3d_atl_create_surface_forcing_gefs.sh (wgrib2/NCO)
    # instead of the COMF Fortran nos_ofs_create_forcing_met pipeline.
    # Reason: the Fortran pipeline uses internal mpiexec+cfp which
    # cannot nest inside the outer cfp that parallelizes GEFS members.
    # Output: ${RUN}.${cycle}.gefs_${ID}.{air,prc,rad}.nc in COMOUTrerun
    ########################################################
    if [ -n "${GEFS_MEMBERS}" ]; then
        echo ""
        echo "=============================================="
        echo "Processing GEFS ensemble members: ${GEFS_MEMBERS}"
        echo "Using wgrib2/NCO pipeline (same as STOFS)"
        echo "=============================================="
        echo "COMINgefs=${COMINgefs:-not set}"

        GEFS_FORCING_SCRIPT="${HOMEnos}/ush/stofs_3d_atl/stofs_3d_atl_create_surface_forcing_gefs.sh"

        if [ ! -f "${GEFS_FORCING_SCRIPT}" ]; then
            echo "ERROR: GEFS forcing script not found: ${GEFS_FORCING_SCRIPT}" >&2
            echo "GEFS ensemble atmospheric forcing will not be available"
        else
            # Set up STOFS-style variables (same approach as RRFS COMF section)
            export COMOUTrerun=${COMOUTrerun:-${COMOUT}/rerun}
            mkdir -p ${COMOUTrerun}

            _SAVE_FIXstofs3d="${FIXstofs3d:-}"
            export FIXstofs3d=${HOMEnos}/fix/stofs_3d_atl

            export PDYHH_FCAST_BEGIN=${PDYHH_FCAST_BEGIN:-${PDY}${cyc}}
            if [ -z "${PDYHH_NCAST_BEGIN:-}" ]; then
                if command -v ${NDATE:-ndate} &> /dev/null; then
                    export PDYHH_NCAST_BEGIN=$(${NDATE:-ndate} -24 ${PDY}${cyc})
                else
                    export PDYHH_NCAST_BEGIN=$(python3 -c "
from datetime import datetime, timedelta
base = datetime.strptime('${PDY}${cyc}', '%Y%m%d%H')
print((base - timedelta(hours=24)).strftime('%Y%m%d%H'))
")
                fi
            fi

            export WGRIB2=${WGRIB2:-wgrib2}

            # Clear LD_PRELOAD — the Fortran library causes segfaults in wgrib2/ncap2
            _SAVE_LD_PRELOAD="${LD_PRELOAD:-}"
            unset LD_PRELOAD

            # Wrapper script for cfp (proper env var isolation)
            GEFS_WRAPPER=${DATA}/gefs_comf_wrapper.sh
            cat > ${GEFS_WRAPPER} << 'GEFSWRAPEOF'
#!/bin/bash
set -x
export GEFS_MEMBER=${1:?}
export DATA_prep_gefs=${2:?}
SCRIPT=${3:?}
echo "=== GEFS member ${GEFS_MEMBER} starting in ${DATA_prep_gefs} ==="
bash ${SCRIPT}
rc=$?
echo "=== GEFS member ${GEFS_MEMBER} finished (rc=${rc}) ==="
exit ${rc}
GEFSWRAPEOF
            chmod 755 ${GEFS_WRAPPER}

            GEFS_CMDFILE=${DATA}/gefs_cmdfile
            cat /dev/null > ${GEFS_CMDFILE}
            GEFS_COUNT=0

            for GEFS_MEM in ${GEFS_MEMBERS}; do
                GEFS_MEM_WORKDIR=${DATA}/atmos_ensemble/gefs_${GEFS_MEM}
                mkdir -p ${GEFS_MEM_WORKDIR}
                echo "${GEFS_WRAPPER} ${GEFS_MEM} ${GEFS_MEM_WORKDIR} ${GEFS_FORCING_SCRIPT}" >> ${GEFS_CMDFILE}
                (( GEFS_COUNT = GEFS_COUNT + 1 ))
            done

            echo "GEFS command file (${GEFS_COUNT} members):"
            cat ${GEFS_CMDFILE}

            chmod 755 ${GEFS_CMDFILE}
            GEFS_NP=${GEFS_COUNT}
            GEFS_PPN=${GEFS_PPN:-8}
            if [ ${GEFS_NP} -gt ${GEFS_PPN} ]; then
                GEFS_NP=${GEFS_PPN}
            fi
            echo "Launching cfp with ${GEFS_NP} parallel tasks for ${GEFS_COUNT} GEFS members"
            mpiexec -n ${GEFS_NP} -ppn ${GEFS_NP} cfp ${GEFS_CMDFILE}
            rc=$?
            if [ $rc -ne 0 ]; then
                echo "WARNING: cfp GEFS processing returned exit code $rc" >&2
                echo "Some GEFS members may have failed. Continuing..."
            fi

            # Restore LD_PRELOAD and FIXstofs3d
            if [ -n "${_SAVE_LD_PRELOAD}" ]; then
                export LD_PRELOAD="${_SAVE_LD_PRELOAD}"
            fi
            export FIXstofs3d="${_SAVE_FIXstofs3d}"

            # Verify GEFS output files in COMOUTrerun
            echo ""
            echo "GEFS member outputs in COMOUTrerun:"
            GEFS_SUCCESS=0
            GEFS_FAIL=0
            for GEFS_MEM in ${GEFS_MEMBERS}; do
                _all_ok=true
                for var in air prc rad; do
                    _outfile="${COMOUTrerun}/${RUN}.${cycle}.gefs_${GEFS_MEM}.${var}.nc"
                    if [ -s "${_outfile}" ]; then
                        echo "  OK: $(basename ${_outfile})"
                    else
                        echo "  MISSING: $(basename ${_outfile})"
                        _all_ok=false
                    fi
                done
                if [ "${_all_ok}" = true ]; then
                    (( GEFS_SUCCESS = GEFS_SUCCESS + 1 ))
                else
                    (( GEFS_FAIL = GEFS_FAIL + 1 ))
                fi
            done
            echo "GEFS summary: ${GEFS_SUCCESS} succeeded, ${GEFS_FAIL} failed out of ${GEFS_COUNT}"
        fi
    fi

    ########################################################
    # Process RRFS atmospheric forcing (COMF pipeline)
    # Uses the same wgrib2/ncap2 shell script as STOFS — the COMF Fortran
    # nos_ofs_create_forcing_met does NOT support RRFS as a data source.
    # Output: ${RUN}.${cycle}.rrfs.{air,prc,rad}.nc in COMOUTrerun
    # RRFS data: /lfs/h1/ops/para/com/rrfs/v1.0/rrfs.YYYYMMDD/HH/
    #   rrfs.tHHz.prslev.3km.fFFF.na.grib2
    ########################################################
    if [ "${RRFS_ENABLED}" = "true" ]; then
        echo ""
        echo "=============================================="
        echo "Processing RRFS atmospheric forcing (shell/wgrib2 pipeline)"
        echo "=============================================="
        echo "COMINrrfs=${COMINrrfs:-not set}"
        echo "RRFS_MAX_FHOURS=${RRFS_MAX_FHOURS}"
        echo "RRFS_FALLBACK_SOURCE=${RRFS_FALLBACK_SOURCE:-none}"

        # The RRFS forcing script is shared between STOFS and COMF.
        # It lives under ush/stofs_3d_atl/ but works for any SCHISM OFS.
        RRFS_FORCING_SCRIPT="${HOMEnos}/ush/stofs_3d_atl/stofs_3d_atl_create_surface_forcing_rrfs.sh"

        if [ ! -f "${RRFS_FORCING_SCRIPT}" ]; then
            echo "ERROR: RRFS forcing script not found: ${RRFS_FORCING_SCRIPT}" >&2
            echo "RRFS ensemble atmospheric forcing will not be available"
        else
            # Set up STOFS-style variables that the RRFS script expects.
            # COMF uses MINLON/MAXLON; the RRFS script handles both conventions.
            export DATA_prep_rrfs=${DATA}/atmos_ensemble/rrfs
            mkdir -p ${DATA_prep_rrfs}

            # COMOUTrerun: STOFS convention for storing sflux forcing files.
            # Create it for COMF if not already set.
            export COMOUTrerun=${COMOUTrerun:-${COMOUT}/rerun}
            mkdir -p ${COMOUTrerun}

            # FIXstofs3d: the RRFS script reads the NCO update file from here.
            # For COMF, the NCO file is installed under fix/stofs_3d_atl/.
            # Set FIXstofs3d temporarily so the script finds the file.
            _SAVE_FIXstofs3d="${FIXstofs3d:-}"
            export FIXstofs3d=${HOMEnos}/fix/stofs_3d_atl

            # PDYHH timestamps: the RRFS script derives dates from these.
            # For COMF, construct from PDY + cyc + run lengths.
            export PDYHH_FCAST_BEGIN=${PDYHH_FCAST_BEGIN:-${PDY}${cyc}}
            if [ -z "${PDYHH_NCAST_BEGIN:-}" ]; then
                if command -v ${NDATE:-ndate} &> /dev/null; then
                    export PDYHH_NCAST_BEGIN=$(${NDATE:-ndate} -24 ${PDY}${cyc})
                else
                    # Fallback: assume 24h nowcast lookback
                    export PDYHH_NCAST_BEGIN=${PDY}${cyc}
                fi
            fi

            # WGRIB2 path (usually set by module load)
            export WGRIB2=${WGRIB2:-wgrib2}

            # Temporarily clear LD_PRELOAD — the Fortran library causes
            # segfaults in wgrib2/ncap2/ncrename (same issue as param_generator).
            _SAVE_LD_PRELOAD="${LD_PRELOAD:-}"
            unset LD_PRELOAD

            echo "Running: ${RRFS_FORCING_SCRIPT}"
            echo "  DATA_prep_rrfs=${DATA_prep_rrfs}"
            echo "  COMOUTrerun=${COMOUTrerun}"
            echo "  FIXstofs3d=${FIXstofs3d}"
            echo "  PDYHH_FCAST_BEGIN=${PDYHH_FCAST_BEGIN}"
            echo "  PDYHH_NCAST_BEGIN=${PDYHH_NCAST_BEGIN}"

            bash ${RRFS_FORCING_SCRIPT}
            rc=$?

            # Restore LD_PRELOAD and FIXstofs3d
            if [ -n "${_SAVE_LD_PRELOAD}" ]; then
                export LD_PRELOAD="${_SAVE_LD_PRELOAD}"
            fi
            export FIXstofs3d="${_SAVE_FIXstofs3d}"

            if [ $rc -ne 0 ]; then
                echo "ERROR: ${RRFS_FORCING_SCRIPT} failed (exit code $rc)" >&2
                echo "WARNING: RRFS forcing failed, ensemble member using RRFS will use fallback"
            fi

            # Verify RRFS output files in COMOUTrerun
            # RRFS only produces air+prc (radiation has incompatible variable naming)
            echo ""
            echo "RRFS outputs in COMOUTrerun:"
            _rrfs_ok=true
            for var in air prc; do
                _outfile="${COMOUTrerun}/${RUN}.${cycle}.rrfs.${var}.nc"
                if [ -s "${_outfile}" ]; then
                    echo "  OK: $(basename ${_outfile}) ($(stat -c%s "${_outfile}" 2>/dev/null || echo '?') bytes)"
                else
                    echo "  MISSING: $(basename ${_outfile})"
                    _rrfs_ok=false
                fi
            done
            if [ "${_rrfs_ok}" = true ]; then
                echo "RRFS forcing: SUCCESS (air+prc; rad from GFS fallback)"
            else
                echo "RRFS forcing: INCOMPLETE (some files missing)"
            fi
        fi
    fi

    fi  # end USE_DATM if/else
fi  # end OFS_FRAMEWORK if/else

########################################################
# Summary
########################################################
echo ""
echo "=== Atmospheric ensemble prep complete ==="

if [ -n "${EXTRA_SOURCES}" ]; then
    echo "Extra source tars in COMOUT:"
    for SOURCE in ${EXTRA_SOURCES}; do
        tar_file="${COMOUT}/${PREFIXNOS}.${cycle}.${PDY}.met.forecast.${SOURCE}.tar"
        if [ -f "${tar_file}" ]; then
            echo "  OK: $(basename ${tar_file}) ($(stat -c%s "${tar_file}" 2>/dev/null || echo '?') bytes)"
        else
            echo "  MISSING: $(basename ${tar_file})"
        fi
    done
fi

if [ -n "${GEFS_MEMBERS}" ]; then
    if [ "${USE_DATM:-false}" == "true" ] || [ "${USE_DATM:-0}" == "1" ]; then
        echo "GEFS DATM member outputs:"
        for GEFS_MEM in ${GEFS_MEMBERS}; do
            MEM_OUTDIR=${COMOUT}/${RUN}.${cycle}.datm_input_gefs_${GEFS_MEM}
            if [ -s "${MEM_OUTDIR}/datm_forcing.nc" ]; then
                echo "  OK: datm_input_gefs_${GEFS_MEM} ($(ls -lh ${MEM_OUTDIR}/datm_forcing.nc | awk '{print $5}'))"
            else
                echo "  MISSING: datm_input_gefs_${GEFS_MEM}"
            fi
        done
    else
        echo "GEFS member outputs:"
        for GEFS_MEM in ${GEFS_MEMBERS}; do
            if [ "${GEFS_MEM}" = "c00" ] || [ "${GEFS_MEM}" = "00" ]; then
                _tag="gec00"
            else
                _tag="gep$(printf '%02d' "${GEFS_MEM}" 2>/dev/null || echo "${GEFS_MEM}")"
            fi
            # GEFS pgrb2sp25 produces air+prc+rad (all 8 sflux variables)
            _ok=true
            for var in air prc rad; do
                _f="${COMOUTrerun:-${COMOUT}/rerun}/${RUN}.${cycle}.gefs_${GEFS_MEM}.${var}.nc"
                [ ! -s "${_f}" ] && _ok=false
            done
            if [ "${_ok}" = true ]; then
                echo "  OK: gefs_${GEFS_MEM} (air/prc/rad in COMOUTrerun)"
            else
                echo "  MISSING: gefs_${GEFS_MEM}"
            fi
        done
    fi
fi

if [ "${RRFS_ENABLED}" = "true" ]; then
    if [ "${USE_DATM:-false}" == "true" ] || [ "${USE_DATM:-0}" == "1" ]; then
        echo "RRFS DATM forcing output:"
        RRFS_OUTDIR=${COMOUT}/${RUN}.${cycle}.datm_input_rrfs
        if [ -s "${RRFS_OUTDIR}/datm_forcing.nc" ]; then
            echo "  OK: datm_input_rrfs/datm_forcing.nc ($(ls -lh ${RRFS_OUTDIR}/datm_forcing.nc | awk '{print $5}'))"
        else
            echo "  MISSING: datm_input_rrfs/datm_forcing.nc"
        fi
    else
        echo "RRFS forcing output:"
        # RRFS only produces air+prc (radiation has incompatible variable naming;
        # rad comes from GFS fallback during member staging)
        _rrfs_ok=true
        for var in air prc; do
            _f="${COMOUTrerun:-${COMOUT}/rerun}/${RUN}.${cycle}.rrfs.${var}.nc"
            if [ -s "${_f}" ]; then
                echo "  OK: $(basename ${_f}) ($(stat -c%s "${_f}" 2>/dev/null || echo '?') bytes)"
            else
                echo "  MISSING: $(basename ${_f})"
                _rrfs_ok=false
            fi
        done
        if [ "${_rrfs_ok}" = true ]; then
            echo "  RRFS: OK (air+prc in COMOUTrerun; rad from GFS fallback)"
        else
            echo "  RRFS: INCOMPLETE"
        fi
    fi
fi

########################################################
# Post-processing
########################################################
cat $pgmout 2>/dev/null || true

if command -v postmsg &> /dev/null; then
    postmsg "$jlogfile" "$0 completed normally"
fi

##############################
# Cleanup
##############################
if [ "${KEEPDATA^^}" != YES ]; then
    rm -rf $DATA
fi

date
