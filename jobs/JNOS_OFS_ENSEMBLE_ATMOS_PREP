#!/bin/bash
set -x

########################################
# JNOS_OFS_ENSEMBLE_ATMOS_PREP - Atmospheric Forcing for Ensemble
#
# Creates atmospheric forcing for ensemble members beyond what normal
# prep produces.  Normal prep already creates GFS (metnum=1) and HRRR
# (metnum=2).  This job handles:
#
#   1. Extra sources (e.g., NAM) defined in atmospheric_ensemble.extra_sources
#   2. GEFS members defined in ensemble.gefs or atmospheric_ensemble
#
# For non-GEFS extra sources (e.g., NAM):
#   - COMF: nos_ofs_create_forcing_met.sh with DBASE=<source>
#   - STOFS: stofs_3d_atl_create_surface_forcing_<source>.sh
#   - Output: ${PREFIXNOS}.${cycle}.${PDY}.met.forecast.<SOURCE>.tar
#
# For GEFS members (parallel via cfp):
#   - COMF: nos_ofs_create_forcing_met.sh with DBASE=GEFS, GEFS_MEMBER=<id>
#     Output: ${PREFIXNOS}.${cycle}.${PDY}.met.forecast.GEFS_gep<NN>.nc.tar
#   - STOFS: stofs_3d_atl_create_surface_forcing_gefs.sh with GEFS_MEMBER=<id>
#     Output: ${RUN}.${cycle}.gefs_<NN>.{air,prc,rad}.nc in COMOUTrerun
#
# Required environment variables:
#   OFS         - OFS system name (e.g., secofs, stofs_3d_atl)
#   cyc         - Cycle hour (00, 06, 12, 18)
#
# Optional:
#   GEFS_MEMBERS - Override GEFS member IDs (e.g., "01 02 03 04 05")
#   GEFS_PPN     - Max parallel tasks per node for cfp (default: 8)
########################################
export PS4=' $SECONDS + '
date

########################################
# Load shared library
########################################
export LD_PRELOAD=${LD_PRELOAD:-}

########################################
# Set HOME directories
########################################
export nosofs_ver=${nosofs_ver:-${nos_ofs_ver:-}}
export HOMEnos=${HOMEnos:-${PACKAGEROOT}/nosofs.${nosofs_ver:?}}
export HOMEstofs=${HOMEstofs:-${HOMEnos}}

###################################
# Specify NET and RUN Name and model
####################################
case "${OFS,,}" in
    stofs_3d_atl|stofs_3d_pac|stofs_2d_glo)
        export NET=${NET:-stofs}
        ;;
    *)
        export NET=${NET:-nosofs}
        ;;
esac
export RUN=${RUN:-$OFS}
export PREFIXNOS=${PREFIXNOS:-$OFS}
export CONTINUE_FORECAST=${CONTINUE_FORECAST:-NO}
export SENDDBN=${SENDDBN:-NO}

export cycle=t${cyc}z

########################################################
# Working directory
########################################################
export DATA=${DATA:-${DATAROOT:?}/${jobid:?}}

if [ ! -d $DATA ]; then
    mkdir -p $DATA
    cd $DATA
else
    cd $DATA
fi

############################################
# Job Output
############################################
export pgmout="OUTPUT.$$"
export jlogfile=${logfile:-${DATA}/jlogfile}

####################################
# Execution Areas
####################################
export EXECnos=${EXECnos:-${HOMEnos}/exec}
export FIXnos=${FIXnos:-${HOMEnos}/fix/shared}
export FIXofs=${FIXofs:-${HOMEnos}/fix/${OFS}}
export PARMnos=${PARMnos:-${HOMEnos}/parm}
export USHnos=${USHnos:-${HOMEnos}/ush}
export SCRIPTSnos=${SCRIPTSnos:-${HOMEnos}/scripts}

####################################
# YAML Configuration Loading
####################################
case "${OFS,,}" in
    stofs_3d_atl|stofs_3d_pac)
        export OFS_FRAMEWORK="stofs"
        ;;
    stofs_2d_glo)
        export OFS_FRAMEWORK="adcirc"
        ;;
    *)
        export OFS_FRAMEWORK="comf"
        ;;
esac

export OFS_CONFIG="${OFS_CONFIG:-${PARMnos}/systems/${OFS}.yaml}"

if [ -f "${USHnos}/nos_ofs_config.sh" ]; then
    source "${USHnos}/nos_ofs_config.sh"
    load_ofs_config "${OFS_CONFIG}" "${OFS_FRAMEWORK}"
fi

echo "OFS Framework: ${OFS_FRAMEWORK}"

###########################################
# PDY variables
###########################################
if [ -z "${PDY:-}" ]; then
    if command -v setpdy.sh &> /dev/null; then
        setpdy.sh
        . PDY
    fi
    export PDY=${PDY:-$(date +%Y%m%d)}
else
    echo "Using PDY=${PDY} from environment"
fi
export cyc=$(printf '%02d' "${cyc}")
export time_nowcastend=${PDY}${cyc}

##############################################
# Define COM directories
##############################################
export COMROOT=${COMROOT:-/lfs/h1/ops/${envir}/com}
export DCOMROOT=${DCOMROOT:-/lfs/h1/ops/${envir}/dcom}

_com_ver=${com_ver:-${nosofs_ver}}
if command -v compath.py &> /dev/null; then
    _comin_root=$(compath.py ${NET}/${_com_ver} 2>/dev/null) || _comin_root=""
    _comout_root=$(compath.py -o ${NET}/${_com_ver} 2>/dev/null) || _comout_root=""
fi

export COMIN=${COMIN:-${_comin_root:-${COMROOT}/${NET}/${_com_ver}}/${RUN}.${PDY}}
export COMOUTroot=${COMOUTroot:-${_comout_root:-${COMROOT}/${NET}/${_com_ver}}}
export COMOUT=${COMOUT:-${COMOUTroot}/${RUN}.${PDY}}

mkdir -m 775 -p $COMOUT

##############################################
# Set up input data paths
##############################################
if command -v compath.py &> /dev/null; then
    export COMINnam=${COMINnam:-$(compath.py prod/nam/${nam_ver:-v4.2})}
    export COMINhrrr=${COMINhrrr:-$(compath.py prod/hrrr/${hrrr_ver:-v4.1})}
    export COMINrap=${COMINrap:-$(compath.py prod/rap/${rap_ver:-v5.1})}
    export COMINrtma=${COMINrtma:-$(compath.py prod/rtma/${rtma_ver:-v2.8})}
    export COMINgfs=${COMINgfs:-$(compath.py prod/gfs/${gfs_ver:-v16.3})}
    export COMINgefs=${COMINgefs:-$(compath.py prod/gefs/${gefs_ver:-v12.3})}
fi

export DCOMINndfd=${DCOMROOT:-}

##################################################################
# Log Files
##################################################################
export nosjlogfile=${COMOUT}/${PREFIXNOS}.${cycle}.${PDY}.atmos_ensemble.jlogfile.log
export cormslogfile=${COMOUT}/${PREFIXNOS}.${cycle}.${PDY}.atmos_ensemble.corms.log

env

########################################################
# Read atmospheric ensemble config from YAML
# Extracts:
#   EXTRA_SOURCES  - non-GEFS extra sources (e.g., NAM)
#   GEFS_MEMBERS   - GEFS member IDs to process (e.g., "01 02 03")
#   GEFS_PRODUCT   - GEFS product directory (pgrb2ap5)
#   GEFS_RESOLUTION- GEFS resolution string (0p50)
########################################################
echo "=== Reading atmospheric ensemble configuration ==="

export PYTHONPATH=${HOMEnos}/ush/python:${PYTHONPATH:-}

# Extract extra_sources and GEFS member list from YAML
_yaml_output=$(python3 << 'PYEOF'
import os, sys
try:
    import yaml
except ImportError:
    sys.exit(1)

config_path = os.environ.get("OFS_CONFIG", "")
if not config_path or not os.path.isfile(config_path):
    sys.exit(1)

with open(config_path) as f:
    data = yaml.safe_load(f)

ens = data.get("ensemble", {})
method = ens.get("method", "parameter_perturbation")
atm = ens.get("atmospheric_ensemble", {})
gefs_cfg = ens.get("gefs", {})

# Line 1: ensemble method
print(method)

# Line 2: non-GEFS extra_sources (space-separated)
non_gefs_sources = []
if atm.get("enabled", False):
    for src in atm.get("extra_sources", []):
        if not src.upper().startswith("GEFS"):
            non_gefs_sources.append(src)
print(" ".join(non_gefs_sources))

# Line 3: GEFS member IDs to process (space-separated)
# Collected from gefs.extra_sources, gefs.members, or atmospheric_ensemble
gefs_ids = []
if gefs_cfg.get("enabled", False):
    # New-style GEFS config: extra_sources contains GEFS_01, GEFS_02, etc.
    for src in gefs_cfg.get("extra_sources", []):
        if src.upper().startswith("GEFS_"):
            gefs_id = src.split("_", 1)[1]
            if gefs_id not in gefs_ids:
                gefs_ids.append(gefs_id)
    # Also check gefs.members definitions for sources
    if not gefs_ids:
        for mid, mcfg in sorted(gefs_cfg.get("members", {}).items()):
            ms1 = mcfg.get("met_source_1", "")
            if ms1.upper().startswith("GEFS_"):
                gefs_id = ms1.split("_", 1)[1]
                if gefs_id not in gefs_ids:
                    gefs_ids.append(gefs_id)
elif atm.get("enabled", False):
    # Legacy atmospheric_ensemble: extract GEFS from extra_sources
    for src in atm.get("extra_sources", []):
        if src.upper().startswith("GEFS_"):
            gefs_id = src.split("_", 1)[1]
            if gefs_id not in gefs_ids:
                gefs_ids.append(gefs_id)
    # Also check member definitions for GEFS sources
    for mid, mcfg in sorted(atm.get("members", {}).items()):
        ms1 = mcfg.get("met_source_1", "")
        if ms1.upper().startswith("GEFS_"):
            gefs_id = ms1.split("_", 1)[1]
            if gefs_id not in gefs_ids:
                gefs_ids.append(gefs_id)
print(" ".join(gefs_ids))

# Line 4: GEFS product directory
print(gefs_cfg.get("product", "pgrb2ap5"))

# Line 5: GEFS resolution string
print(gefs_cfg.get("resolution", "0p50"))
PYEOF
)
rc=$?
if [ $rc -ne 0 ]; then
    echo "ERROR: Failed to read atmospheric ensemble config from YAML" >&2
    exit $rc
fi

ENSEMBLE_METHOD=$(echo "${_yaml_output}" | sed -n '1p')
EXTRA_SOURCES=$(echo "${_yaml_output}" | sed -n '2p')
GEFS_MEMBERS=${GEFS_MEMBERS:-$(echo "${_yaml_output}" | sed -n '3p')}
export GEFS_PRODUCT=$(echo "${_yaml_output}" | sed -n '4p')
export GEFS_RESOLUTION=$(echo "${_yaml_output}" | sed -n '5p')

echo "Ensemble method: ${ENSEMBLE_METHOD}"
echo "Extra atmospheric sources (non-GEFS): ${EXTRA_SOURCES:-none}"
echo "GEFS members to process: ${GEFS_MEMBERS:-none}"
echo "GEFS product: ${GEFS_PRODUCT}"
echo "GEFS resolution: ${GEFS_RESOLUTION}"

if [ -z "${EXTRA_SOURCES}" ] && [ -z "${GEFS_MEMBERS}" ]; then
    echo "No extra atmospheric sources or GEFS members configured. Nothing to do."
    date
    exit 0
fi

########################################################
# Framework-specific processing
########################################################
if [ "${OFS_FRAMEWORK}" = "stofs" ]; then
    ########################################################
    # STOFS: Call STOFS forcing scripts directly
    # STOFS uses its own shell/wgrib2/NCO scripts, NOT the
    # COMF nos_ofs_create_forcing_met.sh pipeline.
    ########################################################
    echo "=== STOFS atmospheric ensemble prep ==="

    # Set up STOFS-specific paths
    export USHstofs3d=${USHstofs3d:-${HOMEstofs}/ush/${RUN}}
    export FIXstofs3d=${FIXstofs3d:-${HOMEstofs}/fix/${RUN}}
    export EXECstofs3d=${EXECstofs3d:-${HOMEstofs}/exec/${RUN}}

    # COMOUTrerun: where STOFS forcing scripts write their output
    export COMOUTrerun=${COMOUTrerun:-${COMOUT}/rerun}
    mkdir -p ${COMOUTrerun}

    # Time variables that STOFS forcing scripts expect
    # Derive from PDY/cyc if not already set
    _cyc_int=$((10#${cyc}))
    _ncast_hours=${NOWCAST_HOURS:-24}

    # Nowcast begins _ncast_hours before cycle time
    if command -v ndate &> /dev/null; then
        export PDYHH_NCAST_BEGIN=${PDYHH_NCAST_BEGIN:-$(ndate -${_ncast_hours} ${PDY}${cyc})}
        export PDYHH_FCAST_BEGIN=${PDYHH_FCAST_BEGIN:-${PDY}${cyc}}
        _fcast_hours=${FORECAST_HOURS:-108}
        export PDYHH_FCAST_END=${PDYHH_FCAST_END:-$(ndate ${_fcast_hours} ${PDY}${cyc})}
    else
        # Fallback: compute with python
        _times=$(python3 -c "
from datetime import datetime, timedelta
base = datetime.strptime('${PDY}${cyc}', '%Y%m%d%H')
nc_begin = base - timedelta(hours=${_ncast_hours})
fc_end = base + timedelta(hours=${FORECAST_HOURS:-108})
print(nc_begin.strftime('%Y%m%d%H'))
print(base.strftime('%Y%m%d%H'))
print(fc_end.strftime('%Y%m%d%H'))
")
        export PDYHH_NCAST_BEGIN=${PDYHH_NCAST_BEGIN:-$(echo "${_times}" | sed -n '1p')}
        export PDYHH_FCAST_BEGIN=${PDYHH_FCAST_BEGIN:-$(echo "${_times}" | sed -n '2p')}
        export PDYHH_FCAST_END=${PDYHH_FCAST_END:-$(echo "${_times}" | sed -n '3p')}
    fi

    echo "PDYHH_NCAST_BEGIN=${PDYHH_NCAST_BEGIN}"
    echo "PDYHH_FCAST_BEGIN=${PDYHH_FCAST_BEGIN}"
    echo "PDYHH_FCAST_END=${PDYHH_FCAST_END}"

    # wgrib2 path
    export WGRIB2=${WGRIB2:-$(which wgrib2 2>/dev/null || echo wgrib2)}

    for SOURCE in ${EXTRA_SOURCES}; do
        echo ""
        echo "=============================================="
        echo "Processing extra atmospheric source: ${SOURCE}"
        echo "=============================================="

        SOURCE_LC=$(echo "${SOURCE}" | tr '[:upper:]' '[:lower:]')

        # Set up working directory for this source
        export DATA_prep_${SOURCE_LC}=${DATA}/atmos_ensemble/${SOURCE_LC}
        mkdir -p ${DATA}/atmos_ensemble/${SOURCE_LC}

        # Find and run the STOFS script for this source
        FORCING_SCRIPT="${USHstofs3d}/stofs_3d_atl_create_surface_forcing_${SOURCE_LC}.sh"

        if [ ! -f "${FORCING_SCRIPT}" ]; then
            echo "ERROR: STOFS forcing script not found: ${FORCING_SCRIPT}" >&2
            echo "WARNING: Skipping ${SOURCE}"
            continue
        fi

        echo "Running: ${FORCING_SCRIPT}"
        bash ${FORCING_SCRIPT}
        rc=$?

        if [ $rc -ne 0 ]; then
            echo "ERROR: ${FORCING_SCRIPT} failed (exit code $rc)" >&2
            echo "WARNING: Skipping ${SOURCE}, ensemble members needing it will use fallback"
            continue
        fi

        # Verify output files in COMOUTrerun
        for var in air prc rad; do
            _outfile="${COMOUTrerun}/${RUN}.${cycle}.${SOURCE_LC}.${var}.nc"
            if [ -s "${_outfile}" ]; then
                echo "  OK: $(basename ${_outfile}) ($(stat -c%s "${_outfile}" 2>/dev/null || echo '?') bytes)"
            else
                echo "  MISSING: $(basename ${_outfile})"
            fi
        done
    done

    ########################################################
    # Process GEFS ensemble members (STOFS pipeline)
    # Uses stofs_3d_atl_create_surface_forcing_gefs.sh for
    # each GEFS member, running in parallel via cfp.
    # Output: ${RUN}.${cycle}.gefs_${ID}.{air,prc,rad}.nc
    ########################################################
    if [ -n "${GEFS_MEMBERS}" ]; then
        echo ""
        echo "=============================================="
        echo "Processing GEFS ensemble members: ${GEFS_MEMBERS}"
        echo "=============================================="
        echo "COMINgefs=${COMINgefs:-not set}"

        GEFS_FORCING_SCRIPT="${USHstofs3d}/stofs_3d_atl_create_surface_forcing_gefs.sh"

        if [ ! -f "${GEFS_FORCING_SCRIPT}" ]; then
            echo "ERROR: GEFS forcing script not found: ${GEFS_FORCING_SCRIPT}" >&2
            echo "GEFS ensemble atmospheric forcing will not be available"
        else
            # Build cfp command file for parallel GEFS processing
            # Each member gets its own work directory to avoid race conditions
            GEFS_CMDFILE=${DATA}/gefs_cmdfile
            cat /dev/null > ${GEFS_CMDFILE}
            GEFS_COUNT=0

            # Set COMOUT_PREV for fallback path in GEFS script
            if [ -z "${COMOUT_PREV:-}" ]; then
                _pdy_prev=$(date -d "${PDY} -1 day" +%Y%m%d 2>/dev/null || echo "")
                if [ -n "${_pdy_prev}" ]; then
                    export COMOUT_PREV=${COMOUTroot:-${COMROOT}/${NET}/${stofs_ver:-v2.1.0}}/${RUN}.${_pdy_prev}
                fi
            fi

            for GEFS_MEM in ${GEFS_MEMBERS}; do
                # Each member gets isolated DATA_prep_gefs to prevent cfp race conditions
                GEFS_MEM_WORKDIR=${DATA}/atmos_ensemble/gefs_${GEFS_MEM}
                mkdir -p ${GEFS_MEM_WORKDIR}
                echo "export GEFS_MEMBER=${GEFS_MEM}; export DATA_prep_gefs=${GEFS_MEM_WORKDIR}; bash ${GEFS_FORCING_SCRIPT}" >> ${GEFS_CMDFILE}
                (( GEFS_COUNT = GEFS_COUNT + 1 ))
            done

            echo "GEFS command file (${GEFS_COUNT} members):"
            cat ${GEFS_CMDFILE}

            # Run all GEFS members in parallel using cfp
            chmod 755 ${GEFS_CMDFILE}
            GEFS_NP=${GEFS_COUNT}
            GEFS_PPN=${GEFS_PPN:-8}
            if [ ${GEFS_NP} -gt ${GEFS_PPN} ]; then
                GEFS_NP=${GEFS_PPN}
            fi
            echo "Launching cfp with ${GEFS_NP} parallel tasks for ${GEFS_COUNT} GEFS members"
            mpiexec -n ${GEFS_NP} -ppn ${GEFS_NP} cfp ${GEFS_CMDFILE}
            rc=$?
            if [ $rc -ne 0 ]; then
                echo "WARNING: cfp GEFS processing returned exit code $rc" >&2
                echo "Some GEFS members may have failed. Continuing..."
            fi

            # Verify GEFS output files in COMOUTrerun
            echo ""
            echo "GEFS member outputs in COMOUTrerun:"
            GEFS_SUCCESS=0
            GEFS_FAIL=0
            for GEFS_MEM in ${GEFS_MEMBERS}; do
                _all_ok=true
                for var in air prc rad; do
                    _outfile="${COMOUTrerun}/${RUN}.${cycle}.gefs_${GEFS_MEM}.${var}.nc"
                    if [ -s "${_outfile}" ]; then
                        echo "  OK: $(basename ${_outfile})"
                    else
                        echo "  MISSING: $(basename ${_outfile})"
                        _all_ok=false
                    fi
                done
                if [ "${_all_ok}" = true ]; then
                    (( GEFS_SUCCESS = GEFS_SUCCESS + 1 ))
                else
                    (( GEFS_FAIL = GEFS_FAIL + 1 ))
                fi
            done
            echo "GEFS summary: ${GEFS_SUCCESS} succeeded, ${GEFS_FAIL} failed out of ${GEFS_COUNT}"
        fi
    fi

else
    ########################################################
    # COMF: Use nos_ofs_launch.sh + nos_ofs_create_forcing_met.sh
    # (existing behavior for SECOFS and other COMF OFS)
    ########################################################
    echo "=== Sourcing nos_ofs_launch.sh to set up environment ==="

    # COMF Fortran executables need NetCDF Fortran library preloaded
    if [ -n "${netcdf_ver:-}" ] && [ -n "${intel_ver:-}" ]; then
        export LD_PRELOAD=/apps/prod/netcdf/${netcdf_ver}/intel/${intel_ver}/lib/libnetcdff.so:${LD_PRELOAD}
    fi

    export pgm="$USHnos/nos_ofs_launch.sh $OFS prep"
    . $USHnos/nos_ofs_launch.sh $OFS prep
    rc=$?
    if [ $rc -ne 0 ]; then
        echo "ERROR: nos_ofs_launch.sh failed (exit code $rc)" >&2
        exit $rc
    fi

    echo "time_nowcastend=${time_nowcastend}"
    echo "time_forecastend=${time_forecastend}"

    ########################################################
    # Process each extra source (COMF pipeline)
    ########################################################
    # Stay in $DATA where nos_ofs_launch.sh already set up grid files,
    # control files, and other inputs the met script expects in CWD.
    # Do NOT cd to a subdirectory — the met script writes cmdfile to CWD
    # but references $DATA/cmdfile for chmod/mpiexec, so CWD must equal $DATA.

    # Save the original forecast tar name (set by nos_ofs_launch.sh)
    ORIG_MET_TAR="${MET_NETCDF_1_FORECAST}"

    for SOURCE in ${EXTRA_SOURCES}; do
        echo ""
        echo "=============================================="
        echo "Processing extra atmospheric source: ${SOURCE}"
        echo "=============================================="

        cd ${DATA}

        # Set met forcing parameters for this source
        export metnum=1
        export DBASE=${SOURCE}
        export MET_NUM=1
        export nfore=1

        # Override the output tar name (bare filename — the met script prepends
        # $DATA/ for creation and $COMOUT/ for archival internally)
        export MET_NETCDF_1_FORECAST="${PREFIXNOS}.${cycle}.${PDY}.met.forecast.${SOURCE}.nc.tar"

        TIME_START_TMP=${time_nowcastend}
        TIME_END_TMP=${time_forecastend}

        echo "DBASE=${DBASE}, metnum=${metnum}, nfore=${nfore}"
        echo "TIME_START=${TIME_START_TMP}, TIME_END=${TIME_END_TMP}"
        echo "Output tar: ${MET_NETCDF_1_FORECAST}"

        # Call the same met forcing script used by normal prep
        export pgm=nos_ofs_create_forcing_met.sh
        $USHnos/nos_ofs_create_forcing_met.sh forecast ${DBASE} ${TIME_START_TMP} ${TIME_END_TMP}
        rc=$?
        if [ $rc -ne 0 ]; then
            echo "ERROR: nos_ofs_create_forcing_met.sh failed for ${SOURCE} (exit code $rc)" >&2
            echo "WARNING: Skipping ${SOURCE}, ensemble members needing it will use fallback"
            continue
        fi

        echo "Met forcing generation completed for ${SOURCE}"

        # The met script already copies the tar to $COMOUT/$MET_NETCDF_1_FORECAST.
        # Verify it arrived. Also copy to $DATA for the J-job's own reference.
        COMOUT_TAR="${COMOUT}/${MET_NETCDF_1_FORECAST}"
        DEST_TAR="${COMOUT}/${PREFIXNOS}.${cycle}.${PDY}.met.forecast.${SOURCE}.tar"

        if [ -f "${COMOUT_TAR}" ]; then
            # Rename from .nc.tar to final name if they differ
            if [ "${COMOUT_TAR}" != "${DEST_TAR}" ]; then
                mv "${COMOUT_TAR}" "${DEST_TAR}"
            fi
            echo "Archived: ${DEST_TAR}"
            ls -la "${DEST_TAR}"
        elif [ -f "${DATA}/${MET_NETCDF_1_FORECAST}" ]; then
            # Fallback: met script left it in $DATA instead of copying
            cp "${DATA}/${MET_NETCDF_1_FORECAST}" "${DEST_TAR}"
            echo "Archived (from DATA): ${DEST_TAR}"
            ls -la "${DEST_TAR}"
        else
            echo "ERROR: No met forecast tar found for ${SOURCE}" >&2
            ls -la ${COMOUT}/*.tar ${DATA}/*.tar 2>/dev/null || true
        fi
    done

    # Restore original tar name
    export MET_NETCDF_1_FORECAST="${ORIG_MET_TAR}"

    ########################################################
    # Process GEFS ensemble members (COMF pipeline)
    # Uses nos_ofs_create_forcing_met.sh with DBASE=GEFS
    # and GEFS_MEMBER env var for each member, running in
    # parallel via cfp.
    # Output: ${PREFIXNOS}.${cycle}.${PDY}.met.forecast.GEFS_gep${NN}.nc.tar
    ########################################################
    if [ -n "${GEFS_MEMBERS}" ]; then
        echo ""
        echo "=============================================="
        echo "Processing GEFS ensemble members: ${GEFS_MEMBERS}"
        echo "=============================================="
        echo "COMINgefs=${COMINgefs:-not set}"

        # Build cfp command file for parallel GEFS member processing
        # Each line runs a wrapper script for one GEFS member
        GEFS_CMDFILE=${DATA}/gefs_cmdfile
        cat /dev/null > ${GEFS_CMDFILE}

        # Create a wrapper script that each cfp task will execute.
        # The wrapper sets member-specific env vars, runs the met script,
        # then renames the output tar to include the GEFS member ID.
        GEFS_WRAPPER=${DATA}/gefs_member_wrapper.sh
        cat > ${GEFS_WRAPPER} << 'GEFSWRAPEOF'
#!/bin/bash
set -x
# Arguments: GEFS_MEMBER_ID (e.g., "01", "02", "c00")
GEFS_MEM_ID=${1:?}

# Determine prefix for filenames (gec00 for control, gep01-gep30 for perturbation)
if [ "${GEFS_MEM_ID}" = "c00" ] || [ "${GEFS_MEM_ID}" = "00" ]; then
    GEFS_MEM_PREFIX="gec00"
else
    GEFS_MEM_PREFIX="gep$(printf '%02d' "${GEFS_MEM_ID}" 2>/dev/null || echo "${GEFS_MEM_ID}")"
fi

# Set up working directory for this member to avoid collision
MEMBER_WORK=${DATA}/gefs_member_${GEFS_MEM_ID}
mkdir -p ${MEMBER_WORK}
cd ${MEMBER_WORK}

# Symlink required input files from $DATA (grid files, control files, etc.)
for f in ${DATA}/*.dat ${DATA}/*.ctl ${DATA}/*.gr3 ${DATA}/*.in ${DATA}/*.ll; do
    [ -f "${f}" ] && ln -sf "${f}" ${MEMBER_WORK}/ 2>/dev/null
done

# Set member-specific env vars
export DBASE=GEFS
export GEFS_MEMBER=${GEFS_MEM_ID}
export GEFS_MEMBER_ID=${GEFS_MEM_PREFIX}
export metnum=1
export MET_NUM=1
export nfore=1
export DATA=${MEMBER_WORK}
export MET_NETCDF_1_FORECAST="${PREFIXNOS}.${cycle}.${PDY}.met.forecast.GEFS_${GEFS_MEM_PREFIX}.nc.tar"

echo "Processing GEFS member ${GEFS_MEM_ID} (prefix=${GEFS_MEM_PREFIX})"
echo "Output tar: ${MET_NETCDF_1_FORECAST}"

# Disable internal MPMD cfp inside met script (we are already inside cfp)
export RUN_MPMD=NO

# Run the met forcing script
${USHnos}/nos_ofs_create_forcing_met.sh forecast GEFS ${time_nowcastend} ${time_forecastend}
rc=$?

if [ $rc -ne 0 ]; then
    echo "ERROR: GEFS member ${GEFS_MEM_ID} met forcing failed (rc=$rc)" >&2
    exit $rc
fi

# Archive the output tar to COMOUT
DEST_TAR="${COMOUT}/${PREFIXNOS}.${cycle}.${PDY}.met.forecast.GEFS_${GEFS_MEM_PREFIX}.nc.tar"
if [ -f "${MEMBER_WORK}/${MET_NETCDF_1_FORECAST}" ]; then
    cp "${MEMBER_WORK}/${MET_NETCDF_1_FORECAST}" "${DEST_TAR}"
    echo "Archived GEFS member ${GEFS_MEM_ID}: ${DEST_TAR}"
elif [ -f "${COMOUT}/${MET_NETCDF_1_FORECAST}" ]; then
    # Met script may have already copied it
    if [ "${COMOUT}/${MET_NETCDF_1_FORECAST}" != "${DEST_TAR}" ]; then
        mv "${COMOUT}/${MET_NETCDF_1_FORECAST}" "${DEST_TAR}"
    fi
    echo "Archived GEFS member ${GEFS_MEM_ID}: ${DEST_TAR}"
else
    echo "ERROR: No output tar found for GEFS member ${GEFS_MEM_ID}" >&2
    exit 1
fi
GEFSWRAPEOF
        chmod 755 ${GEFS_WRAPPER}

        # Build command file: one line per GEFS member
        GEFS_COUNT=0
        for GEFS_MEM in ${GEFS_MEMBERS}; do
            echo "${GEFS_WRAPPER} ${GEFS_MEM}" >> ${GEFS_CMDFILE}
            (( GEFS_COUNT = GEFS_COUNT + 1 ))
        done

        echo "GEFS command file (${GEFS_COUNT} members):"
        cat ${GEFS_CMDFILE}

        # Run all GEFS members in parallel using cfp
        chmod 755 ${GEFS_CMDFILE}
        GEFS_NP=${GEFS_COUNT}
        GEFS_PPN=${GEFS_PPN:-8}
        # Cap at available MPI ranks
        if [ ${GEFS_NP} -gt ${GEFS_PPN} ]; then
            GEFS_NP=${GEFS_PPN}
        fi
        echo "Launching cfp with ${GEFS_NP} parallel tasks for ${GEFS_COUNT} GEFS members"
        mpiexec -n ${GEFS_NP} -ppn ${GEFS_NP} cfp ${GEFS_CMDFILE}
        rc=$?
        if [ $rc -ne 0 ]; then
            echo "WARNING: cfp GEFS processing returned exit code $rc" >&2
            echo "Some GEFS members may have failed. Continuing..."
        fi

        # Verify GEFS output tars
        echo ""
        echo "GEFS member tars in COMOUT:"
        GEFS_SUCCESS=0
        GEFS_FAIL=0
        for GEFS_MEM in ${GEFS_MEMBERS}; do
            if [ "${GEFS_MEM}" = "c00" ] || [ "${GEFS_MEM}" = "00" ]; then
                _tag="gec00"
            else
                _tag="gep$(printf '%02d' "${GEFS_MEM}" 2>/dev/null || echo "${GEFS_MEM}")"
            fi
            GEFS_TAR="${COMOUT}/${PREFIXNOS}.${cycle}.${PDY}.met.forecast.GEFS_${_tag}.nc.tar"
            if [ -f "${GEFS_TAR}" ]; then
                echo "  OK: $(basename ${GEFS_TAR}) ($(stat -c%s "${GEFS_TAR}" 2>/dev/null || echo '?') bytes)"
                (( GEFS_SUCCESS = GEFS_SUCCESS + 1 ))
            else
                echo "  MISSING: $(basename ${GEFS_TAR})"
                (( GEFS_FAIL = GEFS_FAIL + 1 ))
            fi
        done
        echo "GEFS summary: ${GEFS_SUCCESS} succeeded, ${GEFS_FAIL} failed out of ${GEFS_COUNT}"
    fi
fi

########################################################
# Summary
########################################################
echo ""
echo "=== Atmospheric ensemble prep complete ==="

if [ -n "${EXTRA_SOURCES}" ]; then
    echo "Extra source tars in COMOUT:"
    for SOURCE in ${EXTRA_SOURCES}; do
        tar_file="${COMOUT}/${PREFIXNOS}.${cycle}.${PDY}.met.forecast.${SOURCE}.tar"
        if [ -f "${tar_file}" ]; then
            echo "  OK: $(basename ${tar_file}) ($(stat -c%s "${tar_file}" 2>/dev/null || echo '?') bytes)"
        else
            echo "  MISSING: $(basename ${tar_file})"
        fi
    done
fi

if [ -n "${GEFS_MEMBERS}" ]; then
    echo "GEFS member outputs:"
    for GEFS_MEM in ${GEFS_MEMBERS}; do
        if [ "${GEFS_MEM}" = "c00" ] || [ "${GEFS_MEM}" = "00" ]; then
            _tag="gec00"
        else
            _tag="gep$(printf '%02d' "${GEFS_MEM}" 2>/dev/null || echo "${GEFS_MEM}")"
        fi
        if [ "${OFS_FRAMEWORK}" = "stofs" ]; then
            # STOFS: check individual NetCDFs in COMOUTrerun
            _ok=true
            for var in air prc rad; do
                _f="${COMOUTrerun:-${COMOUT}/rerun}/${RUN}.${cycle}.gefs_${GEFS_MEM}.${var}.nc"
                [ ! -s "${_f}" ] && _ok=false
            done
            if [ "${_ok}" = true ]; then
                echo "  OK: gefs_${GEFS_MEM} (air/prc/rad in COMOUTrerun)"
            else
                echo "  MISSING: gefs_${GEFS_MEM}"
            fi
        else
            # COMF: check tar in COMOUT
            tar_file="${COMOUT}/${PREFIXNOS}.${cycle}.${PDY}.met.forecast.GEFS_${_tag}.nc.tar"
            if [ -f "${tar_file}" ]; then
                echo "  OK: $(basename ${tar_file}) ($(stat -c%s "${tar_file}" 2>/dev/null || echo '?') bytes)"
            else
                echo "  MISSING: $(basename ${tar_file})"
            fi
        fi
    done
fi

