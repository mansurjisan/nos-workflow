#!/bin/bash
set -x

########################################
# NOS_OFS_PREP - Unified Prep Job
#
# Supports both nosofs/COMF and IT-STOFS frameworks with YAML configuration
########################################
export PS4=' $SECONDS + '
date

########################################
# Load shared library if available
########################################
export LD_PRELOAD=${LD_PRELOAD:-}
if [ -n "${netcdf_ver:-}" ] && [ -n "${intel_ver:-}" ]; then
    export LD_PRELOAD=/apps/prod/netcdf/${netcdf_ver}/intel/${intel_ver}/lib/libnetcdff.so:${LD_PRELOAD}
fi

########################################
# Set HOME directories
########################################
# Support both nosofs and stofs naming conventions
export HOMEnos=${HOMEnos:-${HOMEstofs:-${PACKAGEROOT}/nos_ofs.${nos_ofs_ver:?}}}
export HOMEstofs=${HOMEstofs:-${HOMEnos}}

###################################
# Specify NET and RUN Name and model
####################################
export NET=${NET:-nosofs}
export RUN=${RUN:-$OFS}
export PREFIXNOS=${PREFIXNOS:-$OFS}
export CONTINUE_FORECAST=${CONTINUE_FORECAST:-NO}
export SENDDBN=${SENDDBN:-NO}

###############################################################
# Specify DBN_ALERT_TYPE
###############################################################
export DBN_ALERT_TYPE_NETCDF=${DBN_ALERT_TYPE_NETCDF:-NOS_OFS_FCST_NETCDF}
export DBN_ALERT_TYPE_NETCDF_LRG=${DBN_ALERT_TYPE_NETCDF_LRG:-NOS_OFS_FCST_NETCDF_LP}
export DBN_ALERT_TYPE_TEXT=${DBN_ALERT_TYPE_TEXT:-NOS_OFS_FCST_TEXT}

export cycle=t${cyc}z

########################################################
# Make working directory
########################################################
export DATA=${DATA:-${DATAROOT:?}/${jobid:?}}

# Clean up existing working directories for new cycle
echo "Check for existing working directory for nos_${OFS}_*_${cyc}_${envir}"
ls -ltrd ${DATAROOT:?}/nos_${OFS}_*_${cyc}_${envir}* 2> /dev/null
isWKDirsExist=$?
if [ $isWKDirsExist -eq 0 ]; then
    echo "WARNING! Some working directories for nos_${OFS} in ${cyc} $envir exist, moving before starting prep job"
    renameTag=$(date +%Y%m%d%H%M)
    for dir in $(ls -d ${DATAROOT:?}/nos_${OFS}_*_${cyc}_${envir}* 2>/dev/null); do
        mv $dir ${dir}_${renameTag}
    done
fi

if [ ! -d $DATA ]; then
    mkdir -p $DATA
    cd $DATA
else
    cd $DATA
    rm -fr $DATA/*
fi

############################################
# Determine Job Output Name on System
############################################
export pgmout="OUTPUT.$$"
export jlogfile=${logfile:-${DATA}/jlogfile}

####################################
# Specify Execution Areas (unified paths)
####################################
export EXECnos=${EXECnos:-${HOMEnos}/exec}
export FIXnos=${FIXnos:-${HOMEnos}/fix/shared}
export FIXofs=${FIXofs:-${HOMEnos}/fix/${OFS}}
export PARMnos=${PARMnos:-${HOMEnos}/parm}
export USHnos=${USHnos:-${HOMEnos}/ush}
export SCRIPTSnos=${SCRIPTSnos:-${HOMEnos}/scripts}

# IT-STOFS specific paths
export EXECstofs3d=${EXECstofs3d:-${HOMEstofs}/exec}
export FIXstofs3d=${FIXstofs3d:-${HOMEstofs}/fix/stofs_3d_atl}
export USHstofs3d=${USHstofs3d:-${HOMEstofs}/ush/stofs_3d_atl}
export PYstofs3d=${PYstofs3d:-${HOMEstofs}/ush/python}

####################################
# YAML Configuration Loading
####################################
# Determine OFS type and load appropriate config
case "${OFS,,}" in
    stofs_3d_atl|stofs_3d_pac)
        export OFS_FRAMEWORK="stofs"
        export OFS_CONFIG="${OFS_CONFIG:-${PARMnos}/systems/${OFS}.yaml}"
        if [ -f "${USHstofs3d}/stofs_3d_atl_config.sh" ]; then
            source "${USHstofs3d}/stofs_3d_atl_config.sh"
            load_stofs_config "${OFS_CONFIG}"
        fi
        ;;
    secofs|creofs)
        export OFS_FRAMEWORK="comf"
        export OFS_CONFIG="${OFS_CONFIG:-${PARMnos}/systems/${OFS}.yaml}"
        if [ -f "${USHnos}/nosofs/nos_ofs_config.sh" ]; then
            source "${USHnos}/nosofs/nos_ofs_config.sh"
            load_nosofs_config "${OFS_CONFIG}"
        fi
        ;;
    *)
        export OFS_FRAMEWORK="comf"
        export OFS_CONFIG="${OFS_CONFIG:-${FIXofs}/${OFS}.yaml}"
        # Fall back to legacy .ctl loading if no YAML
        if [ -f "${USHnos}/nosofs/nos_ofs_config.sh" ]; then
            source "${USHnos}/nosofs/nos_ofs_config.sh"
            load_nosofs_config "${OFS_CONFIG}" || true
        fi
        ;;
esac

echo "OFS Framework: ${OFS_FRAMEWORK}"
echo "OFS Config: ${OFS_CONFIG:-none}"

###########################################
# Run setpdy and initialize PDY variables
###########################################
if command -v setpdy.sh &> /dev/null; then
    setpdy.sh
    . PDY
fi
export PDY=${PDY:-$(date +%Y%m%d)}
export time_nowcastend=$PDY${cyc}

##############################################
# Define COM directories
##############################################
export COMROOT=${COMROOT:-/lfs/h1/ops/${envir}/com}
export DCOMROOT=${DCOMROOT:-/lfs/h1/ops/${envir}/dcom}

if command -v compath.py &> /dev/null; then
    export COMIN=${COMIN:-$(compath.py ${NET}/${nos_ofs_ver})/${RUN}.${PDY}}
    export COMOUTroot=${COMOUTroot:-$(compath.py -o ${NET}/${nos_ofs_ver})}
    export COMOUT=${COMOUT:-$(compath.py -o ${NET}/${nos_ofs_ver})/${RUN}.${PDY}}
else
    export COMIN=${COMIN:-${COMROOT}/${NET}/${nos_ofs_ver}/${RUN}.${PDY}}
    export COMOUTroot=${COMOUTroot:-${COMROOT}/${NET}/${nos_ofs_ver}}
    export COMOUT=${COMOUT:-${COMOUTroot}/${RUN}.${PDY}}
fi

mkdir -m 775 -p $COMOUT

##############################################
# Set up input data paths
##############################################
if command -v compath.py &> /dev/null; then
    export COMINnam=${COMINnam:-$(compath.py prod/nam/${nam_ver:-v4.2})}
    export COMINhrrr=${COMINhrrr:-$(compath.py prod/hrrr/${hrrr_ver:-v4.1})}
    export COMINrap=${COMINrap:-$(compath.py prod/rap/${rap_ver:-v5.1})}
    export COMINrtma=${COMINrtma:-$(compath.py prod/rtma/${rtma_ver:-v2.8})}
    export COMINgfs=${COMINgfs:-$(compath.py prod/gfs/${gfs_ver:-v16.3})}
    export COMINrtofs_2d=${COMINrtofs_2d:-$(compath.py prod/rtofs/${rtofs_ver:-v2.3})}
    export COMINrtofs_3d=${COMINrtofs_3d:-$(compath.py prod/rtofs/${rtofs_ver:-v2.3})}
    export COMINnwm=${COMINnwm:-$(compath.py prod/nwm/${nwm_ver:-v3.0})}
fi

export DCOMINndfd=${DCOMROOT:-}
export DCOMINncom=${DCOMROOT:-}
export DCOMINusgs=${DCOMROOT:-}
export DCOMINports=${DCOMROOT:-}

##################################################################
# Log Files
##################################################################
export nosjlogfile=${COMOUT}/${PREFIXNOS}.${cycle}.${PDY}.jlogfile.log
export cormslogfile=${COMOUT}/${PREFIXNOS}.${cycle}.${PDY}.corms.log

env

########################################################
# Execute the appropriate script based on framework
########################################################
case "${OFS_FRAMEWORK}" in
    stofs)
        # IT-STOFS prep script
        if [ -f "${SCRIPTSnos}/stofs_3d_atl/exstofs_3d_atl_prep_processing.sh" ]; then
            ${SCRIPTSnos}/stofs_3d_atl/exstofs_3d_atl_prep_processing.sh
        else
            echo "ERROR: STOFS prep script not found" >&2
            exit 1
        fi
        ;;
    comf|*)
        # nosofs/COMF prep script
        if [ -f "${SCRIPTSnos}/nosofs/exnos_ofs_prep.sh" ]; then
            ${SCRIPTSnos}/nosofs/exnos_ofs_prep.sh $OFS
        else
            echo "ERROR: nosofs prep script not found" >&2
            exit 1
        fi
        ;;
esac

########################################################
# Post-processing
########################################################
cat $pgmout

if command -v postmsg &> /dev/null; then
    postmsg "$jlogfile" "$0 completed normally"
fi

##############################
# Remove the Temporary working directory
##############################
if [ "${KEEPDATA^^}" != YES ]; then
    rm -rf $DATA
fi

date
