%include <head.h>
########################################
# jnos_ofs_post.ecf - NOS-OFS Post-Processing Job
#
# Generic ecFlow script for post-processing model output.
# Supports both COMF single-phase and STOFS two-phase post.
#
# For STOFS: %POST_STAGE% controls which phase runs (1 or 2)
#   post_1: Extract 2D fields, station timeseries
#   post_2: Generate ADCIRC-format NetCDF, GeoPackage, AWIPS/SHEF
# For COMF: Single post-processing stage (POST_STAGE=1)
#
# ecFlow Variables Used:
#   %OFS%          - OFS system name
#   %CYC%          - Cycle hour (00, 06, 12, 18)
#   %NET%          - Network name (nosofs or stofs)
#   %ENVIR%        - Environment (prod, dev)
#   %NOSOFS_VER%   - Package version
#   %PACKAGEROOT%  - Package installation root
#   %COMROOT%      - COM output root
#   %DCOMROOT%     - DCOM input root
#   %DATAROOT%     - Working directory root
#   %KEEPDATA%     - YES/NO
#   %VER_FILE%     - Version file path
#   %POST_STAGE%   - Post-processing stage (1 or 2, for STOFS)
########################################

#PBS -N %OFS%_post%POST_STAGE:1%_%CYC%
#PBS -A %ACCOUNT:NOSOFS-DEV%
#PBS -q %QUEUE:dev%
#PBS -o %RPTDIR:ECF_HOME%/%OFS%_post%POST_STAGE:1%_%CYC%.out
#PBS -e %RPTDIR:ECF_HOME%/%OFS%_post%POST_STAGE:1%_%CYC%.err
#PBS -l %RESOURCES_POST:select=1:ncpus=8:mpiprocs=8%
#PBS -l place=vscatter
#PBS -l walltime=%WALLTIME_POST:01:00:00%

########################################
# Source version file
########################################
. %PACKAGEROOT%/nosofs.%NOSOFS_VER%/versions/%VER_FILE%

########################################
# Module setup
########################################
module purge
module load envvar/${envvar_ver:-1.0}
module load intel/${intel_ver:-19.1.3.304}
module load PrgEnv-intel/${PrgEnv_intel_ver:-8.3.3}
module load craype/${craype_ver:-2.7.17}
module load cray-mpich/${cray_mpich_ver:-8.1.12}
module load cray-pals/${cray_pals_ver:-1.2.2}
module load hdf5/${hdf5_ver:-1.10.6}
module load netcdf/${netcdf_ver:-4.7.4}
module load jasper/${jasper_ver:-2.0.25}
module load udunits/${udunits_ver:-2.2.28}
module load zlib/${zlib_ver:-1.2.11}
module load bufr/${bufr_ver:-11.6.0}
module load g2/${g2_ver:-3.4.5}
module load w3nco/${w3nco_ver:-2.4.1}
module load w3emc/${w3emc_ver:-2.9.2}
module load subversion/${subversion_ver:-1.14.0}
module load python/${python_ver:-3.8.6}
module load prod_envir/${prod_envir_ver:-2.0.6}
module load prod_util/${prod_util_ver:-2.0.17}

# STOFS virtual environment (only for stofs_3d systems)
if [ -n "${ve_stofs:-}" ]; then
    module load ve/stofs/${ve_stofs}
fi

module load cfp/${cfp_ver:-2.0.4}
module load libjpeg/${libjpeg_ver:-9c}
module load grib_util/${grib_util_ver:-1.2.4}
module load gsl/${gsl_ver:-2.7}
module load wgrib2/${wgrib2_ver:-2.0.8}
module load nco/${nco_ver:-4.9.7}

module list

########################################
# Environment exports
########################################
set +x
export envir=%ENVIR%
export OFS=%OFS%
export cyc=%CYC%
export NET=%NET%
export model=%NET%
export POST_STAGE=%POST_STAGE:1%

export KEEPDATA=%KEEPDATA:YES%
export SENDCOM=%SENDCOM:YES%
export SENDDBN=%SENDDBN:NO%
export SENDSMS=%SENDSMS:NO%

export nosofs_ver=%NOSOFS_VER%
export PACKAGEROOT=%PACKAGEROOT%

########################################
# Data and COM paths
########################################
export COMROOT=%COMROOT%
export DCOMROOT=%DCOMROOT%
export DATAROOT=%DATAROOT%

########################################
# Input data paths (production WCOSS2)
########################################
export COMINnam=/lfs/h1/ops/prod/com/nam/${nam_ver:-v4.2}
export COMINhrrr=/lfs/h1/ops/prod/com/hrrr/${hrrr_ver:-v4.1}
export COMINrap=/lfs/h1/ops/prod/com/rap/${rap_ver:-v5.1}
export COMINgfs=/lfs/h1/ops/prod/com/gfs/${gfs_ver:-v16.3}
export COMINrtma=/lfs/h1/ops/prod/com/rtma/${rtma_ver:-v2.8}
export COMINetss=/lfs/h1/ops/prod/com/petss/${petss_ver:-v1.2}
export COMINrtofs_2d=/lfs/h1/ops/prod/com/rtofs/${rtofs_ver:-v2.5}
export COMINrtofs_3d=/lfs/h1/ops/prod/com/rtofs/${rtofs_ver:-v2.5}
export COMINnwm=/lfs/h1/ops/prod/com/nwm/${nwm_ver:-v3.0}

########################################
# YAML configuration
########################################
export HOMEnos=%PACKAGEROOT%/nosofs.%NOSOFS_VER%
export OFS_CONFIG=${HOMEnos}/parm/systems/%OFS%.yaml
export PYTHONPATH=${HOMEnos}/ush/python:${PYTHONPATH:-}

########################################
# Execute J-job
########################################
${HOMEnos}/jobs/JNOS_OFS_POST

%include <tail.h>
