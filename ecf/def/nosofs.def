suite nosofs
  # -----------------------------------------------------------
  # Suite-level variables (inherited by all families and tasks)
  # -----------------------------------------------------------
  edit ENVIR 'prod'
  edit PACKAGEROOT '/lfs/h1/nos/nosofs/noscrub/packages'
  edit NOSOFS_VER 'v3.7.0'
  edit COMROOT '/lfs/h1/ops/prod/com'
  edit DCOMROOT '/lfs/h1/ops/prod/dcom'
  edit KEEPDATA 'NO'
  edit SENDCOM 'YES'
  edit SENDDBN 'YES'
  edit ECF_FILES '%PACKAGEROOT%/nosofs.%NOSOFS_VER%/ecf'
  edit ECF_INCLUDE '%PACKAGEROOT%/nosofs.%NOSOFS_VER%/ecf/include'
  edit ECF_TRIES '2'
  limit max_jobs 20

  # ==========================================================
  # STOFS_3D_ATL (STOFS framework)
  # ==========================================================
  family stofs_3d_atl
    edit OFS 'stofs_3d_atl'
    edit NET 'stofs'
    edit VER_FILE 'stofs_3d_atl/run.ver'

    family cyc12
      edit CYC '12'
      cron 12:00

      task prep
        edit ECF_JOB_CMD '%ECF_FILES%/jnos_ofs_prep.ecf'
        edit RESOURCES 'select=1:ncpus=8:mpiprocs=8'
        edit WALLTIME '01:30:00'
        inlimit /nosofs:max_jobs

      task nowcast
        edit ECF_JOB_CMD '%ECF_FILES%/jnos_ofs_nowcast.ecf'
        edit RESOURCES 'select=20:ncpus=128:mpiprocs=120'
        edit WALLTIME '06:00:00'
        trigger prep == complete
        inlimit /nosofs:max_jobs

      task forecast
        edit ECF_JOB_CMD '%ECF_FILES%/jnos_ofs_forecast.ecf'
        edit RESOURCES 'select=20:ncpus=128:mpiprocs=120'
        edit WALLTIME '06:00:00'
        trigger nowcast == complete
        inlimit /nosofs:max_jobs

      task post_1
        edit ECF_JOB_CMD '%ECF_FILES%/jnos_ofs_post.ecf'
        edit RESOURCES 'select=1:ncpus=8:mpiprocs=8'
        edit WALLTIME '01:00:00'
        edit POST_STAGE '1'
        trigger forecast == complete
        inlimit /nosofs:max_jobs

      task post_2
        edit ECF_JOB_CMD '%ECF_FILES%/jnos_ofs_post.ecf'
        edit RESOURCES 'select=1:ncpus=8:mpiprocs=8'
        edit WALLTIME '01:00:00'
        edit POST_STAGE '2'
        trigger post_1 == complete
        inlimit /nosofs:max_jobs
    endfamily
  endfamily

  # ==========================================================
  # STOFS_3D_PAC (STOFS framework)
