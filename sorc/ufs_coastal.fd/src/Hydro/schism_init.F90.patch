--- schism_init.F90.orig
+++ schism_init.F90
@@ Lines 6080-6090: ihot=1 time reset section @@

 Original code:
 ~~~~~~~~~~~~~
 !...    change time and iteration for forecast mode
 !...    Causion: this affects all t.h. files (fort.5[0-3]) and wind files
         if(ihot==1) then
           time=0.d0
           iths=0
         endif

         if(myrank==0) then
           write(16,*)'hot start at time=',time,iths
           call flush(16)
         endif

 Modified code:
 ~~~~~~~~~~~~~
 !...    change time and iteration for forecast mode
 !...    Causion: this affects all t.h. files (fort.5[0-3]) and wind files
         if(ihot==1) then
           !------------------------------------------------------------
           ! FIX: Save hotstart time for tidal phase correction.
           ! When ihot=1, SCHISM resets time=0 but the interior state
           ! (eta2, velocities) was computed at the hotstart time.
           ! Without correction, tidal BCs at time~0 have the wrong
           ! phase, creating ~0.2m gravity wave transient.
           !
           ! Solution: Shift the tidal equilibrium argument (face) by
           ! amig*time_hotstart so that tidal BCs at time=0 produce
           ! the same phase as they would at the true hotstart time.
           !------------------------------------------------------------
           time_hotstart = time  ! Save before reset (from hotstart.nc)
           time=0.d0
           iths=0

           ! Adjust tidal equilibrium arguments for the time offset
           if(nbfr > 0) then
             do i=1,nbfr
               face(i) = face(i) + amig(i) * time_hotstart
             enddo
             if(myrank==0) then
               write(16,*) 'ihot=1 tidal phase fix: time_hotstart=', &
                 time_hotstart, ' sec, adjusted face for', nbfr, 'constituents'
               call flush(16)
             endif
           endif
         endif

         if(myrank==0) then
           write(16,*)'hot start at time=',time,iths
           call flush(16)
         endif

 Notes:
 - time_hotstart is declared in schism_glbl.F90 (already use'd by schism_init)
 - face(:), amig(:), nbfr are already available at this point (read from bctides.in earlier)
 - This shifts ALL tidal calculations (elevation BC, velocity BC, tidal potential)
   to the correct absolute phase
 - No changes needed in schism_step.F90 — it uses face(:) transparently
 - Ramp functions are unaffected (they use time=0 which is correct for ihot=1 startup)
 - .th file reading is unaffected (time series files start at time=0 for ihot=1)
