# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Build artifacts
docs/_build/
*.so
*.o
*.mod

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Runtime
*.log
*.tmp
*.bak

# Mesh / NetCDF (these stay on WCOSS2 — too large for git)
*.nc
fix/secofs_ufs/*.gr3
fix/secofs_ufs/*.ll
fix/secofs_ufs/*.in
fix/secofs_ufs/*.dat
fix/secofs_ufs/*.json
fix/secofs_ufs/*.bp
fix/secofs_ufs/*.csv
fix/secofs_ufs/*.txt
fix/secofs_ufs/*.nco
# But DO keep the templates and configs we copied
!fix/secofs_ufs/*.template
!fix/secofs_ufs/secofs_ufs.param.nml
!fix/secofs_ufs/fd_ufs.yaml
!fix/secofs_ufs/ufs.configure
!fix/secofs_ufs/noahmptable.tbl
# 3 KB of derived lookup, regenerated by nos_workflow.tools.build_mllw_table;
# small enough to review in a diff and it must not drift from station.in
!fix/secofs_ufs/secofs_ufs.mllw_datum.csv

# STOFS-3D-AK statics. tools/fetch_stofs_3d_ak_fix.sh stages ~2.6 GB here
# (vgrid.in alone is 1.0 GB), so ignore the payload and keep only the
# shipped templates. *.prop covers partition.prop / tvd.prop.
fix/stofs_3d_ak_ufs/*.gr3
fix/stofs_3d_ak_ufs/*.ll
fix/stofs_3d_ak_ufs/*.in
fix/stofs_3d_ak_ufs/*.prop
fix/stofs_3d_ak_ufs/*.dat
fix/stofs_3d_ak_ufs/*.json
fix/stofs_3d_ak_ufs/*.csv
fix/stofs_3d_ak_ufs/*.txt
fix/stofs_3d_ak_ufs/r09a_reference/
!fix/stofs_3d_ak_ufs/*.template
!fix/stofs_3d_ak_ufs/stofs_3d_ak_ufs.param.nml
!fix/stofs_3d_ak_ufs/fd_ufs.yaml
!fix/stofs_3d_ak_ufs/ufs.configure
!fix/stofs_3d_ak_ufs/noahmptable.tbl
!fix/stofs_3d_ak_ufs/stofs_3d_ak_staout_nc.json
!fix/stofs_3d_ak_ufs/stofs_3d_ak_staout_nc.csv
# 3-KB derived lookup, regenerated by tools/gen_ak_datum_offsets.py; small
# enough to review in a diff, same precedent as secofs_ufs's mllw_datum.csv
!fix/stofs_3d_ak_ufs/stofs_3d_ak_ufs.mllw_datum.csv

# SECOFS-UFS-WW3 (DATM+SCHISM+WW3) statics. Same convention as
# fix/secofs_ufs/: keep only the small config/template files reviewable in
# git. The shared SCHISM mesh/grid/forcing statics are deployed WCOSS2-side
# from fix/secofs_ufs/ (system.prefix is unchanged, "secofs_ufs", so the
# filenames match); the WW3-specific binaries (mod_def.ww3, the WAV ESMF
# mesh, the .msh grid file) are also WCOSS2-side, too large for git.
fix/secofs_ufs_ww3/*.gr3
fix/secofs_ufs_ww3/*.ll
fix/secofs_ufs_ww3/*.in
fix/secofs_ufs_ww3/*.dat
fix/secofs_ufs_ww3/*.json
fix/secofs_ufs_ww3/*.csv
fix/secofs_ufs_ww3/*.txt
fix/secofs_ufs_ww3/*.ww3
fix/secofs_ufs_ww3/*.msh
!fix/secofs_ufs_ww3/*.template
!fix/secofs_ufs_ww3/secofs_ufs_ww3.param.nml
!fix/secofs_ufs_ww3/fd_ufs.yaml
!fix/secofs_ufs_ww3/ufs.configure
!fix/secofs_ufs_ww3/noahmptable.tbl
!fix/secofs_ufs_ww3/ww3_shel.nml
!fix/secofs_ufs_ww3/ww3_grid.nml
!fix/secofs_ufs_ww3/secofs_ufs_ww3.namelists_pdlib.nml

# Shell pgmout artifacts. Both spellings occur and neither covers the other:
# the J-jobs `export pgmout="OUTPUT.$$"` in bash, where $$ expands to the pid,
# so a real run leaves OUTPUT.<pid>; the Python default (env.py, stages/post.py)
# is the literal string, so a run with pgmout unset leaves OUTPUT.$$ itself.
OUTPUT.$$
OUTPUT.[0-9]*
