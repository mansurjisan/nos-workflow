// Note: adding a label does NOT create a new PR revision, so periodic scan
// may not rebuild automatically -- push a commit, or click Build Now / Scan Repository Now.

// On a PR build, statuses must target the PR head SHA -- env.GIT_COMMIT is the ephemeral PR-merge commit, which 422s once the merge ref moves.
def resolveTargetSha() {
    if (!env.CHANGE_ID?.trim()) {
        return env.GIT_COMMIT ?: ''
    }
    try {
        return pullRequest.head
    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
        throw fie
    } catch (err) {
        echo "resolveTargetSha: warning - pullRequest.head unavailable (${err}), falling back to GitHub API"
    }
    try {
        def sha = ''
        withCredentials([string(credentialsId: 'github-status-token', variable: 'GH_TOKEN')]) {
            withEnv(["GH_CHANGE_ID=${env.CHANGE_ID}"]) {
                sha = sh(
                    script: '''
                        set -e
                        BODY=$(printf 'header = "Authorization: Bearer %s"' "${GH_TOKEN}" | curl --config - --silent --show-error --fail \
                            -H "Accept: application/vnd.github+json" \
                            "https://api.github.com/repos/oceanmodeling/nos-workflow/pulls/${GH_CHANGE_ID}")
                        printf '%s' "${BODY}" | python3 -c 'import json,sys; print(json.load(sys.stdin)["head"]["sha"])'
                    ''',
                    returnStdout: true
                ).trim()
            }
        }
        return sha
    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
        throw fie
    } catch (apiErr) {
        echo "resolveTargetSha: warning - GitHub API PR lookup also failed (${apiErr}), no target SHA available"
        return ''
    }
}

// Systems that run only from a user-started Build with Parameters or a scheduled build with parameters, never from the PR label. MJ (10/22/26)
def isManualOfs(String ofs) {
    return ofs in ['stofs_2d_glo', 'stofs_3d_atl_ufs_standalone', 'stofs_3d_atl_ufs']
}

// A blank PDY, or PDY=latest, is the latest day whose CYC cycle is published (about CYC + 8 h after 00Z of that day), for builds scheduled from the dashboard. MJ (10/22/26)
def resolvePdy(String pdy, String cyc) {
    if (pdy?.trim() && pdy.trim() != 'latest') {
        return pdy.trim()
    }
    return sh(script: "date -u -d \"-\$((10#${cyc} + 8)) hours\" +%Y%m%d", returnStdout: true).trim()
}

def isAtlOfs(String ofs) {
    return ofs in ['stofs_3d_atl_ufs_standalone', 'stofs_3d_atl_ufs']
}

// Manual STOFS builds report in the Jenkins build only; the hercules-ci/cycle status belongs to the SECOFS cycle. MJ (10/14/26)
def cycleLabel() {
    if (env.CI_OFS == 'stofs_2d_glo') {
        return "STOFS-2D-Global ${env.LEVEL} ${env.DATA_MODE} cycle"
    }
    if (isAtlOfs(env.CI_OFS)) {
        return "STOFS-3D-ATL (${env.CI_OFS}) ${env.LEVEL} ${env.DATA_MODE} cycle"
    }
    return 'cycle'
}

def postStatus(String state, String description) {
    if (isManualOfs(env.CI_OFS)) {
        echo "postStatus: skipped for ${env.CI_OFS} (manual build)"
        return
    }
    try {
        def targetSha = resolveTargetSha()
        if (!targetSha?.trim()) {
            echo "postStatus: warning - no target SHA resolved, skipping GitHub status post"
            return
        }
        withCredentials([string(credentialsId: 'github-status-token', variable: 'GH_TOKEN')]) {
            withEnv(["GH_STATE=${state}", "GH_DESC=${description}", "GH_COMMIT=${targetSha}", "GH_BUILD_URL=${env.BUILD_URL ?: ''}"]) {
                sh '''
                    payload=$(python3 -c 'import json,os; print(json.dumps({"state":os.environ["GH_STATE"],"context":"hercules-ci/cycle","description":os.environ["GH_DESC"][:140],"target_url":os.environ["GH_BUILD_URL"]}))')
                    printf 'header = "Authorization: Bearer %s"' "${GH_TOKEN}" | curl --config - --silent --show-error --fail \
                        -X POST \
                        -H "Accept: application/vnd.github+json" \
                        "https://api.github.com/repos/oceanmodeling/nos-workflow/statuses/${GH_COMMIT}" \
                        --data "${payload}" >/dev/null
                '''
            }
        }
    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
        throw fie
    } catch (err) {
        echo "postStatus: warning - failed to post GitHub commit status '${state}' (${err})"
    }
}

pipeline {
    // Hardcoded to this node's label; re-parameterize (NODE_LABEL param) if EPIC's label differs.
    agent { label 'hercules-nos' }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 16, unit: 'HOURS')
    }

    parameters {
        string(name: 'NOS_CI_ROOT', defaultValue: '/work2/noaa/nosofs/role-nosofs/nos-ci', description: 'CI-owned root; PACKAGEROOT/VENV_PATH/RT_DATA_ROOT/NOS_PTMP all derive from it, so the agent never needs write access outside its own workspace')
        string(name: 'SEED_SRC', defaultValue: '/work2/noaa/nos-surge/mjisan/nos-workflow', description: 'Source tree the Bootstrap stage copies fix/ and exec/ from the first time a build uses a new NOS_CI_ROOT (must be world-readable)')
        string(name: 'SEED_RT', defaultValue: '/work2/noaa/nos-surge/mjisan/nos-workflow-rt', description: 'Source of frozen regression-test datasets the Bootstrap stage copies from (DATA_MODE=frozen only; must be world-readable)')
        choice(name: 'DATA_MODE', choices: ['live', 'frozen'], description: 'live: stage inputs from NODD for PDY/CYC. frozen: use a pre-staged dataset')
        string(name: 'SLURM_ACCOUNT', defaultValue: 'nosofs', description: 'Slurm account CI charges (CLI override of the cards\' nos-surge; must be valid for the agent account)')
        string(name: 'SLURM_QOS', defaultValue: 'batch', description: 'Slurm qos for CI submissions')
        string(name: 'PDY', defaultValue: '20260827', description: 'Cycle date YYYYMMDD. Blank or latest: the latest day whose CYC cycle is published (UTC now minus CYC+8 h), for scheduled builds')
        string(name: 'CYC', defaultValue: '06', description: 'Cycle hour: 00, 06, 12, or 18')
        choice(name: 'OFS', choices: ['secofs_ufs', 'stofs_2d_glo', 'stofs_3d_atl_ufs_standalone', 'stofs_3d_atl_ufs'], description: 'System to run. Only Build with Parameters or a scheduled build with parameters can select stofs_2d_glo, stofs_3d_atl_ufs_standalone (pschism) or stofs_3d_atl_ufs (UFS coupled), never the PR label; Build Now runs the SECOFS defaults. A new parameter appears in the form only after the first build of this Jenkinsfile.')
        string(name: 'DCOM_BUNDLE', defaultValue: '', description: 'stofs_3d_atl_* with DATA_MODE=live only: case bundle dir holding dcom/ and seeds/dyn_seed_<PDY-1>/ (run guide section 4.2); must be readable by the CI account. Not needed for frozen')
        choice(name: 'LEVEL', choices: ['smoke', 'cycle', 'full'], description: 'stofs_2d_glo and stofs_3d_atl_*, which run the Prep, Nowcast, Forecast and Post stages. smoke: Prep, Nowcast, Verify. cycle and full: Prep, Nowcast, Forecast, Post, Verify. 2D-GLO smoke and cycle continue from the previous cycle (COLD=0); 2D-GLO full is the COLD=1 cold start, which adds adcprep to Prep and the spin-up to Nowcast. The ops comparison runs at cycle and full for 2D-GLO (report only) and at full for ATL (pass/fail, median limit 5 mm standalone and 15 mm coupled). 2D-GLO frozen datasets: 20261012 06 for smoke/cycle, 20261012 00 for full. ATL needs a seeded frozen dataset (stofs_3d_atl.sh seed); CYC is forced to 12. Use DATA_MODE=frozen')
    }

    environment {
        PACKAGEROOT  = "${params.NOS_CI_ROOT}"
        VENV_PATH    = "${params.NOS_CI_ROOT}/nos-venv"
        RT_DATA_ROOT = "${params.NOS_CI_ROOT}/nos-workflow-rt"
        NOS_PTMP     = "${params.NOS_CI_ROOT}/ptmp"
        SEED_SRC     = "${params.SEED_SRC}"
        SEED_RT      = "${params.SEED_RT}"
        SLURM_CI_ACCOUNT = "${params.SLURM_ACCOUNT}"
        SLURM_CI_QOS     = "${params.SLURM_QOS}"
        DATA_MODE    = "${params.DATA_MODE}"
        PDY          = "${resolvePdy(params.PDY, params.OFS?.startsWith('stofs_3d_atl') ? '12' : params.CYC)}"
        // STOFS-3D-ATL has only the 12z cycle, whatever the form says. MJ (10/14/26)
        CYC          = "${params.OFS?.startsWith('stofs_3d_atl') ? '12' : params.CYC}"
        CI_OFS       = "${params.OFS ?: 'secofs_ufs'}"
        LEVEL        = "${params.LEVEL ?: 'smoke'}"
        DCOM_BUNDLE  = "${params.DCOM_BUNDLE ?: ''}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Gate') {
            steps {
                script {
                    def gateLookupFailed = false
                    if (!env.CHANGE_ID?.trim()) {
                        env.RUN_CYCLE = 'true'
                        echo "Gate: not a PR build (CHANGE_ID unset) - cycle will run"
                    } else {
                        def hasLabel = false
                        def labelSource = 'pullRequest.labels'
                        try {
                            hasLabel = pullRequest.labels.contains('hercules-nos-RT')
                        } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
                            throw fie
                        } catch (err) {
                            echo "Gate: pullRequest.labels unavailable (${err}), falling back to GitHub API"
                            labelSource = 'GitHub API'
                            try {
                                withCredentials([string(credentialsId: 'github-status-token', variable: 'GH_TOKEN')]) {
                                    withEnv(["GH_CHANGE_ID=${env.CHANGE_ID}"]) {
                                        def labelsJson = sh(
                                            script: '''
                                                printf 'header = "Authorization: Bearer %s"' "${GH_TOKEN}" | curl --config - --silent --show-error --fail \
                                                    -H "Accept: application/vnd.github+json" \
                                                    "https://api.github.com/repos/oceanmodeling/nos-workflow/issues/${GH_CHANGE_ID}/labels"
                                            ''',
                                            returnStdout: true
                                        ).trim()
                                        hasLabel = labelsJson.contains('"name":"hercules-nos-RT"') || labelsJson.contains('"name": "hercules-nos-RT"')
                                    }
                                }
                            } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
                                throw fie
                            } catch (apiErr) {
                                echo "Gate: warning - GitHub API label lookup also failed (${apiErr}), defaulting to no run"
                                hasLabel = false
                                labelSource = 'none (both lookups failed)'
                                gateLookupFailed = true
                            }
                        }
                        env.RUN_CYCLE = hasLabel ? 'true' : 'false'
                        echo "Gate: PR #${env.CHANGE_ID} label check via ${labelSource}: hercules-nos-RT ${hasLabel ? 'PRESENT' : 'ABSENT'} -> RUN_CYCLE=${env.RUN_CYCLE}"
                    }
                    if (isAtlOfs(params.OFS) && params.CYC != '12') {
                        echo "STOFS-3D-ATL runs 12z only: CYC ${params.CYC} -> 12"
                    }
                    // STOFS-2D-Global and STOFS-3D-ATL are manual only (a scheduled build is let through above, as any non-PR build): a user who starts a build with one of them as OFS bypasses the PR-label check (left as is above); automatic builds keep OFS=secofs_ufs. MJ (10/22/26)
                    if (env.RUN_CYCLE != 'true' && isManualOfs(params.OFS) && currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause')) {
                        env.RUN_CYCLE = 'true'
                        echo "Gate: manual ${params.OFS} build (LEVEL=${params.LEVEL}) - cycle will run, PR label not required"
                    }
                    if (env.RUN_CYCLE == 'true') {
                        // mkdir (no -p) is atomic, so it doubles as a mutex against concurrent cycles sharing NOS_CI_ROOT.
                        def lockResult
                        withEnv(["CI_LOCK_ROOT=${params.NOS_CI_ROOT}"]) {
                            lockResult = sh(
                                script: '''
                                    mkdir -p "${CI_LOCK_ROOT}"
                                    LOCK_DIR="${CI_LOCK_ROOT}/.ci-lock"
                                    NOW=$(date +%s)
                                    try_acquire() {
                                        if mkdir "${LOCK_DIR}" 2>/dev/null; then
                                            printf '%s %s' "${BUILD_URL}" "${NOW}" > "${LOCK_DIR}/info"
                                            return 0
                                        fi
                                        return 1
                                    }
                                    # disableConcurrentBuilds: any job recorded by another build of this job is an orphan (scancel of a finished job is a no-op); stdout carries only ACQUIRED or HELD. MJ (10/16/26)
                                    acquired() {
                                        JIDFILE="${WORKSPACE}/ci_logs/current_jobid"
                                        if [ -s "${JIDFILE}" ]; then
                                            read -r JBUILD JID < "${JIDFILE}" || true
                                            # numeric build numbers only: a "manual <id>" entry is a hand run of run_stage.sh that may still be running. MJ (10/16/26)
                                            case "${JBUILD:-}" in ''|*[!0-9]*) JBUILD="" ;; esac
                                            if [ -n "${JBUILD}" ] && [ -n "${BUILD_NUMBER:-}" ] && [ "${JBUILD}" != "${BUILD_NUMBER}" ]; then
                                                case "${JID:-}" in
                                                    ''|*[!0-9]*) echo "Gate: ignoring a non-numeric jobid in current_jobid" >&2 ;;
                                                    *)
                                                        echo "cancelling job ${JID} left by build ${JBUILD}" >&2
                                                        bash -l -c "scancel ${JID}" >&2 || true
                                                        ;;
                                                esac
                                            fi
                                        fi
                                        echo "ACQUIRED"
                                        exit 0
                                    }
                                    if try_acquire; then
                                        acquired
                                    fi
                                    INFO=$(cat "${LOCK_DIR}/info" 2>/dev/null || true)
                                    LOCK_EPOCH=$(printf '%s' "${INFO}" | awk '{print $NF}')
                                    case "${LOCK_EPOCH}" in
                                        ''|*[!0-9]*) LOCK_EPOCH=$(stat -c %Y "${LOCK_DIR}" 2>/dev/null || echo 0) ;;
                                    esac
                                    AGE=$((NOW - LOCK_EPOCH))
                                    # This job runs with disableConcurrentBuilds, so a holder URL under JOB_URL is an earlier build that ended without releasing. MJ (10/16/26)
                                    HOLDER=$(printf '%s' "${INFO}" | awk '{print $1}')
                                    SAME_JOB=0
                                    if [ -n "${JOB_URL:-}" ] && [ -n "${HOLDER}" ] && [ "${HOLDER}" != "${BUILD_URL}" ]; then
                                        case "${HOLDER}" in "${JOB_URL}"*) SAME_JOB=1 ;; esac
                                    fi
                                    if [ "${SAME_JOB}" -eq 1 ] || [ "${AGE}" -gt 64800 ]; then
                                        if [ "${SAME_JOB}" -eq 1 ]; then
                                            echo "reclaiming the CI lock left by an earlier build of this job: ${INFO}" >&2
                                        else
                                            echo "reclaiming stale CI lock (age ${AGE}s): ${INFO}" >&2
                                        fi
                                        rm -rf "${LOCK_DIR}"
                                        if try_acquire; then
                                            acquired
                                        fi
                                        echo "HELD:$(cat "${LOCK_DIR}/info" 2>/dev/null)"
                                        exit 0
                                    fi
                                    echo "HELD:${INFO}"
                                    exit 0
                                ''',
                                returnStdout: true
                            ).trim()
                        }
                        if (lockResult == 'ACQUIRED') {
                            env.CI_LOCK_HELD = 'true'
                            echo "Gate: acquired CI lock at ${params.NOS_CI_ROOT}/.ci-lock"
                        } else {
                            error("another CI cycle holds the lock: ${lockResult.replaceFirst('^HELD:', '')}")
                        }
                        postStatus('pending', "SECOFS cycle running: ${env.PDY}/${env.CYC} ${env.DATA_MODE}")
                    } else if (gateLookupFailed) {
                        postStatus('error', 'hercules-ci gate could not read PR labels')
                    }
                }
            }
        }
        stage('Bootstrap') {
            when { environment name: 'RUN_CYCLE', value: 'true' }
            steps {
                sh 'bash -l "${WORKSPACE}/.cicd/scripts/bootstrap.sh"'
            }
        }
        stage('Deploy') {
            when { environment name: 'RUN_CYCLE', value: 'true' }
            steps {
                sh 'bash -l "${WORKSPACE}/.cicd/scripts/deploy.sh"'
            }
        }
        stage('Environment Check') {
            when { environment name: 'RUN_CYCLE', value: 'true' }
            steps {
                sh 'bash -l "${WORKSPACE}/.cicd/scripts/env_check.sh"'
            }
        }
        stage('Stage Data') {
            when { environment name: 'RUN_CYCLE', value: 'true' }
            steps {
                sh 'bash -l "${WORKSPACE}/.cicd/scripts/stage_data.sh"'
            }
        }
        // Prep..Verify run for SECOFS, STOFS-3D-ATL and STOFS-2D-Global (the manual systems stop after Nowcast at LEVEL=smoke). MJ (10/15/26)
        stage('Prep') {
            when { expression { env.RUN_CYCLE == 'true' && (env.CI_OFS == 'secofs_ufs' || isAtlOfs(env.CI_OFS) || env.CI_OFS == 'stofs_2d_glo') } }
            steps {
                sh 'bash -l "${WORKSPACE}/.cicd/scripts/run_stage.sh" prep "${PDY}" "${CYC}"'
            }
        }
        stage('Nowcast') {
            when { expression { env.RUN_CYCLE == 'true' && (env.CI_OFS == 'secofs_ufs' || isAtlOfs(env.CI_OFS) || env.CI_OFS == 'stofs_2d_glo') } }
            steps {
                sh 'bash -l "${WORKSPACE}/.cicd/scripts/run_stage.sh" nowcast "${PDY}" "${CYC}"'
            }
        }
        stage('Forecast') {
            when { expression { env.RUN_CYCLE == 'true' && (env.CI_OFS == 'secofs_ufs' || ((isAtlOfs(env.CI_OFS) || env.CI_OFS == 'stofs_2d_glo') && env.LEVEL != 'smoke')) } }
            steps {
                sh 'bash -l "${WORKSPACE}/.cicd/scripts/run_stage.sh" forecast "${PDY}" "${CYC}"'
            }
        }
        stage('Post') {
            when { expression { env.RUN_CYCLE == 'true' && (env.CI_OFS == 'secofs_ufs' || ((isAtlOfs(env.CI_OFS) || env.CI_OFS == 'stofs_2d_glo') && env.LEVEL != 'smoke')) } }
            steps {
                sh 'bash -l "${WORKSPACE}/.cicd/scripts/run_stage.sh" post "${PDY}" "${CYC}"'
            }
        }
        stage('Verify') {
            when { expression { env.RUN_CYCLE == 'true' && (env.CI_OFS == 'secofs_ufs' || isAtlOfs(env.CI_OFS) || env.CI_OFS == 'stofs_2d_glo') } }
            steps {
                script {
                    if (isAtlOfs(env.CI_OFS)) {
                        sh 'bash -l "${WORKSPACE}/.cicd/scripts/stofs_3d_atl.sh" verify'
                    } else if (env.CI_OFS == 'stofs_2d_glo') {
                        sh 'bash -l "${WORKSPACE}/.cicd/scripts/stofs_2d_glo.sh" verify'
                    } else {
                        sh 'bash -l "${WORKSPACE}/.cicd/scripts/verify.sh"'
                    }
                }
            }
        }
    }

    post {
        always {
            // release the lock first: archiving takes seconds and a second abort landing there left the lock behind. MJ (10/16/26)
            script {
                if (env.CI_LOCK_HELD == 'true') {
                    try {
                        withEnv(["CI_LOCK_ROOT=${params.NOS_CI_ROOT}"]) {
                            sh '''
                                rm -rf "${CI_LOCK_ROOT}/.ci-lock" || true
                            '''
                        }
                    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
                        throw fie
                    } catch (err) {
                        echo "post/always: warning - failed to release CI lock at ${params.NOS_CI_ROOT}/.ci-lock (${err})"
                    }
                }
            }
            archiveArtifacts artifacts: 'ci_logs/**', allowEmptyArchive: true
            script {
                if (env.CHANGE_ID?.trim() && env.RUN_CYCLE == 'true' && !isManualOfs(env.CI_OFS)) {
                    try {
                        withCredentials([string(credentialsId: 'github-status-token', variable: 'GH_TOKEN')]) {
                            withEnv(["GH_CHANGE_ID=${env.CHANGE_ID}"]) {
                                sh '''
                                    printf 'header = "Authorization: Bearer %s"' "${GH_TOKEN}" | curl --config - --silent --show-error --fail \
                                        -X DELETE \
                                        -H "Accept: application/vnd.github+json" \
                                        "https://api.github.com/repos/oceanmodeling/nos-workflow/issues/${GH_CHANGE_ID}/labels/hercules-nos-RT" >/dev/null
                                '''
                            }
                        }
                    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
                        throw fie
                    } catch (err) {
                        echo "post/always: warning - failed to remove hercules-nos-RT label from PR #${env.CHANGE_ID} (${err})"
                    }
                }
            }
        }
        unsuccessful {
            // run_stage.sh writes "<BUILD_NUMBER> <JOBID>" here (SECOFS, ATL and 2D-GLO); best-effort scancel it on failure, only when this build submitted it. MJ (10/16/26)
            sh '''
                JIDFILE="${WORKSPACE}/ci_logs/current_jobid"
                if [ -s "${JIDFILE}" ]; then
                    read -r JBUILD JID < "${JIDFILE}" || true
                    case "${JID:-}" in ''|*[!0-9]*) JID="" ;; esac
                    if [ -n "${JID}" ] && [ "${JBUILD}" = "${BUILD_NUMBER}" ]; then
                        echo "post/unsuccessful: scancel ${JID} (best-effort)"
                        bash -l -c "scancel ${JID}" || true
                    else
                        echo "post/unsuccessful: skipping stale jobid ($(cat "${JIDFILE}")) not submitted by build ${BUILD_NUMBER}"
                    fi
                fi
            '''
            script {
                if (env.RUN_CYCLE == 'true') {
                    postStatus('failure', "cycle ${env.PDY}/${env.CYC} FAILED — see build log")
                }
            }
        }
        success {
            script {
                if (env.RUN_CYCLE == 'true') {
                    postStatus('success', "cycle ${env.PDY}/${env.CYC} PASS")
                }
            }
            slackSend(channel: '#nos-notifications', color: 'good',
                message: "*SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}* ${cycleLabel()} ${env.PDY}/${env.CYC}z <${env.BUILD_URL}|Open Build>")
        }
        failure {
            slackSend(channel: '#nos-notifications', color: 'danger',
                message: "*FAILURE: ${env.JOB_NAME} #${env.BUILD_NUMBER}* ${cycleLabel()} ${env.PDY}/${env.CYC}z <${env.BUILD_URL}|Open Build>")
        }
        aborted {
            slackSend(channel: '#nos-notifications', color: 'warning',
                message: "*ABORTED: ${env.JOB_NAME} #${env.BUILD_NUMBER}* <${env.BUILD_URL}|Open Build>")
        }
    }
}
