# ============================================================================
# Dockerfile.ufs_coastal - Build UFS-Coastal (fv3_coastalS.exe) with SCHISM
#
# Uses NOAA EPIC pre-built spack-stack image (ESMF 8.8.0, HDF5, NetCDF, etc.)
#
# Build (~20-30 min):
#   docker build -f docker/Dockerfile.ufs_coastal -t nosofs/ufs-coastal:latest docker/
# ============================================================================

FROM noaaepic/rocky9-gcc13.3.1-spack-stack:v1.9.2-ufs-wm-srw AS ufs-build

RUN dnf install -y git git-lfs && dnf clean all

ENV SI=/opt/spack-stack/spack-stack-1.9.2/envs/ufs-wm-env/install/gcc/13.3.1

# Build PATH with all spack bin/ dirs + MPI
# This ensures nc-config, nf-config, esmf_info etc. are found
RUN BINDIRS=$(find ${SI} -maxdepth 2 -name bin -type d | tr '\n' ':') && \
    LIBDIRS=$(find ${SI} -maxdepth 2 -name lib -type d | tr '\n' ':') && \
    PREFIXES=$(ls -d ${SI}/*/ | tr '\n' ';') && \
    echo "export PATH=/opt/openmpi/4.1.6/bin:${BINDIRS}\$PATH" > /opt/spack_env.sh && \
    echo "export LD_LIBRARY_PATH=/opt/openmpi/4.1.6/lib:${LIBDIRS}\$LD_LIBRARY_PATH" >> /opt/spack_env.sh && \
    echo "export CMAKE_PREFIX_PATH=\"${PREFIXES}\"" >> /opt/spack_env.sh

# Clone UFS-Coastal
RUN cd /opt && \
    git clone -b feature/coastal_app --recursive \
        https://github.com/oceanmodeling/ufs-weather-model.git

# Verify env is correct
SHELL ["/bin/bash", "-c"]
RUN source /opt/spack_env.sh && \
    which nc-config && nc-config --version && \
    which mpifort && mpifort --version | head -1 && \
    which cmake && cmake --version | head -1

# CMake configure — pass CMAKE_PREFIX_PATH on command line (not via env)
RUN source /opt/spack_env.sh && \
    PREFIXES=$(ls -d ${SI}/*/ | tr '\n' ';') && \
    cd /opt/ufs-weather-model && \
    rm -rf build && mkdir build && cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=RELEASE \
        -DAPP=CSTLS \
        -DUSE_ATMOS=ON \
        -DNO_PARMETIS=OFF \
        -DOLDIO=ON \
        -DCMAKE_Fortran_FLAGS="-fallow-argument-mismatch" \
        -DCMAKE_C_COMPILER=mpicc \
        -DCMAKE_CXX_COMPILER=mpicxx \
        -DCMAKE_Fortran_COMPILER=mpifort \
        -DCMAKE_PREFIX_PATH="${PREFIXES}"

# Compile
RUN source /opt/spack_env.sh && \
    cd /opt/ufs-weather-model/build && \
    make -j$(nproc) && \
    mkdir -p /opt/ufs/bin && \
    cp ufs_model /opt/ufs/bin/ufs_model && \
    ln -sf ufs_model /opt/ufs/bin/fv3_coastalS.exe

CMD ["echo", "UFS-Coastal: /opt/ufs/bin/fv3_coastalS.exe"]
