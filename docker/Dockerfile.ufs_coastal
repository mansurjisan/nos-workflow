# ============================================================================
# Dockerfile.ufs_coastal - Build UFS-Coastal (fv3_coastalS.exe) with SCHISM
#
# Multi-stage build:
#   Stage 1 (spack-deps):  spack-stack with ESMF 8.8.0, ParMETIS, etc.
#   Stage 2 (ufs-build):   Compile UFS-Coastal (DATM+SCHISM via NUOPC/CMEPS)
#   Stage 3 (export):      Extract just the executable + runtime libs
#
# This Dockerfile produces ONLY fv3_coastalS.exe. Combine with
# Dockerfile.secofs_ufs for the full SECOFS testing container.
#
# Build (~2-3 hours first time, cached after):
#   docker build -f docker/Dockerfile.ufs_coastal -t nosofs/ufs-coastal:latest .
#
# Extract the executable:
#   docker run --rm nosofs/ufs-coastal:latest cat /opt/ufs/bin/ufs_model > fv3_coastalS.exe
# ============================================================================

# ===========================================================================
# Stage 1: Build spack-stack with UFS-Coastal dependencies
# ===========================================================================
FROM ubuntu:22.04 AS spack-deps

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get -yqq update && apt-get -yqq upgrade && \
    apt-get install --no-install-recommends -yqq \
        gcc g++ gfortran build-essential libkrb5-dev m4 \
        git git-lfs vim bzip2 unzip tar automake xterm \
        libcurl4-openssl-dev libssl-dev meson \
        python3-dev python3-pip wget rsync tcl tcl-dev openssh-client \
        openmpi-bin libopenmpi-dev \
        file patchelf coreutils lsb-release \
        libxml2-dev libsqlite3-dev pkg-config && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Clone spack-stack (use 1.9.3 or develop for ESMF 8.8.0 support)
RUN cd /opt && \
    git clone --recurse-submodules -b develop https://github.com/JCSDA/spack-stack.git && \
    cd spack-stack && \
    git submodule update --init --recursive

# Set up spack environment
ENV SPACK_ROOT=/opt/spack-stack/spack
SHELL ["/bin/bash", "-c"]

RUN cd /opt/spack-stack && \
    source setup.sh && \
    # Create environment for UFS-Coastal
    spack stack create env --site linux.default \
        --template ufs-weather-model \
        --name ufs-coastal \
        --prefix /opt/spack-env && \
    cd envs/ufs-coastal && \
    spack env activate . && \
    # Find system packages
    export SPACK_SYSTEM_CONFIG_PATH="/opt/spack-stack/envs/ufs-coastal/site" && \
    spack external find --scope system \
        --exclude bison --exclude cmake --exclude curl \
        --exclude openssl --exclude openssh && \
    spack external find --scope system perl wget && \
    spack compiler find --scope system && \
    unset SPACK_SYSTEM_CONFIG_PATH && \
    # Set compiler and MPI
    gcc_ver=$(gcc -dumpversion) && \
    spack config add "packages:all:compiler:[gcc@${gcc_ver}]" && \
    spack config add "packages:all:providers:mpi:[openmpi]" && \
    # Add UFS-Coastal extra dependencies
    spack add parmetis@4.0.3~shared ^metis~shared && \
    spack add esmf@8.8.0 +external-parallelio ~xerces ~pnetcdf && \
    # PIC variants needed for shared lib linking
    spack config add "packages:fontconfig:variants:+pic" && \
    spack config add "packages:pixman:variants:+pic" && \
    spack config add "packages:cairo:variants:+pic" && \
    # Concretize and install
    spack concretize 2>&1 | tee /opt/log.concretize && \
    spack install --source 2>&1 | tee /opt/log.install && \
    spack gc -y

# ===========================================================================
# Stage 2: Build UFS-Coastal with SCHISM
# ===========================================================================
FROM spack-deps AS ufs-build

# Clone UFS-Coastal (feature/coastal_app branch with SCHISM support)
RUN cd /opt && \
    git clone -b feature/coastal_app --recursive \
        https://github.com/oceanmodeling/ufs-weather-model.git

# Build UFS-Coastal
RUN cd /opt/spack-stack && source setup.sh && \
    cd envs/ufs-coastal && spack env activate . && \
    cd /opt/ufs-weather-model && \
    mkdir build && cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=RELEASE \
        -DAPP=CSTLS \
        -DUSE_ATMOS=ON \
        -DNO_PARMETIS=OFF \
        -DOLDIO=ON \
        -DBUILD_TOOLS=ON \
        -DCMAKE_Fortran_FLAGS="-fallow-argument-mismatch" && \
    make -j$(nproc) && \
    mkdir -p /opt/ufs/bin && \
    cp ufs_model /opt/ufs/bin/ufs_model && \
    ln -sf ufs_model /opt/ufs/bin/fv3_coastalS.exe

# ===========================================================================
# Stage 3: Export executable + runtime libraries
# ===========================================================================
FROM ubuntu:22.04 AS export

RUN apt-get -yqq update && \
    apt-get install --no-install-recommends -yqq \
        libgfortran5 libgomp1 openmpi-bin libopenmpi3 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy executable
COPY --from=ufs-build /opt/ufs/bin/ /opt/ufs/bin/

# Copy spack-stack runtime libraries (ESMF, NetCDF, HDF5, etc.)
# These are needed at runtime by fv3_coastalS.exe
COPY --from=ufs-build /opt/spack-env/ /opt/spack-env/

ENV PATH="/opt/ufs/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/spack-env/lib:/opt/spack-env/lib64:${LD_LIBRARY_PATH:-}"

CMD ["echo", "UFS-Coastal executable at /opt/ufs/bin/fv3_coastalS.exe"]
